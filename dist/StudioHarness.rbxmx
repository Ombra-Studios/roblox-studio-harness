    <Item class="Script" referent="RBX1">
      <Properties>
        <string name="Name">StudioHarness</string>
        <bool name="Disabled">false</bool>
        <ProtectedString name="Source">-- Studio Harness Loader 1.1.0. Pornește aplicația din `Modules` și o înlocuiește fără repornirea Studio-ului când daemon-ul livrează un bundle nou (faza 5).
-- 1.0: codul local vine din StringValue-ul `LocalToken` (copil al acestui script, completat la instalare), este salvat în setări și ajunge la aplicație
-- prin handoff-ul de pornire; fără el rămâne câmpul manual din „Avansat”. Logica de decizie este pură și testată în tests/Loader.spec.luau;
-- în afara Studio scriptul întoarce doar tabelul Loader.
local Loader = { VERSION = "1.1.0", BASE = "http://127.0.0.1:34871", TOKEN_SETTING = "StudioHarnessBridgeToken", CHECK_INTERVAL = 5,
	MAX_MODULES = 64, MAX_SOURCE = 2 * 1024 * 1024, TOKEN_VALUE = "LocalToken", TOKEN_PLACEHOLDER = "STUDIO_HARNESS_LOCAL_TOKEN_PLACEHOLDER" }

local function validRevision(revision)
	return type(revision) == "string" and revision ~= "" and #revision &lt;= 64 and string.find(revision, "^[%w%.%-_]+$") ~= nil
end

-- Un cod local acceptabil: 8–512 caractere, fără spații, caractere de control sau `\`, diferit de placeholder-ul din pachet.
function Loader.validToken(token)
	return type(token) == "string" and #token &gt;= 8 and #token &lt;= 512 and string.find(token, "[%c%s\\]") == nil and token ~= Loader.TOKEN_PLACEHOLDER
end

-- Codul livrat la instalare: StringValue-ul `LocalToken` de sub scriptul loader; lipsă, altă clasă, placeholder sau valoare invalidă → nil.
function Loader.localToken(container)
	local ok, value = pcall(function()
		local child = container:FindFirstChild(Loader.TOKEN_VALUE)
		if child == nil or child.ClassName ~= "StringValue" then return nil end
		return child.Value
	end)
	return if ok and Loader.validToken(value) then value else nil
end

-- Codul cu care pornește aplicația și sursa lui: cel livrat de instalare are prioritate față de setarea salvată anterior (fallback 1.0.0/manual).
function Loader.resolveToken(delivered, saved)
	if Loader.validToken(delivered) then return delivered, "loader" end
	if Loader.validToken(saved) then return saved, "settings" end
	return "", nil
end

-- Decide dacă `/v1/status.plugin_bundle.revision` cere o metamorfoză; `skipRevision` este ultimul bundle care nu a pornit.
function Loader.shouldSwap(currentRevision, status, skipRevision)
	local bundle = if type(status) == "table" then status.plugin_bundle else nil
	local revision = if type(bundle) == "table" then bundle.revision else nil
	if not validRevision(revision) or revision == currentRevision or revision == skipRevision then return false, nil end
	return true, revision
end

-- Validează răspunsul `/v1/plugin/bundle`: revizie, module cu nume sigure și surse text, intrarea prezentă. Întoarce ok și numele intrării sau motivul.
function Loader.validateBundle(bundle)
	if type(bundle) ~= "table" then return false, "răspuns lipsă" end
	if not validRevision(bundle.revision) then return false, "revizie invalidă" end
	if type(bundle.modules) ~= "table" then return false, "modulele lipsesc" end
	local entry = if bundle.entry == nil then "Main" else bundle.entry
	if type(entry) ~= "string" or not string.find(entry, "^[%a_][%w_]*$") then return false, "intrare invalidă" end
	local count = 0
	for name, source in pairs(bundle.modules) do
		count += 1
		if count &gt; Loader.MAX_MODULES then return false, "prea multe module" end
		if type(name) ~= "string" or #name &gt; 64 or not string.find(name, "^[%a_][%w_]*$") then return false, "nume de modul invalid" end
		if type(source) ~= "string" or #source &gt; Loader.MAX_SOURCE or not string.find(source, "%S") then return false, "sursă invalidă pentru " .. name end
	end
	if type(bundle.modules[entry]) ~= "string" then return false, "intrarea " .. entry .. " lipsește" end
	return true, entry
end

function Loader.normalize(source)
	return (string.gsub(tostring(source), "\r\n?", "\n"))
end

-- Bundle-ul încorporat nu are revizie; dacă sursele coincid cu cele servite, revizia se adoptă fără metamorfoză.
function Loader.sameSources(bundle, folder)
	local ok, same = pcall(function()
		local count = 0
		for _, child in ipairs(folder:GetChildren()) do
			if child.ClassName == "ModuleScript" then
				count += 1
				local source = bundle.modules[child.Name]
				if type(source) ~= "string" or Loader.normalize(child.Source) ~= Loader.normalize(source) then return false end
			end
		end
		local expected = 0
		for _ in pairs(bundle.modules) do expected += 1 end
		return count == expected
	end)
	return ok and same == true
end

-- Folderul „App-&lt;revizie&gt;” cu câte un ModuleScript per modul (Source = sursă); `create` înlocuiește Instance.new în teste.
function Loader.buildFolder(bundle, parent, create)
	create = create or function(className) return Instance.new(className) end
	local folder = create("Folder")
	folder.Name = "App-" .. tostring(bundle.revision)
	local names = {}
	for name in pairs(bundle.modules) do table.insert(names, name) end
	table.sort(names)
	for _, name in ipairs(names) do
		local module = create("ModuleScript")
		module.Name = name
		module.Source = bundle.modules[name]
		module.Parent = folder
	end
	folder.Parent = parent
	return folder
end

-- Handoff-ul cu care repornește bundle-ul anterior după o metamorfoză eșuată: istoricul aplicației (când snapshotul a reușit),
-- plus motivul eșecului, ca `Main` să îl mute în store, iar dock-ul să arate bannerul din DESIGN.md §12.2 — nu doar Output-ul.
function Loader.retryHandoff(handoff, revision, failure)
	local retry = if type(handoff) == "table" then table.clone(handoff) else {}
	retry.bundleError = tostring(revision) .. ": " .. tostring(failure)
	return retry
end

if not plugin then return Loader end

local HttpService = game:GetService("HttpService")
local root = script.Parent
local embedded = root:FindFirstChild("Modules")
local toolbar = plugin:CreateToolbar("Studio Harness")
local button = toolbar:CreateButton("StudioHarnessMatrixToggle", "Deschide hubul sesiunilor", "", "Hub")
button.ClickableWhenViewportHidden = true
local apps = Instance.new("Folder")
apps.Name, apps.Parent = "Apps", root
local current = { revision = nil, folder = embedded, app = nil }
local alive, failedRevision = true, nil

local function startApp(folder, handoff)
	local main = if folder then folder:FindFirstChild("Main") else nil
	if not main then error("modulul Main lipsește din " .. (if folder then folder.Name else "bundle")) end
	return require(main).start(plugin, handoff, toolbar, button)
end

-- Întoarce (a pornit?, motivul eșecului): motivul merge în handoff-ul repornirii, ca utilizatorul să îl vadă în bannerul din dock,
-- nu doar în fereastra Output a Studio-ului (DESIGN.md §12.2).
local function boot(folder, handoff, label)
	local ok, app = pcall(startApp, folder, handoff)
	current.app = if ok then app else nil
	if not ok then warn("Studio Harness: " .. label .. " nu a pornit: " .. tostring(app)) end
	return ok, if ok then nil else tostring(app)
end

local function savedToken()
	local ok, token = pcall(function() return plugin:GetSetting(Loader.TOKEN_SETTING) end)
	return if ok and Loader.validToken(token) then token else ""
end

-- Codul livrat la instalare are prioritate și intră în setări (aplicația și verificarea bundle-ului îl citesc de acolo).
local delivered = Loader.localToken(script)
if delivered and delivered ~= savedToken() then
	local saved = pcall(function() plugin:SetSetting(Loader.TOKEN_SETTING, delivered) end)
	if not saved then warn("Studio Harness: codul local livrat nu a putut fi salvat în setări; se folosește doar în această sesiune.") end
end
local startToken, startSource = Loader.resolveToken(delivered, savedToken())

-- Setarea urmează ultimul cod care a mers (aplicația o rescrie după un cod lipit manual); codul livrat rămâne rezerva dacă setarea nu s-a putut scrie.
local function currentToken()
	local saved = savedToken()
	return if saved ~= "" then saved else startToken
end

-- Singurul loc din loader cu HttpService: GET cu codul local, în pcall; orice eșec întoarce nil.
local function get(path, token)
	local ok, response = pcall(function()
		return HttpService:RequestAsync({ Url = Loader.BASE .. path, Method = "GET", Headers = { ["X-Studio-Harness-Token"] = token } })
	end)
	if not ok or type(response) ~= "table" or response.Success ~= true then return nil end
	local decoded, body = pcall(function() return HttpService:JSONDecode(response.Body) end)
	return if decoded and type(body) == "table" and body.ok == true then body else nil
end

-- Metamorfoza: folderul nou se creează înainte de oprirea aplicației; la eșec revine bundle-ul anterior cu același handoff.
local function swap(bundle, revision)
	local built, folder = pcall(Loader.buildFolder, bundle, apps)
	if not built then warn("Studio Harness: bundle-ul " .. revision .. " nu a putut fi creat: " .. tostring(folder)); return false end
	local handoff = nil
	if current.app then
		local ok, snapshot = pcall(function() return current.app:snapshot() end)
		if ok then handoff = snapshot else warn("Studio Harness: snapshotul aplicației a eșuat, pornesc fără istoric: " .. tostring(snapshot)) end
		pcall(function() current.app:destroy() end)
		current.app = nil
	end
	local previous = current.folder
	local started, failure = boot(folder, handoff, "bundle-ul " .. revision)
	if started then
		current.revision, current.folder = revision, folder
		if previous and previous ~= embedded then previous:Destroy() end
		return true
	end
	folder:Destroy()
	boot(previous, Loader.retryHandoff(handoff, revision, failure), "bundle-ul anterior")
	return false
end

local function check()
	local token = currentToken()
	if token == "" then return end
	local swapNeeded, revision = Loader.shouldSwap(current.revision, get("/v1/status", token), failedRevision)
	if not swapNeeded then return end
	local bundle = get("/v1/plugin/bundle", token)
	local valid, message = Loader.validateBundle(bundle)
	if not valid then failedRevision = revision; warn("Studio Harness: bundle-ul " .. revision .. " este invalid: " .. message); return end
	if bundle.revision ~= revision or not alive then return end
	if current.revision == nil and current.app and Loader.sameSources(bundle, current.folder) then current.revision = revision; return end
	if not swap(bundle, revision) then failedRevision = revision end
end

plugin.Unloading:Connect(function()
	alive = false
	if current.app then pcall(function() current.app:destroy() end) end
	current.app = nil
end)
-- Pornirea încorporată primește un handoff fără store: doar codul local și sursa lui, ca aplicația să se conecteze fără intervenția utilizatorului.
boot(embedded, if startToken ~= "" then { controller = { token = startToken, source = startSource } } else nil, "aplicația încorporată")
task.spawn(function()
	while alive do
		task.wait(Loader.CHECK_INTERVAL)
		if not alive then break end
		local ok, failure = pcall(check)
		if not ok then warn("Studio Harness: verificarea bundle-ului a eșuat: " .. tostring(failure)) end
	end
end)
</ProtectedString>
      </Properties>
      <Item class="StringValue" referent="RBX2">
        <Properties>
          <string name="Name">LocalToken</string>
          <string name="Value">STUDIO_HARNESS_LOCAL_TOKEN_PLACEHOLDER</string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="RBX3">
      <Properties>
        <string name="Name">Modules</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX4">
        <Properties>
          <string name="Name">ApprovalView</string>
          <ProtectedString name="Source">-- Studio Harness ApprovalView 1.0.0 — cardul de aprobare al unei sesiuni (design/DESIGN.md §10.8).
-- Regula 0.8 rămâne: „Permite” este activ numai când argumentele au încăput integral în cutia derulabilă.
-- Argumentele se serializează aici, în Luau curat: `HttpService` este permis doar în BridgeController și în loader.
local Theme = require(script.Parent.Theme)
local TextService = game:GetService("TextService")
local ApprovalView = {}
ApprovalView.__index = ApprovalView

local MAX_BYTES, MAX_HEIGHT = 120000, 16000
local CODE_SIZE = Theme.TEXT.sm -- 13: argumentele sunt identificatori, deci mono mic
local GUTTER = Theme.SPACE.xs + 2 -- marginea interioară a cutiei de argumente
local MAX_DEPTH = 32
-- Înălțimea părților fixe ale cardului: padding 2 × 12, titlu 24, detaliu 20, hint 18, butoane 32 și 4 spații de 6.
local FIXED_HEIGHT = 142
local ESCAPES = { ['"'] = '\\"', ["\\"] = "\\\\", ["\b"] = "\\b", ["\f"] = "\\f", ["\n"] = "\\n", ["\r"] = "\\r", ["\t"] = "\\t" }

-- Un șir JSON: ghilimele, backslash și caracterele de control devin secvențe de evadare; restul octeților rămân neatinși.
local function quote(text)
	local escaped = string.gsub(text, '[%c"\\]', function(character)
		local mapped = ESCAPES[character]
		if mapped then return mapped end
		local byte = string.byte(character)
		if byte and (byte &lt; 32 or byte == 127) then return string.format("\\u%04x", byte) end
		return character
	end)
	return '"' .. escaped .. '"'
end

-- Adaugă o bucată la ieșire; peste limita locală de afișare se oprește tot (cardul va oferi numai „Refuză”).
local function push(state, text)
	if state.overflow then return false end
	state.size += #text
	if state.size &gt; MAX_BYTES then
		state.overflow = true
		return false
	end
	table.insert(state.parts, text)
	return true
end

-- Cheile unui obiect, sortate, ca două afișări ale aceluiași apel să arate identic.
local function sortedKeys(value)
	local keys = {}
	for key in pairs(value) do table.insert(keys, key) end
	table.sort(keys, function(a, b) return tostring(a) &lt; tostring(b) end)
	return keys
end

local function encode(state, value, depth)
	if state.overflow then return end
	local kind = type(value)
	if kind == "string" then
		push(state, quote(value))
	elseif kind == "boolean" then
		push(state, tostring(value))
	elseif kind == "number" then
		if value ~= value or value == math.huge or value == -math.huge then push(state, "null")
		elseif value % 1 == 0 and math.abs(value) &lt; 1e15 then push(state, string.format("%d", value))
		else push(state, tostring(value)) end
	elseif kind ~= "table" then
		push(state, "null")
	elseif depth &gt;= MAX_DEPTH then
		push(state, '"…"')
	elseif next(value) == nil then
		push(state, "{}")
	else
		local indent, inner = string.rep("  ", depth), string.rep("  ", depth + 1)
		local count = #value
		if count &gt; 0 then
			push(state, "[\n")
			for index = 1, count do
				push(state, inner)
				encode(state, value[index], depth + 1)
				push(state, if index &lt; count then ",\n" else "\n")
			end
			push(state, indent .. "]")
		else
			local keys = sortedKeys(value)
			push(state, "{\n")
			for index, key in ipairs(keys) do
				push(state, inner .. quote(tostring(key)) .. ": ")
				encode(state, value[key], depth + 1)
				push(state, if index &lt; #keys then ",\n" else "\n")
			end
			push(state, indent .. "}")
		end
	end
end

-- Textul integral al unui apel propus: codul Luau (dacă există), instrumentul și argumentele complete, indentate.
local function formatArguments(approval)
	if type(approval.arguments) ~= "table" then return "Argumentele complete nu pot fi afișate. Refuză apelul.", false end
	local state = { parts = {}, size = 0, overflow = false }
	encode(state, approval.arguments, 0)
	if state.overflow then
		return "Argumentele depășesc limita de afișare. Aprobarea este dezactivată; refuză și cere un apel mai mic.", false
	end
	local text = "Instrument: " .. tostring(approval.tool) .. "\n\nArgumente complete:\n" .. table.concat(state.parts)
	if type(approval.arguments.code) == "string" then text = "Cod Luau:\n" .. approval.arguments.code .. "\n\n" .. text end
	if #text &gt; MAX_BYTES then return "Afișarea integrală depășește limita locală. Numai Refuză este disponibil.", false end
	return text, true
end

function ApprovalView.new(parent, store, windowId, decide)
	local self = setmetatable({ connections = {}, destroyed = false, store = store, windowId = windowId,
		current = nil, canDecide = false, measured = false, windowVisible = false,
		text = "", fullText = false, width = 0, height = 0, reportedId = nil, reported = nil }, ApprovalView)
	local card = Theme.card(parent, { name = "Approval", role = "warning" })
	self.card, self.root = card, card.root
	self.root.AutomaticSize = Enum.AutomaticSize.None
	self.root.Visible = false

	local titleRow = Theme.new("Frame", { Name = "TitleRow", BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 1 }, card.body)
	self.title = Theme.label(titleRow, "Modificarea propusă", { size = "lg", font = "ui", token = "warningText",
		height = 24, truncate = true, name = "Title" })
	self.title.Size = UDim2.new(1, -124, 1, 0)
	self.meta = Theme.label(titleRow, "", { size = "xs", token = "text2", height = 24, truncate = true,
		align = "right", name = "Meta" })
	self.meta.AnchorPoint = Vector2.new(1, 0)
	self.meta.Position = UDim2.new(1, 0, 0, 0)
	self.meta.Size = UDim2.new(0, 120, 1, 0)

	local detailRow = Theme.new("Frame", { Name = "DetailRow", BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 2 }, card.body)
	Theme.list(detailRow, Theme.SPACE.xs, true)
	self.tool = Theme.label(detailRow, "", { size = "md", font = "mono", height = 20, truncate = true, name = "Tool" })
	self.tool.AutomaticSize = Enum.AutomaticSize.X
	self.tool.Size = UDim2.fromOffset(0, 20)
	self.tool.LayoutOrder = 1
	local scope = Theme.label(detailRow, "· doar acest apel", { size = "xs", token = "text2", height = 20, name = "Scope" })
	scope.AutomaticSize = Enum.AutomaticSize.X
	scope.Size = UDim2.fromOffset(0, 20)
	scope.LayoutOrder = 2

	self.scroll = Theme.scroll(card.body, "CompleteArguments")
	self.scroll.LayoutOrder = 3
	self.scroll.Size = UDim2.new(1, 0, 0, 120)
	self.scroll.AutomaticCanvasSize = Enum.AutomaticSize.None
	self.scroll.BackgroundTransparency = 0
	Theme.paint(self.scroll, { BackgroundColor3 = { dark = "bg", light = "raised" } })
	Theme.corner(self.scroll, "control")
	Theme.stroke(self.scroll, "border")
	self.code = Theme.new("TextBox", { Name = "Arguments", Position = UDim2.fromOffset(GUTTER, GUTTER),
		Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", TextEditable = false,
		TextSize = CODE_SIZE, MultiLine = true, TextWrapped = true, ClearTextOnFocus = false, RichText = false,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top }, self.scroll)
	self.code.Font = Theme.font("mono")
	Theme.paint(self.code, { TextColor3 = "text" })

	self.hint = Theme.label(card.body, "", { size = "xs", token = "text2", height = 18, name = "Hint" })
	self.hint.LayoutOrder = 4
	local buttons = Theme.new("Frame", { Name = "Actions", BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 32), LayoutOrder = 5 }, card.body)
	self.approve = Theme.button(buttons, "Permite", { kind = "primary", name = "ApproveCall",
		width = UDim.new(0.6, -Theme.SPACE.xs) })
	self.refuse = Theme.button(buttons, "Refuză", { name = "RefuseCall", width = UDim.new(0.4, -Theme.SPACE.xs) })
	self.refuse.Position = UDim2.new(0.6, Theme.SPACE.xs, 0, 0)

	Theme.click(self, self.approve, function()
		if self.current and self:inspectable(self.current.id) then decide(self.current.id, true) end
	end)
	Theme.click(self, self.refuse, function() if self.current then decide(self.current.id, false) end end)
	Theme.connect(self, self.root:GetPropertyChangedSignal("AbsoluteSize"), function() self:layout() end)
	Theme.connect(self, self.scroll:GetPropertyChangedSignal("AbsoluteWindowSize"), function() self:measure() end)
	Theme.connect(self, self.code:GetPropertyChangedSignal("TextFits"), function() self:refreshButtons() end)
	Theme.connect(self, self.code:GetPropertyChangedSignal("AbsoluteSize"), function() self:refreshButtons() end)
	return self
end

-- Cutia de argumente primește toată înălțimea rămasă din card; restul rândurilor au înălțimi fixe,
-- deci „Refuză” rămâne vizibil oricât de mică ar fi fereastra (o cutie prea mică lasă doar „Refuză”).
function ApprovalView:layout()
	if self.destroyed then return end
	self.scroll.Size = UDim2.new(1, 0, 0, math.max(0, self.root.AbsoluteSize.Y - FIXED_HEIGHT))
	self:measure()
end

function ApprovalView:inspectable(id)
	return not self.destroyed and self.windowVisible and self.current ~= nil and self.current.id == id and self.root.Visible
		and self.fullText and self.measured and self.scroll.AbsoluteWindowSize.Y &gt;= 24
		and self.code.Text == self.text and self.code.TextFits
		and math.floor(self.scroll.AbsoluteWindowSize.X - GUTTER * 2) == self.width
		and math.abs(self.code.AbsoluteSize.X - self.width) &lt;= 1 and self.code.AbsoluteSize.Y &gt;= self.height
end

function ApprovalView:measure()
	if self.destroyed then return end
	self.measured = false
	local width = math.max(1, math.floor(self.scroll.AbsoluteWindowSize.X - GUTTER * 2))
	local success, bounds = pcall(function()
		return TextService:GetTextSize(self.code.Text, CODE_SIZE, Theme.font("mono"), Vector2.new(width, MAX_HEIGHT + 1))
	end)
	local fits = success and width &gt;= 64 and bounds.X &gt;= 0 and bounds.X &lt;= width and bounds.Y &gt;= 0 and bounds.Y &lt; MAX_HEIGHT - 16
	self.width, self.height = width, if fits then math.ceil(bounds.Y) + 16 else MAX_HEIGHT
	self.code.Size = UDim2.fromOffset(self.width, self.height)
	self.scroll.CanvasSize = UDim2.fromOffset(0, self.height + GUTTER * 2)
	self.measured = fits
	self:refreshButtons()
end

-- Store-ul află dacă apelul a putut fi citit integral; HubView activează „Permite” din cardul lui pe același criteriu.
function ApprovalView:report(approval, ok)
	if not approval then
		self.reportedId, self.reported = nil, nil
		return
	end
	if self.reportedId == approval.id and self.reported == ok then return end
	self.reportedId, self.reported = approval.id, ok
	self.store:setApprovalInspectable(self.windowId, approval.id, ok)
end

function ApprovalView:refreshButtons()
	if self.destroyed then return end
	local approval = self.current
	local inspectable = approval ~= nil and self:inspectable(approval.id)
	Theme.enabled(self.approve, approval ~= nil and self.canDecide and not approval.inactive and not approval.blocked and inspectable)
	Theme.enabled(self.refuse, approval ~= nil and (self.canDecide or approval.inactive == true))
	self.refuse.Text = if approval and approval.inactive then "Închide" else "Refuză"
	self.hint.Text = if inspectable then "Cod integral. Derulează înainte de decizie." else "Afișare incompletă: numai Refuză."
	self:report(approval, inspectable)
end

function ApprovalView:update(window, connected)
	if self.destroyed then return end
	local approval = window.approvals[1]
	self.root.Visible = approval ~= nil
	self.windowVisible = window.visible
	self.canDecide = connected and window.visible and not window.decisionId and not window.cancelling
	if self.current ~= approval then
		self.current = approval
		self.text, self.fullText = "", false
		self.reportedId, self.reported = nil, nil
		if approval then self.text, self.fullText = formatArguments(approval) end
		self.code.Text = self.text
		self.scroll.CanvasPosition = Vector2.zero
		self:measure()
	end
	if approval then
		self.title.Text = if approval.inactive then "Apelul nu mai este activ" else "Modificarea propusă"
		self.meta.Text = if #window.approvals &gt; 1 then "1 din " .. #window.approvals .. " în așteptare" else ""
		self.tool.Text = Theme.fit(tostring(approval.tool or "Instrument necunoscut"), 48)
	end
	self:refreshButtons()
end

function ApprovalView:destroy()
	Theme.cleanup(self)
	self.root:Destroy()
end

return ApprovalView
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX5">
        <Properties>
          <string name="Name">BridgeController</string>
          <ProtectedString name="Source">-- Legătura pluginului cu daemon-ul local (singurul modul, împreună cu loader-ul, care folosește HttpService). 1.0: conectare automată cu codul livrat
-- de loader (reconectare cu backoff 1 → 15 s), identitatea Roblox (StudioService/Players) trimisă prin POST /v1/identity, „Panou” prin POST /v1/panel/open,
-- vizualizarea altor workspace-uri prin GET /v1/hub/workspace(s), polling (joburi 1 s, tablă 2 s, status 10 s, identitate 30 s) și inventarul proiectului.
-- Maparea răspunsurilor în store (applyStatus, syncBoard, applyWorkspaces, applyWorkspaceView) este a SessionStore-ului; aici stau doar cadența și erorile.
local HttpService = game:GetService("HttpService")
local Selection = game:GetService("Selection")
local Players = game:GetService("Players")
local Store = require(script.Parent.SessionStore)
local Scanner = require(script.Parent.ProjectScanner)
local Controller = {}
Controller.__index = Controller
local BASE = "http://127.0.0.1:34871"
local HOST = "127.0.0.1:34871"
local TOKEN_SETTING = "StudioHarnessBridgeToken"
local TOKEN_PLACEHOLDER = "STUDIO_HARNESS_LOCAL_TOKEN_PLACEHOLDER"
local AVATAR = "rbxthumb://type=AvatarHeadShot&amp;id=%d&amp;w=48&amp;h=48"
local UNKNOWN_NAME = "Studio"
local OLD_DAEMON = "Daemon vechi sau lipsă: pornește daemon-ul 1.0 sau mai nou din terminalul cu pluginul Claude Code sau din Start-Daemon.cmd. Trimiterea este blocată."
local PROJECT_UNSUPPORTED = "daemon-ul nu primește inventarul (necesită 0.7)"
local SCAN_INTERVAL, SCAN_DEBOUNCE = 30, 5
local POLL_INTERVAL, BOARD_INTERVAL, STATUS_INTERVAL, IDENTITY_INTERVAL, VIEW_INTERVAL = 1, 2, 10, 30, 5
local RETRY_MIN, RETRY_MAX = 1, 15
local IDENTITY_PROPERTIES = { "PlaceId", "GameId", "Name" }

local function validToken(token)
	return type(token) == "string" and #token &gt;= 8 and #token &lt;= 512 and string.find(token, "[%c%s\\]") == nil and token ~= TOKEN_PLACEHOLDER
end

local function context()
	local selected = {}
	for _, object in ipairs(Selection:Get()) do
		if #selected &gt;= 50 then break end
		local ok, path = pcall(function() return object:GetFullName() end)
		if ok then table.insert(selected, path) end
	end
	-- Forma documentată în STUDIO_BRIDGE_CONTRACT (fără creator): doar citirile locului trec prin helperul pur și protejat.
	local place = Scanner.place()
	return { place_id = place.place_id, game_id = place.game_id, place_name = place.place_name, selection = selected }
end

-- Id-ul contului din Studio (StudioService); indisponibil sau 0 → identitate necunoscută.
local function studioUserId()
	local ok, id = pcall(function() return game:GetService("StudioService"):GetUserId() end)
	return if ok and type(id) == "number" and id == id and id &gt; 0 then math.floor(id) else 0
end

-- Corpul POST /v1/identity (contract §4.4): contul și jocul deschis; avatarul se derivă în daemon din user_id.
-- Locul și limitele câmpurilor vin din `Scanner` (helperi puri, testați în ProjectScanner.spec), ca antetul chunk-urilor și
-- identitatea să raporteze exact aceleași valori.
local function identityPayload(identity)
	return Scanner.identityPayload(Scanner.place(), identity.userId, identity.name)
end

function Controller.new(pluginObject, store, snapshot)
	local self = setmetatable({ plugin = pluginObject, store = store, alive = true, generation = 0,
		token = "", tokenOrigin = nil, tokenRejected = false, manualStop = false, retryDelay = RETRY_MIN, reconnect = nil,
		worker = nil, cancelWorker = nil, accountWorker = nil, queue = {}, urgent = {},
		nextPoll = 0, nextBoard = 0, nextStatus = 0, nextIdentity = 0, nextView = 0, failures = 0, remoteBusy = false, identity = nil, resolving = false, lastHub = nil, viewFailure = nil,
		project = nil, lastDigest = nil, nextScan = math.huge, pendingScan = nil, projectDisabled = false, connections = {} }, Controller)
	-- Orice modificare din scenă cere o rescanare la 5 s după ultimul eveniment; digestul neschimbat nu retrimite nimic.
	local function changed()
		if self.alive then self.pendingScan = os.clock() + SCAN_DEBOUNCE end
	end
	for _, signal in ipairs({ game.DescendantAdded, game.DescendantRemoving }) do
		local ok, connection = pcall(function() return signal:Connect(changed) end)
		if ok then table.insert(self.connections, connection) end
	end
	-- Schimbarea locului (PlaceId/GameId/Name) retrimite identitatea la următoarea iterație; daemon-ul recalculează workspace-ul.
	for _, property in ipairs(IDENTITY_PROPERTIES) do
		local ok, connection = pcall(function()
			return game:GetPropertyChangedSignal(property):Connect(function() if self.alive then self.nextIdentity = 0 end end)
		end)
		if ok then table.insert(self.connections, connection) end
	end
	-- Codul local: din snapshotul aplicației anterioare (metamorfoză) sau din handoff-ul loader-ului, altfel din setări; conectare fără intervenția utilizatorului.
	local token, source = "", nil
	if type(snapshot) == "table" then
		if validToken(snapshot.token) then token, source = snapshot.token, if type(snapshot.source) == "string" then snapshot.source else "settings" end
		self.manualStop = snapshot.manualStop == true
		local identity = snapshot.identity
		if type(identity) == "table" and type(identity.userId) == "number" and type(identity.name) == "string" then
			self.identity = { userId = identity.userId, name = identity.name, avatar = if type(identity.avatar) == "string" then identity.avatar else nil, resolved = identity.resolved == true }
		end
	end
	if token == "" then token = self:savedToken(); source = if token ~= "" then "settings" else nil end
	self.tokenOrigin = source
	self.accountWorker = task.spawn(function()
		self:account()
		if self.alive then self:publishIdentity() end
	end)
	if token ~= "" and not self.manualStop then self:connect(token, source) end
	return self
end

-- Starea legăturii pentru handoff: codul local (niciodată în store sau în serialize()), sursa lui, oprirea manuală și contul deja rezolvat.
function Controller:snapshot()
	local identity = self.identity
	return { token = if self.tokenRejected then "" else self.token, source = self.tokenOrigin, manualStop = self.manualStop,
		identity = if identity then { userId = identity.userId, name = identity.name, avatar = identity.avatar, resolved = identity.resolved } else nil }
end

function Controller:savedToken()
	local ok, token = pcall(function() return self.plugin:GetSetting(TOKEN_SETTING) end)
	return if ok and validToken(token) then token else ""
end

-- Adevărat doar după `stop()` (oprire manuală): atunci reconectarea automată este suspendată, deci UI-ul oferă „Conectează daemon-ul”.
function Controller:manualStopped()
	return self.manualStop == true
end

-- Sursa codului folosit: "loader" (livrat la instalare), "settings" (salvat anterior), "manual" (lipit în Avansat) sau nil.
function Controller:tokenSource()
	return self.tokenOrigin
end

-- Câmpul „Cod de asociere” din Avansat apare doar când nu există un cod valid sau daemon-ul l-a refuzat (401).
function Controller:needsToken()
	return self.tokenRejected or (self.token == "" and self:savedToken() == "")
end

function Controller:valid(generation)
	return self.alive and self.store.connected and self.generation == generation
end

function Controller:request(method, path, data, token)
	local headers = { ["X-Studio-Harness-Token"] = token }
	local options = { Url = BASE .. path, Method = method, Headers = headers }
	if method ~= "GET" then
		headers["Content-Type"] = "application/json"
		local ok, encoded = pcall(function() return if data == nil or next(data) == nil then "{}" else HttpService:JSONEncode(data) end)
		if not ok then return nil, "Cererea nu poate fi codificată JSON.", 400 end
		options.Body = encoded
	end
	local ok, response = pcall(function() return HttpService:RequestAsync(options) end)
	if not ok then return nil, "Daemon-ul local nu a răspuns. Verifică pornirea lui și permisiunea HTTP pentru 127.0.0.1.", nil end
	local decoded, body = pcall(function() return HttpService:JSONDecode(response.Body) end)
	if not decoded or type(body) ~= "table" then return nil, "Răspuns JSON invalid de la daemon.", response.StatusCode end
	if response.Success ~= true or body.ok ~= true then return nil, tostring(body.error or "Cererea a fost respinsă."), response.StatusCode end
	return body, nil, response.StatusCode
end

function Controller:status(text, isError)
	self.store.status, self.store.statusError = text, isError == true
	self.store:emit(nil)
end

-- Starea hub-ului raportată de daemon (connecting | pending | approved | offline | revoked | disabled) sau nil fără daemon.
function Controller:hubStatus()
	local hub = self.store.hub
	return if type(hub) == "table" and type(hub.status) == "string" then hub.status else nil
end

-- Contul Roblox din Studio, memorat per id; numele (Players, poate cere rețeaua) se reîncearcă la următorul apel dacă nu a putut fi citit.
function Controller:account()
	local userId = studioUserId()
	if userId == 0 then
		self.identity = { userId = 0, name = UNKNOWN_NAME, avatar = nil, resolved = true }
		return self.identity
	end
	local current = self.identity
	if current and current.userId == userId and current.resolved then return current end
	-- O singură interogare Players la un moment dat: al doilea apelant așteaptă rezultatul primului (cel mult 10 s).
	if self.resolving then
		local deadline = os.clock() + 10
		while self.resolving and os.clock() &lt; deadline do task.wait(0.1) end
		current = self.identity
		if current and current.userId == userId and current.resolved then return current end
	end
	self.resolving = true
	local ok, name = pcall(function() return Players:GetNameFromUserIdAsync(userId) end)
	self.resolving = false
	local resolved = ok and type(name) == "string" and string.find(name, "%S") ~= nil
	self.identity = { userId = userId, name = if resolved then Store.prefix(name, 64) else "user_" .. userId, avatar = string.format(AVATAR, userId), resolved = resolved }
	return self.identity
end

-- Antetul arată contul și fără daemon: store.identity se completează local până când daemon-ul o confirmă prin status sau tablă.
function Controller:publishIdentity()
	local identity = self.identity
	if not identity or self.store.identity ~= nil then return end
	self.store.identity = { userId = identity.userId, name = identity.name, avatar = identity.avatar }
	self.store:emit(nil)
end

function Controller:applyStatus(data)
	local compatible = Store.isCompatible(data)
	self.store.compatible = compatible
	if compatible and self.store:remoteChanged(data.bridge_id) then
		self.queue, self.urgent = {}, {}
		self.nextBoard, self.nextIdentity, self.nextView = 0, 0, 0
		self:dropProject(true)
	end
	self.store:applyStatus(data)
	self:publishIdentity()
	-- O stare nouă a hub-ului (ex. pending → approved) aduce imediat tabla și vizualizarea altui workspace.
	local hub = self:hubStatus()
	if hub ~= self.lastHub then self.lastHub, self.nextBoard, self.nextView = hub, 0, 0 end
	self.remoteBusy = type(data.active_job_id) == "string" or (tonumber(data.queued_count) or 0) &gt; 0
	self:status(if compatible then "Daemon · " .. HOST else OLD_DAEMON, not compatible)
end

-- Reconectarea automată după un eșec: 1, 2, 4, 8, apoi 15 s; se resetează la prima stare citită cu succes.
function Controller:scheduleReconnect()
	local delay = self.retryDelay
	self.retryDelay = math.min(delay * 2, RETRY_MAX)
	if self.reconnect then pcall(task.cancel, self.reconnect) end
	self.reconnect = task.delay(delay, function()
		self.reconnect = nil
		if self.alive and not self.store.connected and not self.manualStop then self:connect("") end
	end)
	return delay
end

-- „Deconectează daemon-ul” din Avansat: oprire cerută de utilizator, fără reconectare automată (revine doar prin `connect`).
function Controller:stop()
	self:disconnect(nil)
end

-- Fără mesaj = oprire cerută de utilizator (fără reconectare); cu mesaj = eșec, urmat de reconectare automată cu backoff.
function Controller:disconnect(message, code)
	self.generation += 1
	self.store.connected, self.store.connecting = false, false
	self.store:resetUpdate()
	self.store:resetProject()
	self.store:resetHub()
	self.viewFailure = nil
	self:dropProject(false)
	self.queue, self.urgent = {}, {}
	local worker, urgent = self.worker, self.cancelWorker
	self.worker, self.cancelWorker = nil, nil
	if worker and worker ~= coroutine.running() then pcall(task.cancel, worker) end
	if urgent and urgent ~= coroutine.running() then pcall(task.cancel, urgent) end
	for _, window in pairs(self.store.windows) do
		window.cancelling, window.decisionId, window.closeAfterCancel, window.releasing = false, nil, false, false
		if window.request then
			window.request.state, window.state = "uncertain", "uncertain"
			if window.request.message then window.request.message.author = "Tu · neconfirmat" end
		end
	end
	self.manualStop = message == nil
	if self.manualStop then
		if self.reconnect then pcall(task.cancel, self.reconnect); self.reconnect = nil end
		self:status("Daemon deconectat la cerere. Joburile deja trimise pot continua; nu sunt retrimise automat.")
		return
	end
	if code == 401 then self.tokenRejected, self.retryDelay = true, RETRY_MAX end
	if not self.alive then return end
	local delay = self:scheduleReconnect()
	self:status("Daemon · nu răspunde (reîncerc în " .. delay .. " s): " .. tostring(message), true)
end

-- `token` gol → codul curent sau cel din setări; un cod lipit manual devine sursa "manual". Conectarea pornește firul de polling.
function Controller:connect(token, source)
	if not self.alive or self.store.connected then return end
	token = string.match(tostring(token or ""), "^%s*(.-)%s*$") or ""
	local typed = token ~= ""
	if not typed then token = if self.token ~= "" then self.token else self:savedToken() end
	if not validToken(token) then
		self:status(if typed then "Introdu codul local al daemon-ului, fără spații. Nu parola contului."
			else "Lipsește codul local: rulează Install-Studio-Plugin.cmd sau lipește codul din daemon.log în Avansat.", true)
		return
	end
	if self.reconnect then pcall(task.cancel, self.reconnect); self.reconnect = nil end
	self.generation += 1
	self.token = token
	self.tokenOrigin = if typed then "manual" else (source or self.tokenOrigin or "settings")
	self.tokenRejected, self.manualStop = false, false
	self.store.connected, self.store.connecting = true, true
	-- Ultima tablă rămâne valabilă până sosește una nouă.
	self.failures, self.nextPoll, self.nextBoard, self.nextIdentity, self.nextView = 0, 0, 0, 0, 0
	self:status("Daemon · se conectează…")
	local generation = self.generation
	self.worker = task.defer(function()
		local success, message = pcall(function() self:loop(generation) end)
		if not success and self:valid(generation) then self:disconnect("Controllerul s-a oprit: " .. tostring(message)) end
	end)
end

function Controller:pollFailure(message, code)
	self.failures += 1
	if code == 401 or code == 403 or self.failures &gt;= 3 then self:disconnect(message, code)
	else self:status("Legătura locală este întreruptă temporar; verific din nou…", true) end
end

function Controller:loop(generation)
	if not self:valid(generation) then return end
	local data, message, code = self:request("GET", "/v1/status", nil, self.token)
	if not self:valid(generation) then return end
	if not data then self:disconnect(message, code); return end
	self.store.connecting = false
	self.retryDelay = RETRY_MIN
	self.nextStatus = os.clock() + STATUS_INTERVAL
	pcall(function() self.plugin:SetSetting(TOKEN_SETTING, self.token) end)
	self:applyStatus(data)
	self:dropProject(true)
	while self:valid(generation) do
		local action = table.remove(self.queue, 1)
		local jobs = self.store:jobs()
		local now = os.clock()
		if action then
			if not action.bridgeId or action.bridgeId == self.store.bridgeId then
				action.run(generation)
			end
		elseif #jobs &gt; 0 and self.store.compatible and now &gt;= self.nextPoll then
			for offset = 1, #jobs, 16 do
				local batch = {}
				for index = offset, math.min(offset + 15, #jobs) do table.insert(batch, jobs[index]) end
				local result, errorMessage, resultCode = self:request("POST", "/v1/jobs/poll", { jobs = batch }, self.token)
				if not self:valid(generation) then return end
				if result then
					if type(result.bridge_id) ~= "string" or result.bridge_id == "" then
						self:pollFailure("Daemon-ul nu a identificat originea evenimentelor.", nil)
						break
					end
					self.failures = 0
					if self.store:remoteChanged(result.bridge_id) then
						self.queue, self.urgent = {}, {}
						self.nextStatus, self.nextBoard, self.nextIdentity = 0, 0, 0
						self:dropProject(true)
						break
					end
					for _, snapshot in ipairs(if type(result.jobs) == "table" then result.jobs else {}) do
						if type(snapshot) == "table" then self.store:applyEvents(snapshot) end
					end
				elseif resultCode == 404 then
					self.store.compatible = false
					self:status(OLD_DAEMON, true)
					break
				else self:pollFailure(errorMessage, resultCode); break end
			end
			self.nextPoll = os.clock() + POLL_INTERVAL
		elseif self.store.compatible and now &gt;= self.nextBoard then
			local result, errorMessage, resultCode = self:request("GET", "/v1/board", nil, self.token)
			if not self:valid(generation) then return end
			self.nextBoard = os.clock() + BOARD_INTERVAL
			if result then
				self.failures = 0
				if type(result.bridge_id) == "string" and self.store:remoteChanged(result.bridge_id) then
					self.queue, self.urgent = {}, {}
					self.nextStatus, self.nextBoard, self.nextIdentity = 0, 0, 0
					self:dropProject(true)
				else
					self.store:syncBoard(result)
					self:publishIdentity()
				end
			elseif resultCode == 404 then
				self.store.compatible = false
				self:status(OLD_DAEMON, true)
			else self:pollFailure(errorMessage, resultCode) end
		elseif now &gt;= self.nextStatus then
			local result, errorMessage, resultCode = self:request("GET", "/v1/status", nil, self.token)
			if not self:valid(generation) then return end
			self.nextStatus = os.clock() + STATUS_INTERVAL
			if result then self.failures = 0; self:applyStatus(result)
			else self:pollFailure(errorMessage, resultCode) end
		elseif self.store.compatible and now &gt;= self.nextIdentity then self:sendIdentity(generation)
		elseif self.store.compatible and self.store.viewWorkspace ~= nil and now &gt;= self.nextView then self:fetchView(generation)
		-- Inventarul: cel mult un chunk pe iterație, după poll/board/status, ca evenimentele să nu aștepte.
		elseif self.store.compatible and self.project then self:sendProjectChunk(generation)
		elseif self.store.compatible and self:scanDue() then self:scanProject()
		else task.wait(0.15) end
	end
end

-- POST /v1/identity la conectare, la 30 s și la schimbarea locului; tabla următoare aduce workspace-ul și identitatea confirmate de daemon.
function Controller:sendIdentity(generation)
	self.nextIdentity = os.clock() + IDENTITY_INTERVAL
	local identity = self:account()
	if not self:valid(generation) then return end
	self:publishIdentity()
	local response, message, code = self:request("POST", "/v1/identity", identityPayload(identity), self.token)
	if not self:valid(generation) then return end
	if response then
		self.failures = 0
		self.nextBoard = 0
	elseif code == 401 or code == 403 then self:disconnect(message, code)
	elseif code ~= nil and code &gt;= 400 and code &lt; 500 then self:status("Identitatea nu a fost acceptată de daemon: " .. tostring(message), true)
	else self:pollFailure(message, code) end
end

-- Modul de aprobare a operațiilor cerute de agent. Daemon-ul îl păstrează în `config.json`, deci ține și după repornire.
function Controller:setAutoApprove(mode)
	if mode ~= "ask" and mode ~= "edits" and mode ~= "all" then return false end
	if not self.store.connected or self.store.connecting or not self.store.compatible then
		self:status("Aprobarea se schimbă prin daemon: pornește-l și așteaptă conectarea.", true)
		return false
	end
	local previous = self.store.autoApprove
	-- Arătăm imediat noua stare; dacă daemon-ul refuză, revenim la cea veche și spunem de ce.
	self.store.autoApprove = mode
	self.store:emit(nil)
	table.insert(self.queue, 1, { bridgeId = self.store.bridgeId, run = function(generation)
		local response, message, code = self:request("POST", "/v1/settings", { auto_approve = mode }, self.token)
		if not self:valid(generation) then return end
		if response then return end
		self.store.autoApprove = previous
		self.store:emit(nil)
		if code == 401 or code == 403 then self:disconnect(message, code) else self:status("Aprobarea nu s-a schimbat: " .. tostring(message), true) end
	end })
	return true
end

-- Butonul „Panou”: daemon-ul deschide browserul la panoul hub-ului (adresa cu tokenul dispozitivului nu trece prin plugin).
function Controller:openPanel()
	if not self.store.connected or self.store.connecting or not self.store.compatible then
		self:status("Panoul se deschide prin daemon: pornește-l și așteaptă conectarea.", true)
		return false
	end
	if self:hubStatus() == "disabled" then
		self:status("Hub dezactivat (daemon pornit cu --no-hub): panoul nu este disponibil.", true)
		return false
	end
	table.insert(self.queue, 1, { bridgeId = self.store.bridgeId, run = function(generation)
		local response, message, code = self:request("POST", "/v1/panel/open", {}, self.token)
		if not self:valid(generation) then return end
		if response then return end
		if code == 401 or code == 403 then self:disconnect(message, code) else self:status("Panoul nu s-a deschis: " .. tostring(message), true) end
	end })
	return true
end

-- „Alte workspace-uri”: privește un alt workspace (read-only, `store.viewWorkspace`); nil sau cheia jocului deschis revin la workspace-ul curent.
function Controller:viewWorkspace(key)
	if not self.store:setViewWorkspace(key) then return false end
	self.nextView = 0
	self:setViewFailure(nil)
	return true
end

-- Motivul pentru care vizualizarea workspace-ului privit nu a putut fi citită (text în română) sau nil; HubView îl arată în locul listei.
function Controller:viewError()
	return self.viewFailure
end

function Controller:setViewFailure(message)
	if self.viewFailure == message then return end
	self.viewFailure = message
	self.store:emit(nil)
end

-- GET /v1/hub/workspace?key= la 5 s cât timp vizualizarea e deschisă; fără hub aprobat nu se face nicio cerere, doar se explică starea.
function Controller:fetchView(generation)
	local key = self.store.viewWorkspace
	self.nextView = os.clock() + VIEW_INTERVAL
	local hub = self:hubStatus()
	if hub ~= "approved" then
		self:setViewFailure("Hub-ul nu este disponibil (stare: " .. tostring(hub or "necunoscută") .. ").")
		return
	end
	local response, message, code = self:request("GET", "/v1/hub/workspace?key=" .. HttpService:UrlEncode(key), nil, self.token)
	if not self:valid(generation) or self.store.viewWorkspace ~= key then return end
	if response then
		self.failures = 0
		self.viewFailure = nil
		self.store:applyWorkspaceView(key, response)
	elseif code == 401 or code == 403 then self:disconnect(message, code)
	else self:setViewFailure(tostring(message)) end
end

-- Lista „Alte workspace-uri” la cerere (GET /v1/hub/workspaces); statusul și tabla o împrospătează oricum la 10 s / 2 s.
function Controller:refreshWorkspaces()
	if not self.store.connected or self.store.connecting or not self.store.compatible or self:hubStatus() ~= "approved" then return false end
	table.insert(self.queue, { bridgeId = self.store.bridgeId, run = function(generation)
		local response, message, code = self:request("GET", "/v1/hub/workspaces", nil, self.token)
		if not self:valid(generation) then return end
		if response then
			self.store:applyWorkspaces(response.workspaces)
			self.store:emit(nil)
		elseif code == 401 or code == 403 then self:disconnect(message, code)
		else self:status("Lista workspace-urilor nu a putut fi citită: " .. tostring(message), true) end
	end })
	return true
end

function Controller:dropProject(rescan)
	self.project, self.lastDigest, self.pendingScan, self.projectDisabled = nil, nil, nil, false
	self.nextScan = if rescan then 0 else math.huge
end

function Controller:scanDue()
	if self.projectDisabled then return false end
	local now = os.clock()
	return now &gt;= self.nextScan or (self.pendingScan ~= nil and now &gt;= self.pendingScan)
end

function Controller:scanProject()
	self.nextScan, self.pendingScan = os.clock() + SCAN_INTERVAL, nil
	local ok, result = pcall(Scanner.scan)
	if not ok then self.store:setProject("error", { message = "scanarea a eșuat: " .. tostring(result) }); return end
	if result.digest == self.lastDigest then return end
	self.lastDigest = result.digest
	local chunks = Scanner.chunks(result.nodes, Scanner.CHUNK_BYTES, function(value) return HttpService:JSONEncode(value) end)
	self.project = { id = HttpService:GenerateGUID(false), chunks = chunks, index = 1, truncated = result.truncated }
	self.store:setProject("sending", { snapshotId = self.project.id, count = result.count, truncated = result.truncated, message = "" })
end

-- Un chunk al inventarului (contract §8.5): antetul poartă și jocul/creatorul, ca daemon-ul să lege proiectul de workspace.
function Controller:sendProjectChunk(generation)
	local project = self.project
	local payload = Scanner.chunkPayload(project, Scanner.place(), self.store.defaultStudioId)
	local response, message, code = self:request("POST", "/v1/project/chunks", payload, self.token)
	if not self:valid(generation) or self.project ~= project then return end
	if response then
		self.failures = 0
		project.index += 1
		if project.index &gt; #project.chunks then
			self.project = nil
			self.store:setProject("sent", { sentAt = os.time() })
		end
		return
	end
	-- Snapshotul este abandonat; fără digest, următorul ciclu de 30 s îl retrimite (404: daemon fără inventar, nu mai încercăm).
	self.project, self.lastDigest = nil, nil
	if code == 404 then self.projectDisabled, message = true, PROJECT_UNSUPPORTED end
	self.store:setProject("error", { message = tostring(message) })
	if code == 401 or code == 403 then self:disconnect(message, code) end
end

function Controller:createWindow(provider, studio, name)
	local id = HttpService:GenerateGUID(false)
	local window = self.store:create(id, provider or self.store.defaultProvider, studio or self.store:studio(self.store.defaultStudioId), name)
	if not window then self:status("Limita este de 32 de ferestre. Închide o sesiune inactivă înainte de a crea alta.", true) end
	return window
end

function Controller:setDefaultStudio(studioId)
	if not self.store:setDefaultStudio(studioId) then return end
	if not self.store.connected or self.store.connecting or not studioId then return end
	table.insert(self.queue, { bridgeId = self.store.bridgeId, run = function(generation)
		local response, message, code = self:request("POST", "/v1/default-studio", { studio_id = studioId }, self.token)
		if not self:valid(generation) then return end
		if not response then
			if code == 401 or code == 403 then self:disconnect(message, code) else self:status("Studio-ul țintă nu a fost confirmat de daemon: " .. tostring(message), true) end
		end
	end })
end

function Controller:sendRequest(window, request)
	local windowId, requestId = window.id, request.id
	table.insert(self.queue, { bridgeId = request.bridgeId, run = function(generation)
		local current = self.store.windows[windowId]
		if not current or current.request ~= request then return end
		local response, message, code = self:request("POST", "/v1/chat", request.payload, self.token)
		if not self:valid(generation) then return end
		if response and self.store:acceptRequest(windowId, requestId, response) then
			self.nextPoll = 0
			local live = self.store.windows[windowId]
			if live and live.closeAfterCancel and not self:cancel(windowId, true) then live.closeAfterCancel = false end
		else
			local rejected = code == 400 or code == 401 or code == 403 or code == 404 or code == 409 or code == 410 or code == 413 or code == 429
			self.store:requestFailed(windowId, requestId, tostring(message or "Răspunsul nu identifică un job valid."), not rejected or response ~= nil)
			if code == 401 or code == 403 then self:disconnect(message, code) end
		end
	end })
end

function Controller:send(id)
	local request, message = self.store:beginRequest(id, HttpService:GenerateGUID(false), context())
	if not request then
		local window = self.store.windows[id]
		if window then self.store:message(window, "Nu am trimis", message, "error"); self.store:emit(id) end
		return
	end
	self:sendRequest(self.store.windows[id], request)
end

function Controller:canRetry(window)
	local request = window and window.request
	return request ~= nil and request.state == "uncertain" and self.store.connected and not self.store.connecting
		and self.store.compatible and request.bridgeId == self.store.bridgeId and self.store:providerAvailable(window.provider)
end

function Controller:retry(id)
	local window = self.store.windows[id]
	local request = window and window.request
	if not self:canRetry(window) then return end
	request.state, window.state = "sending", "sending"
	self.store:emit(id)
	self:sendRequest(window, request)
end

function Controller:decide(id, approvalId, allow)
	local window = self.store.windows[id]
	local approval = window and window.approvals[1]
	if not approval or approval.id ~= approvalId then return end
	if approval.inactive then
		if not allow then self.store:removeApproval(id, approval.jobId, approval.id); self.store:emit(id) end
		return
	end
	if not self.store.connected or window.remote or window.cancelling or window.decisionId or (allow and approval.blocked) then return end
	window.decisionId = approvalId
	self.store:emit(id)
	local jobId, bridgeId = approval.jobId, self.store.bridgeId
	table.insert(self.queue, 1, { bridgeId = bridgeId, run = function(generation)
		local current = self.store.windows[id]
		if not current or not current.job or current.job.id ~= jobId then return end
		local response, message, code = self:request("POST", "/v1/jobs/" .. HttpService:UrlEncode(jobId) .. "/approve", { approval_id = approvalId, allow = allow }, self.token)
		if not self:valid(generation) then return end
		current = self.store.windows[id]
		if not current then return end
		if current.decisionId == approvalId then current.decisionId = nil end
		if response or code == 409 then
			self.store:removeApproval(id, jobId, approvalId)
			self.store:message(current, if code == 409 then "Aprobare expirată" else "Decizia ta",
				if code == 409 then tostring(message or "Apelul nu mai este activ.") else (if allow then "Aprobat: " else "Refuzat: ") .. tostring(approval.tool), "notice")
		else self.store:message(current, "Decizie neconfirmată", tostring(message) .. "\nNu este retrimisă automat.", "error") end
		self.nextPoll = 0
		self.store:emit(id)
		if code == 401 or code == 403 then self:disconnect(message, code) end
	end })
end

function Controller:releaseClaims(jobId, paths)
	if not self.store.connected or self.store.connecting or type(jobId) ~= "string" or jobId == "" then return false end
	local window = self.store:findJob(jobId)
	if window then
		-- Daemon-ul răspunde 403 pentru joburile altui dispozitiv; nu trimitem deloc.
		if window.remote then return false end
		if window.releasing then return true end
		window.releasing = true
		self.store:emit(window.id)
	end
	local body = if type(paths) == "table" and #paths &gt; 0 then { paths = paths } else {}
	table.insert(self.queue, { bridgeId = self.store.bridgeId, run = function(generation)
		local response, message, code = self:request("POST", "/v1/jobs/" .. HttpService:UrlEncode(jobId) .. "/release", body, self.token)
		if not self:valid(generation) then return end
		local current = self.store:findJob(jobId)
		if current then
			current.releasing = false
			self.store:message(current, if response then "Claims" else "Eliberare neconfirmată",
				if response then "Eliberat: " .. (if body.paths then table.concat(body.paths, ", ") else "toate claims-urile acestei sesiuni") else tostring(message), if response then "claim" else "error")
			self.store:emit(current.id)
		elseif not response then self:status("Eliberarea nu a fost confirmată: " .. tostring(message), true) end
		self.nextBoard = 0
		if code == 401 or code == 403 then self:disconnect(message, code) end
	end })
	return true
end

function Controller:cancel(id, closeAfter)
	local window = self.store.windows[id]
	if not window or not window.job or window.remote or not self.store.connected then return false end
	if closeAfter then window.closeAfterCancel = true end
	if window.cancelling then return true end
	window.cancelling = true
	self.store:emit(id)
	table.insert(self.urgent, { windowId = id, jobId = window.job.id, bridgeId = self.store.bridgeId })
	if self.cancelWorker then return true end
	local generation = self.generation
	-- O singură cale urgentă comună, independentă de polling și lockurile MCP.
	local function drain()
		while self:valid(generation) and #self.urgent &gt; 0 do
			local item = table.remove(self.urgent, 1)
			if item.bridgeId == self.store.bridgeId then
				local response, message, code = self:request("POST", "/v1/jobs/" .. HttpService:UrlEncode(item.jobId) .. "/cancel", {}, self.token)
				if not self:valid(generation) then return end
				local current = self.store.windows[item.windowId]
				if current and current.job and current.job.id == item.jobId then
					current.cancelling = false
					if response then
						self.store:finish(current, "cancelled")
						if current.closeAfterCancel then self.store:remove(current.id) else self.store:emit(current.id) end
					else
						current.closeAfterCancel = false
						self.store:message(current, "Anulare neconfirmată", tostring(message), "error"); self.store:emit(current.id)
					end
				elseif current and response and not current.job and current.closeAfterCancel then
					-- Jobul s-a încheiat prin poll înainte de răspunsul anulării trimise efectiv.
					self.store:remove(current.id)
				elseif current then
					current.closeAfterCancel = false
					self.store:emit(current.id)
				end
				if code == 401 or code == 403 then self:disconnect(message, code); return end
			end
		end
	end
	self.cancelWorker = task.defer(function()
		local success, failure = pcall(drain)
		if self.generation == generation then
			self.cancelWorker = nil
			if not success then
				self.urgent = {}
				for _, current in pairs(self.store.windows) do current.cancelling = false end
				self:status("Calea de anulare s-a oprit: " .. tostring(failure) .. ". Nu retrimit automat.", true)
			end
		end
	end)
	return true
end

function Controller:close(id, confirmed)
	local window = self.store.windows[id]
	if not window then return end
	if window.kind == "terminal" then self.store:dismissTerminal(id); return end
	if window.job or window.request then
		if not confirmed then window.closeConfirm = true; window.visible = true; self.store:emit(id); return end
		if window.job then
			if not self:cancel(id, true) then
				window.closeAfterCancel = false
				self.store:message(window, "Închidere anulată", "Așteaptă reconectarea daemon-ului, apoi apasă din nou × pentru a anula jobul înainte de închidere.", "error"); self.store:emit(id)
			end
		else
			window.closeAfterCancel = true
			self.store:message(window, "Închidere în așteptare", "Aștept identificarea cererii trimise înainte de anulare. Pentru o trimitere neconfirmată, reluarea se face numai cu confirmarea ta explicită.", "notice")
			self.store:emit(id)
		end
	else self.store:remove(id) end
end

function Controller:destroy()
	self.alive = false
	self.generation += 1
	for _, key in ipairs({ "worker", "cancelWorker", "reconnect", "accountWorker" }) do
		if self[key] then pcall(task.cancel, self[key]); self[key] = nil end
	end
	self.queue, self.urgent = {}, {}
	self.project = nil
	for _, connection in ipairs(self.connections) do pcall(function() connection:Disconnect() end) end
	table.clear(self.connections)
end

return Controller
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX6">
        <Properties>
          <string name="Name">HubView</string>
          <ProtectedString name="Source">-- Studio Harness HubView 1.0.0 — dock-ul pluginului (design/DESIGN.md §10.1–§10.5): antet cu identitatea Roblox și starea hub-ului,
-- banner condiționat, workspace cu prezenți și „Alte workspace-uri”, acțiunea principală, sesiunile grupate „Ale tale” / „În workspace”,
-- aprobarea inline, claims-urile, jurnalul și subsolul cu secțiunea pliabilă „Avansat”.
-- Toate piesele vizuale vin din Theme.luau (nicio culoare literală aici), datele din SessionStore, acțiunile din BridgeController.
-- Re-randarea reciclează instanțele după cheie (id de fereastră, job, cale, dispozitiv): la fiecare `store:emit` se schimbă doar textele,
-- iar conexiunile intrărilor reciclate sunt ținute de intrare (nu de view), ca lista să nu adune conexiuni moarte.
local Theme = require(script.Parent.Theme)
local Hub = {}
Hub.__index = Hub

local VISIBILITY_SETTING = "StudioHarnessMatrixHubVisible"
local WIDGET_ID = "StudioHarnessMatrixHub040"
-- Versiunea afișată în antet; se bumpează odată cu antetul `App` din Main.luau (faza 9).
local APP_VERSION = "1.0.0"
local MAX_WINDOWS = 32
local HEADER_ACTIONS = 112 -- lățimea rezervată în antet pentru „v1.0.0” și butonul „Panou”
local HEADER_INDENT = 36 -- avatarul (28) plus spațiul de după el: linia stării hub-ului se aliniază sub nume

-- Texte normative (DESIGN.md §12.1, §12.2).
local DAEMON_DOWN = "Daemon-ul nu răspunde. Pornește CLI-ul cu pluginul Studio Harness sau Start-Daemon.cmd."
local OLD_DAEMON = "Pornește daemon-ul 1.0 sau mai nou (terminal cu pluginul Claude Code sau Start-Daemon.cmd)."
local EMPTY_MINE = "Nicio sesiune încă. Alege providerul și apasă „Sesiune nouă”, sau pornește CLI-ul din terminal cu pluginul activ."
local EMPTY_CLAIMS = "Nicio zonă revendicată. Agenții cer hub_claim înainte de a modifica scena."
local EMPTY_JOURNAL = "Nicio modificare înregistrată încă în acest workspace."
local EMPTY_WORKSPACES = "Doar acest workspace este folosit acum."
local EMPTY_MEMBERS = "Nimeni prezent acum."
local UNPUBLISHED = "Fișier nepublicat. Publică locul ca să apară în hub pentru ceilalți."
local DISCONNECT_CONFIRM = "Deconectezi daemon-ul? Sesiunile deschise rămân, dar nu mai primesc mesaje până la reconectare."
local APPROVAL_HINT = "Deschide sesiunea pentru argumentele complete."
local APPROVAL_BLOCKED = "Afișarea integrală depășește limita locală. Numai Refuză este disponibil."
local CODE_PLACEHOLDER = "Lipește codul din daemon.log"
local CODE_HINT = "Apasă Enter ca să conectezi daemon-ul cu codul lipit."
-- Codul refuzat de daemon (401): sursa lui (`controller:tokenSource()`) spune de unde trebuie luat unul nou.
local CODE_REFUSED = { loader = "Codul livrat la instalare a fost refuzat. ", settings = "Codul salvat în setări a fost refuzat. ",
	manual = "Codul lipit a fost refuzat. " }

-- Un bloc al listei principale: piese apropiate (pas 8) care formează împreună un singur rând al dock-ului.
local function block(parent, name, order, gap)
	local root = Theme.new("Frame", { Name = name, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order }, parent)
	Theme.list(root, gap or Theme.SPACE.sm)
	return root
end

-- Etichetă care se întinde doar cât textul ei, cu o limită peste care se trunchiază (antet, chip-uri de proprietar).
local function inlineLabel(parent, options, maxWidth)
	local label = Theme.label(parent, "", options)
	label.AutomaticSize = Enum.AutomaticSize.X
	label.Size = UDim2.fromOffset(0, options.height or 20)
	Theme.new("UISizeConstraint", { MaxSize = Vector2.new(maxWidth, options.height or 20) }, label)
	return label
end

-- Rând orizontal care trece pe linia următoare când nu mai încape (chip-urile unui card la 320 px).
local function wrapRow(parent, name, order)
	local root = Theme.new("Frame", { Name = name, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order }, parent)
	local layout = Theme.list(root, Theme.SPACE.xs, true)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	-- `Wraps` există din 2023; fără el rândul rămâne pe o linie și se lasă tăiat de marginea dock-ului.
	pcall(function() layout.Wraps = true end)
	return root
end

-- Calea unei modificări din jurnal: ultimele trei segmente când depășește 48 de caractere (DESIGN.md §3.3).
local function shortPath(path)
	local text = tostring(path or "")
	if #text &lt;= 48 then return text end
	local segments = string.split(text, ".")
	if #segments &gt; 3 then
		return "…" .. segments[#segments - 2] .. "." .. segments[#segments - 1] .. "." .. segments[#segments]
	end
	return Theme.fit(text, 47)
end

-- Căile unei intrări de jurnal: primele două, plus „+N” pentru restul.
local function journalPaths(paths)
	local shown = {}
	for index, path in ipairs(paths) do
		if index &gt; 2 then break end
		table.insert(shown, shortPath(path))
	end
	local text = table.concat(shown, ", ")
	if #paths &gt; 2 then text = text .. " +" .. (#paths - 2) end
	return if text ~= "" then text else "—"
end

-- Rezumatul argumentelor unui apel, fără JSON (HttpService nu are ce căuta într-un view): perechi `cheie: valoare` scurtate.
-- Argumentele complete rămân în fereastra sesiunii; aici este doar cât să recunoști apelul.
local function argumentSummary(arguments)
	if type(arguments) ~= "table" then return "Argumentele nu pot fi afișate." end
	local keys = {}
	for key in pairs(arguments) do
		if type(key) == "string" then table.insert(keys, key) end
	end
	table.sort(keys)
	local parts = {}
	for _, key in ipairs(keys) do
		if #parts &gt;= 3 then break end
		local value = arguments[key]
		local text
		if type(value) == "string" then text = Theme.fit((string.gsub(value, "%s+", " ")), 36)
		elseif type(value) == "number" or type(value) == "boolean" then text = tostring(value)
		elseif type(value) == "table" then
			local count = 0
			for _ in pairs(value) do count += 1 end
			text = Theme.countLabel(count, "câmp", "câmpuri")
		else text = "…" end
		table.insert(parts, key .. ": " .. text)
	end
	if #parts == 0 then return "Fără argumente." end
	return Theme.fit(table.concat(parts, " · "), 80)
end

-- Modelul unui card de sesiune, comun ferestrelor proprii și sesiunilor citite din alt workspace.
local function windowModel(window)
	local _, label, role = Theme.sessionState(window)
	local owner = window.owner
	return { key = window.id, id = window.id, title = Theme.fit(window.name, 60), provider = window.provider,
		kind = if window.sessionKind == "studio" then "studio" else "terminal", owner = owner,
		who = if window.remote then Theme.fit(tostring((owner and owner.name) or "?"), 16) else "tu",
		state = label, role = role, approvals = #window.approvals, minimized = not window.visible, since = window.started }
end

local function sessionRowModel(row)
	local _, label, role = Theme.sessionState(row)
	return { key = row.jobId, id = row.jobId, title = Theme.fit(row.name, 60), provider = row.provider,
		kind = row.kind, owner = row.owner,
		who = if row.mine then "tu" else Theme.fit(tostring((row.owner and row.owner.name) or "?"), 16),
		state = label, role = role, approvals = if row.pendingApproval then 1 else 0, minimized = false, since = row.started }
end

function Hub.new(pluginObject, store, controller)
	local self = setmetatable({ connections = {}, destroyed = false, store = store, controller = controller,
		mineCards = {}, othersCards = {}, viewCards = {}, approvalCards = {}, claimRows = {}, journalRows = {},
		workspaceRows = {}, memberRows = {}, viewTab = "members", viewTabShown = "members", confirming = false,
		bannerKey = "", dismissedBanner = nil, confirmShown = false, providerShown = store.defaultProvider }, Hub)
	local saved, visible = pcall(function() return pluginObject:GetSetting(VISIBILITY_SETTING) end)
	local initialVisible = if saved and type(visible) == "boolean" then visible else true
	local info = DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Left, initialVisible, true, 336, 800, 320, 480)
	self.widget = pluginObject:CreateDockWidgetPluginGuiAsync(WIDGET_ID, info)
	self.widget.Title, self.widget.Name = "Studio Harness", "StudioHarnessHub"
	-- Studio întoarce același panou pentru același id cât ține sesiunea: dacă a mai rulat o instanță (repornire la Play,
	-- metamorfoză), conținutul ei vechi este încă înăuntru. Îl golim, ca să nu se suprapună două interfețe.
	for _, child in ipairs(self.widget:GetChildren()) do child:Destroy() end
	self.root = Theme.frame(self.widget, "Hub")
	self.scroll = Theme.scroll(self.root, "Content")
	Theme.new("UIPadding", { PaddingLeft = UDim.new(0, Theme.SPACE.lg), PaddingRight = UDim.new(0, Theme.SPACE.lg),
		PaddingTop = UDim.new(0, Theme.SPACE.md), PaddingBottom = UDim.new(0, Theme.SPACE.lg) }, self.scroll)
	Theme.list(self.scroll, Theme.SPACE.xl)
	self:buildHeader(1)
	self.banner = Theme.banner(self.scroll, { name = "Banner", close = true })
	self.banner.root.LayoutOrder = 2
	Theme.click(self, self.banner.close, function()
		self.dismissedBanner = self.bannerKey
		self.banner.hide()
	end)
	self:buildWorkspace(3)
	self:buildAction(4)
	self:buildSessions(5)
	self:buildApprovals(6)
	self:buildClaims(7)
	self:buildJournal(8)
	self:buildFooter(9)
	Theme.connect(self, self.widget:GetPropertyChangedSignal("Enabled"), function()
		pcall(function() pluginObject:SetSetting(VISIBILITY_SETTING, self.widget.Enabled) end)
	end)
	self:update()
	return self
end

-- Activarea unui buton dintr-o intrare reciclabilă: conexiunea aparține intrării și moare odată cu ea.
function Hub:bind(button, callback)
	Theme.enabled(button, true)
	return button.Activated:Connect(function()
		if not self.destroyed and button:GetAttribute("EnabledAction") then callback() end
	end)
end

-- 1. Antet: avatar 28, numele contului, punctul stării hub, versiunea și butonul „Panou” (DESIGN.md §10.1 rândul 1).
function Hub:buildHeader(order)
	local root = Theme.new("Frame", { Name = "Header", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44),
		LayoutOrder = order }, self.scroll)
	local identity = Theme.new("Frame", { Name = "Identity", BackgroundTransparency = 1,
		Size = UDim2.new(1, -HEADER_ACTIONS, 0, 28), ClipsDescendants = true }, root)
	Theme.list(identity, Theme.SPACE.sm, true)
	self.avatarHolder = Theme.new("Frame", { Name = "Avatar", BackgroundTransparency = 1, Size = UDim2.fromOffset(28, 28),
		LayoutOrder = 1 }, identity)
	self.name = inlineLabel(identity, { size = "md", font = "ui", height = 28, truncate = true, name = "Name" }, 112)
	self.name.LayoutOrder = 2
	self.hubDot = Theme.dot(identity, "neutral", 10)
	self.hubDot.LayoutOrder = 3
	-- Eticheta scurtă a stării hub-ului stă sub nume, nu lângă el: la 320 px un rând nu ține și numele, și starea.
	self.hubState = Theme.label(root, "", { size = "xs", token = "text2", height = 14, truncate = true, name = "HubState" })
	self.hubState.Position = UDim2.fromOffset(HEADER_INDENT, 30)
	self.hubState.Size = UDim2.new(1, -(HEADER_INDENT + HEADER_ACTIONS), 0, 14)
	local actions = Theme.new("Frame", { Name = "Actions", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 0, 0, 28), AutomaticSize = Enum.AutomaticSize.X }, root)
	Theme.list(actions, Theme.SPACE.sm, true)
	local version = inlineLabel(actions, { size = "xs", token = "text2", height = 28, name = "Version" }, 64)
	version.Text, version.LayoutOrder = "v" .. APP_VERSION, 1
	self.panel = Theme.button(actions, "Panou", { kind = "ghost", size = "sm", width = "auto", name = "Panel" })
	self.panel.LayoutOrder = 2
	Theme.click(self, self.panel, function() self.controller:openPanel() end)
end

-- 3. Workspace: jocul deschis (sau cel privit), prezenții, lista celorlalte workspace-uri și vizualizarea read-only (§10.1 rândul 3, §10.3).
function Hub:buildWorkspace(order)
	local root = block(self.scroll, "Workspace", order)
	self.back = Theme.button(root, "Înapoi", { kind = "ghost", size = "sm", width = "auto", name = "Back" })
	self.back.LayoutOrder = 1
	Theme.click(self, self.back, function() self.controller:viewWorkspace(nil) end)
	local title = Theme.new("Frame", { Name = "Title", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22),
		LayoutOrder = 2 }, root)
	self.workspaceName = Theme.label(title, "", { size = "lg", font = "ui", height = 22, truncate = true, name = "Name" })
	self.readOnly = Theme.chip(title, "doar de citit", "neutral")
	self.readOnly.AnchorPoint, self.readOnly.Position = Vector2.new(1, 0.5), UDim2.new(1, 0, 0.5, 0)
	self.placeLine = Theme.label(root, "", { size = "xs", font = "mono", token = "text2", height = 16, truncate = true, name = "Place" })
	self.placeLine.LayoutOrder = 3
	self.presence = Theme.avatarRow(root, {}, { size = 24, name = "Presence" })
	self.presence.root.LayoutOrder = 4
	self.workspaceNote = Theme.empty(root, "", { name = "WorkspaceNote" })
	self.workspaceNote.root.LayoutOrder = 5
	self.workspaces = Theme.section(root, "Alte workspace-uri", { collapsible = true, open = false, name = "Workspaces" })
	self.workspaces.root.LayoutOrder = 6
	self.workspacesEmpty = Theme.empty(self.workspaces.body, EMPTY_WORKSPACES, { name = "NoWorkspaces" })
	self.workspacesEmpty.root.LayoutOrder = 1000
	Theme.click(self, self.workspaces.header, function()
		self.workspaces.setOpen(not self.workspaces.open)
		if self.workspaces.open then self.controller:refreshWorkspaces() end
	end)
	self.viewTabs = Theme.tab(root, { { key = "members", text = "Prezenți" }, { key = "sessions", text = "Sesiuni" } },
		self.viewTab, function(key)
			self.viewTab = key
			self:update()
		end)
	self.viewTabs.root.LayoutOrder = 7
	self.viewMembers = block(root, "ViewMembers", 8, Theme.SPACE.xs)
	self.viewMembersEmpty = Theme.empty(self.viewMembers, EMPTY_MEMBERS, { name = "NoMembers" })
	self.viewMembersEmpty.root.LayoutOrder = 1000
	self.viewSessions = block(root, "ViewSessions", 9)
	self.viewSessionsEmpty = Theme.empty(self.viewSessions, "", { name = "NoSessions" })
	self.viewSessionsEmpty.root.LayoutOrder = 1000
	self.viewError = Theme.label(root, "", { size = "sm", token = "text2", name = "ViewError" })
	self.viewError.LayoutOrder = 10
end

-- 4. Acțiunea principală: providerul sesiunilor noi, butonul primar și disponibilitatea CLI-urilor (§10.1 rândul 4).
function Hub:buildAction(order)
	local root = block(self.scroll, "Action", order)
	self.provider = Theme.segmented(root, { { key = "claude", text = Theme.names.claude }, { key = "codex", text = Theme.names.codex } },
		self.store.defaultProvider, function(key)
			self.store.defaultProvider = key
			self.store:emit(nil)
		end)
	self.provider.root.LayoutOrder = 1
	self.create = Theme.button(root, "Sesiune nouă", { kind = "primary", size = "lg", name = "NewSession" })
	self.create.LayoutOrder = 2
	Theme.click(self, self.create, function() self.controller:createWindow() end)
	local availability = block(root, "Availability", 3, Theme.SPACE.xs)
	self.cli = {}
	for index, provider in ipairs({ "claude", "codex" }) do
		local line = Theme.new("Frame", { Name = "Cli_" .. provider, BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 16), LayoutOrder = index }, availability)
		Theme.list(line, Theme.SPACE.xs, true)
		local dot = Theme.dot(line, "neutral", 8)
		dot.LayoutOrder = 1
		local label = inlineLabel(line, { size = "xs", token = "text2", height = 16, truncate = true, name = "Text" }, 240)
		label.LayoutOrder = 2
		self.cli[provider] = { dot = dot, label = label, role = "neutral" }
	end
	self.createHint = Theme.label(root, "", { size = "xs", token = "text2", name = "Reason" })
	self.createHint.LayoutOrder = 4
	-- Cine aprobă operațiile agentului. Un singur buton care ciclează prin cele trei moduri, ca să încapă la 320 px.
	self.autoApprove = Theme.button(root, "", { kind = "ghost", size = "sm", name = "AutoApprove" })
	self.autoApprove.LayoutOrder = 5
	Theme.click(self, self.autoApprove, function()
		local next = { ask = "edits", edits = "all", all = "ask" }
		self.controller:setAutoApprove(next[self.store.autoApprove] or "edits")
	end)
end

-- Textul butonului de aprobare: spune ce se întâmplă acum, nu numele setării.
function Hub.approvalLabel(mode)
	if mode == "all" then return "Aprobare: automată, inclusiv generarea (consumă credite)" end
	if mode == "edits" then return "Aprobare: automată pentru modificări, generarea se cere" end
	return "Aprobare: cer de fiecare dată"
end

-- 5. Sesiuni: „Ale tale” (ferestrele acestui dispozitiv) și „În workspace” (sesiunile colegilor, doar de citit).
function Hub:buildSessions(order)
	local root = block(self.scroll, "Sessions", order, Theme.SPACE.md)
	self.sessions = Theme.section(root, "Sesiuni", { name = "Mine" })
	self.sessions.root.LayoutOrder = 1
	self.sessions.subtitle("Ale tale")
	self.mineEmpty = Theme.empty(self.sessions.body, EMPTY_MINE, { name = "NoSessions" })
	self.mineEmpty.root.LayoutOrder = 1000
	self.others = Theme.section(root, "", { name = "Others" })
	self.others.root.LayoutOrder = 2
	self.others.header.Visible = false
	self.others.subtitle("În workspace")
	self.othersEmpty = Theme.empty(self.others.body, "", { name = "NoOthers" })
	self.othersEmpty.root.LayoutOrder = 1000
end

-- 6. Aprobare: un card per fereastră proprie care așteaptă o decizie (§10.1 rândul 6).
function Hub:buildApprovals(order)
	self.approvals = Theme.section(self.scroll, "Aprobare", { name = "Approvals" })
	self.approvals.root.LayoutOrder = order
end

-- 7. Claims: zonele revendicate din workspace-ul curent, cu „Eliberează” pe ale tale.
function Hub:buildClaims(order)
	self.claims = Theme.section(self.scroll, "Claims", { name = "Claims" })
	self.claims.root.LayoutOrder = order
	self.claimsEmpty = Theme.empty(self.claims.body, EMPTY_CLAIMS, { name = "NoClaims" })
	self.claimsEmpty.root.LayoutOrder = 1000
end

-- 8. Jurnal: ultimele modificări înregistrate în workspace.
function Hub:buildJournal(order)
	self.journal = Theme.section(self.scroll, "Jurnal", { name = "Journal" })
	self.journal.root.LayoutOrder = order
	self.journalEmpty = Theme.empty(self.journal.body, EMPTY_JOURNAL, { name = "NoJournal" })
	self.journalEmpty.root.LayoutOrder = 1000
end

-- 9. Subsol: linia daemon-ului și secțiunea pliabilă „Avansat” (cod de asociere, Studio țintă, deconectare) — §10.4.
function Hub:buildFooter(order)
	local root = block(self.scroll, "Footer", order, Theme.SPACE.md)
	local separator = Theme.new("Frame", { Name = "Separator", Size = UDim2.new(1, 0, 0, 1), BorderSizePixel = 0,
		LayoutOrder = 1 }, root)
	Theme.paint(separator, { BackgroundColor3 = "borderStrong" })
	self.daemonLine = Theme.label(root, "", { size = "xs", token = "text2", name = "Daemon" })
	self.daemonLine.LayoutOrder = 2
	self.daemonToken = "text2"
	self.advanced = Theme.section(root, "Avansat", { collapsible = true, open = false, name = "Advanced" })
	self.advanced.root.LayoutOrder = 3
	Theme.click(self, self.advanced.header, function() self.advanced.setOpen(not self.advanced.open) end)
	local body = self.advanced.body
	self.codeField = block(body, "Code", 1, Theme.SPACE.xs)
	Theme.label(self.codeField, "Cod de asociere", { size = "xs", token = "text2", height = 16, name = "Label" }).LayoutOrder = 1
	self.codeInput = Theme.input(self.codeField, { placeholder = CODE_PLACEHOLDER, mono = true, name = "Code" })
	self.codeInput.LayoutOrder = 2
	self.codeHint = Theme.label(self.codeField, CODE_HINT, { size = "xs", token = "text2", name = "Hint" })
	self.codeHint.LayoutOrder, self.codeHintText = 3, CODE_HINT
	Theme.connect(self, self.codeInput.FocusLost, function(enterPressed)
		if not enterPressed then return end
		local code = self.codeInput.Text
		if code == "" then return end
		self.codeInput.Text = ""
		self.controller:connect(code, "manual")
	end)
	local studioField = block(body, "Studio", 2, Theme.SPACE.xs)
	Theme.label(studioField, "Studio țintă", { size = "xs", token = "text2", height = 16, name = "Label" }).LayoutOrder = 1
	self.studioButton = Theme.button(studioField, "", { name = "TargetStudio" })
	self.studioButton.LayoutOrder = 2
	Theme.click(self, self.studioButton, function() self:cycleStudio() end)
	local deviceField = block(body, "Device", 3, Theme.SPACE.xs)
	Theme.label(deviceField, "Dispozitiv", { size = "xs", token = "text2", height = 16, name = "Label" }).LayoutOrder = 1
	self.deviceBox = Theme.input(deviceField, { mono = true, name = "DeviceId" })
	self.deviceBox.LayoutOrder, self.deviceBox.TextEditable = 2, false
	self.disconnect = Theme.button(body, "Deconectează daemon-ul", { kind = "danger", name = "Disconnect" })
	self.disconnect.LayoutOrder = 4
	Theme.click(self, self.disconnect, function()
		self.confirming = true
		self:update()
	end)
	self.reconnect = Theme.button(body, "Conectează daemon-ul", { name = "Reconnect" })
	self.reconnect.LayoutOrder = 5
	Theme.click(self, self.reconnect, function() self.controller:connect("") end)
	self.confirm = Theme.banner(body, { role = "danger", name = "DisconnectConfirm" })
	self.confirm.root.LayoutOrder = 6
	local choices = Theme.new("Frame", { Name = "Choices", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28),
		LayoutOrder = 2 }, self.confirm.label.Parent)
	Theme.list(choices, Theme.SPACE.sm, true)
	local confirmButton = Theme.button(choices, "Deconectează", { kind = "danger", size = "sm",
		width = UDim.new(0.5, -Theme.SPACE.xs), name = "Confirm" })
	confirmButton.LayoutOrder = 1
	Theme.click(self, confirmButton, function()
		self.confirming = false
		self.controller:stop()
		self:update()
	end)
	local backButton = Theme.button(choices, "Înapoi", { size = "sm", width = UDim.new(0.5, -Theme.SPACE.xs), name = "Cancel" })
	backButton.LayoutOrder = 2
	Theme.click(self, backButton, function()
		self.confirming = false
		self:update()
	end)
end

-- Ciclează suprascrierea Studio-ului țintă: automat → prima instanță → … → automat.
function Hub:cycleStudio()
	local store = self.store
	if #store.studios == 0 then return end
	local index = 0
	for position, studio in ipairs(store.studios) do
		if studio.id == store.defaultStudioId then index = position end
	end
	local nextIndex = index + 1
	self.controller:setDefaultStudio(if nextIndex &gt; #store.studios then nil else store.studios[nextIndex].id)
end

function Hub:update()
	if self.destroyed then return end
	self:updateHeader()
	self:updateBanner()
	self:updateWorkspace()
	self:updateAction()
	self:updateSessions()
	self:updateApprovals()
	self:updateClaims()
	self:updateJournal()
	self:updateFooter()
end

function Hub:updateHeader()
	local store = self.store
	local identity = store.identity
	local key = if identity then tostring(identity.userId) .. "|" .. tostring(identity.avatar or "") else "-"
	if key ~= self.avatarKey then
		self.avatarKey = key
		if self.avatar then self.avatar:Destroy() end
		self.avatar = Theme.avatar(self.avatarHolder, identity, { size = 28 })
	end
	self.name.Text = if identity then Theme.fit(identity.name, 16) else store.UNKNOWN_NAME
	local status = if store.connected then store.hub.status else nil
	local role = if status then (Theme.HUB_ROLE[status] or "neutral") else "neutral"
	if role ~= self.hubDotRole then
		self.hubDotRole = role
		Theme.recolor(self.hubDot, role)
	end
	-- Eticheta scurtă a stării apare doar când hub-ul nu este conectat (în Studio nu există tooltip-uri, §14.3).
	local label = if status and status ~= "approved" then (Theme.hubStates[status] or "") else ""
	self.hubState.Text = label
	self.hubState.Visible = label ~= ""
	Theme.enabled(self.panel, store.connected and not store.connecting and store.compatible and status ~= nil and status ~= "disabled")
end

-- Un singur banner pe ecran: starea hub-ului are prioritate, apoi eșecul metamorfozei, apoi actualizările (DESIGN.md §7.9, §12.2).
function Hub:updateBanner()
	local store = self.store
	local role, text, seconds = nil, nil, nil
	local status = store.hub.status
	if store.connected and (status == "pending" or status == "offline" or status == "revoked") then
		text, role = store:hubStatusText()
	elseif store.bundleError then
		role, text = "danger", "Interfața nouă nu a pornit: " .. store.bundleError .. ". Rulează versiunea anterioară."
	else
		local update = store.update
		if update.state == "installed" then
			role, seconds = "primary", 5
			text = "Actualizare aplicată: " .. (if update.current ~= "" then update.current else "versiune nouă")
				.. ". Interfața s-a reîncărcat fără repornire."
		-- Actualizarea doar disponibilă rămâne în subsol (§6.2): nu cere nimic de la utilizator, deci nu merită un banner.
		elseif update.restartRequired then
			role, text = "info", "Loader nou instalat. Repornește Studio o dată, când ai timp."
		end
	end
	local key = if text then role .. "|" .. text else ""
	if key == self.bannerKey then return end
	self.bannerKey = key
	if text == nil or key == self.dismissedBanner then
		self.banner.hide()
		return
	end
	-- Bannerele de stare persistente nu se închid: dispar când starea se schimbă. Excepție: eșecul metamorfozei, care nu se mai
	-- schimbă singur (rulăm versiunea anterioară până la un bundle nou), deci primește „×”.
	self.banner.close.Visible = role == "info" or seconds ~= nil or store.bundleError ~= nil
	self.banner.show(role, text, seconds)
end

function Hub:updateWorkspace()
	local store, controller = self.store, self.controller
	local viewing = store.viewWorkspace ~= nil
	local workspace = store:viewedWorkspace()
	self.back.Visible = viewing
	if viewing then
		self.back.Text = "Înapoi la " .. Theme.fit(store.workspaceName(store.workspace), 20)
	end
	self.workspaceName.Text = store:workspaceLabel()
	self.readOnly.Visible = viewing
	self.workspaceName.Size = UDim2.new(1, if viewing then -88 else 0, 1, 0)
	self.placeLine.Text = Theme.placeLine(workspace, store.identity)
	local members = store:membersInView()
	self.presence.set(members)
	self.presence.root.Visible = #members &gt; 0
	local note = nil
	if not store.connected then note = DAEMON_DOWN
	elseif not viewing and (workspace == nil or workspace.key == store.LOCAL_WORKSPACE) then note = UNPUBLISHED end
	self.workspaceNote.root.Visible = note ~= nil
	if note then self.workspaceNote.label.Text = note end
	-- Nota UNPUBLISHED începe cu aceeași propoziție ca linia mono: o afișăm o singură dată (§1.4 — fără repetiții).
	self.placeLine.Visible = note ~= UNPUBLISHED
	self:updateWorkspaceList()
	local failure = if viewing then controller:viewError() else nil
	self.viewTabs.root.Visible = viewing
	if self.viewTab ~= self.viewTabShown then
		self.viewTabShown = self.viewTab
		self.viewTabs.set(self.viewTab)
	end
	self.viewError.Visible = failure ~= nil
	self.viewError.Text = failure or ""
	self.viewMembers.Visible = viewing and failure == nil and self.viewTab == "members"
	self.viewSessions.Visible = viewing and failure == nil and self.viewTab == "sessions"
	self:updateMemberRows(if self.viewMembers.Visible then members else {})
	local sessions = if self.viewSessions.Visible then store:sessionsInView() else {}
	local models = {}
	for _, row in ipairs(sessions) do table.insert(models, sessionRowModel(row)) end
	self:syncCards(self.viewSessions, self.viewCards, models, false)
	self.viewSessionsEmpty.root.Visible = self.viewSessions.Visible and #models == 0
	self.viewSessionsEmpty.label.Text = "Nicio sesiune activă în " .. Theme.fit(store:workspaceLabel(), 24) .. "."
	self.viewMembersEmpty.root.Visible = self.viewMembers.Visible and #members == 0
end

function Hub:updateWorkspaceList()
	local store = self.store
	local rows = store.workspaces
	-- Butonul apare doar când există și altceva de privit; contorul numără efectiv celelalte workspace-uri: imediat după
	-- deschiderea unui loc nou (sau pentru un fișier nepublicat) cel curent încă nu apare în sumarul hub-ului.
	local current = store:workspaceKey()
	local others = 0
	for _, workspace in ipairs(rows) do
		if workspace.key ~= current then others += 1 end
	end
	self.workspaces.root.Visible = others &gt; 0 or self.workspaces.open
	self.workspaces.setCount(if others &gt; 0 then others else nil)
	local listed = self.workspaces.open and others &gt; 0
	self.workspacesEmpty.root.Visible = self.workspaces.open and not listed
	if not listed then
		for key, entry in pairs(self.workspaceRows) do
			entry.connection:Disconnect()
			entry.row.root:Destroy()
			self.workspaceRows[key] = nil
		end
		return
	end
	local seen = {}
	for order, workspace in ipairs(rows) do
		local key = workspace.key
		seen[key] = true
		local entry = self.workspaceRows[key]
		if not entry then
			local row = Theme.row(self.workspaces.body, { name = "Workspace", lines = 2, lead = "dot",
				role = "neutral", clickable = true })
			entry = { row = row, role = "neutral" }
			entry.connection = self:bind(row.button, function()
				self.controller:viewWorkspace(if key == store:workspaceKey() then nil else key)
			end)
			self.workspaceRows[key] = entry
		end
		entry.row.root.LayoutOrder = order
		local role = if workspace.membersOnline &gt; 0 then "primary" else "neutral"
		if role ~= entry.role then
			entry.role = role
			Theme.recolor(entry.row.lead, role)
		end
		local meta = Theme.countLabel(workspace.membersOnline, "prezent", "prezenți")
			.. " · " .. Theme.countLabel(workspace.sessionsActive, "sesiune", "sesiuni")
		if workspace.claims &gt; 0 then meta ..= " · " .. Theme.countLabel(workspace.claims, "claim", "claims") end
		entry.row.set(Theme.fit(workspace.name, 40) .. (if key == current then " · curent" else ""), meta)
	end
	for key, entry in pairs(self.workspaceRows) do
		if not seen[key] then
			entry.connection:Disconnect()
			entry.row.root:Destroy()
			self.workspaceRows[key] = nil
		end
	end
end

function Hub:updateMemberRows(members)
	local seen = {}
	for order, member in ipairs(members) do
		-- Contul intră în cheie: avatarul rândului se construiește o singură dată, deci alt cont pe același PC cere alt rând.
		local key = member.deviceId .. "|" .. tostring(member.userId)
		seen[key] = true
		local entry = self.memberRows[key]
		if not entry then
			entry = { row = Theme.row(self.viewMembers, { name = "Member", lead = "avatar", identity = member }) }
			self.memberRows[key] = entry
		end
		entry.row.root.LayoutOrder = order
		entry.row.set(Theme.fit(member.name, 24) .. (if member.me then " · tu" else ""),
			if member.online then "Online" else "Offline")
	end
	for key, entry in pairs(self.memberRows) do
		if not seen[key] then
			entry.row.root:Destroy()
			self.memberRows[key] = nil
		end
	end
end

function Hub:updateAction()
	local store = self.store
	if store.defaultProvider ~= self.providerShown then
		self.providerShown = store.defaultProvider
		self.provider.set(store.defaultProvider)
	end
	for _, provider in ipairs({ "claude", "codex" }) do
		local entry = self.cli[provider]
		local found = store.connected and store:providerAvailable(provider)
		local role = if found then "primary" else "neutral"
		if role ~= entry.role then
			entry.role = role
			Theme.recolor(entry.dot, role)
		end
		entry.label.Text = Theme.names[provider] .. " · " .. (if found then "CLI găsit" else "CLI negăsit")
	end
	local reason = self:createReason()
	Theme.enabled(self.create, reason == nil)
	self.createHint.Visible = reason ~= nil
	self.createHint.Text = reason or ""
	self.autoApprove.Text = Hub.approvalLabel(self.store.autoApprove)
	Theme.enabled(self.autoApprove, self.store.connected and self.store.compatible and not self.store.connecting)
end

-- Motivul pentru care „Sesiune nouă” este dezactivat; nil înseamnă că poate fi apăsat.
function Hub:createReason()
	local store = self.store
	if not store.connected then return DAEMON_DOWN end
	if store.connecting then return "Se conectează la daemon…" end
	if not store.compatible then return OLD_DAEMON end
	if #store.order &gt;= MAX_WINDOWS then
		return "Limita este de " .. MAX_WINDOWS .. " de ferestre. Închide o sesiune inactivă înainte de a crea alta."
	end
	if not store:providerAvailable(store.defaultProvider) then
		return "CLI-ul oficial " .. (Theme.names[store.defaultProvider] or store.defaultProvider) .. " nu a fost găsit de daemon."
	end
	return nil
end

-- Un card de sesiune: titlu + timp, apoi chip-urile, proprietarul și eticheta stării (DESIGN.md §7.1).
function Hub:newCard(parent, clickable)
	local card = Theme.card(parent, { name = "Session", clickable = clickable })
	local head = Theme.new("Frame", { Name = "Head", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = 1 }, card.body)
	local title = Theme.label(head, "", { size = "md", font = "ui", height = 18, truncate = true, name = "Title" })
	title.Size = UDim2.new(1, -68, 1, 0)
	local time = Theme.label(head, "", { size = "xs", token = "text2", height = 18, truncate = true, align = "right", name = "Time" })
	time.AnchorPoint, time.Position, time.Size = Vector2.new(1, 0), UDim2.new(1, 0, 0, 0), UDim2.fromOffset(64, 18)
	local meta = wrapRow(card.body, "Meta", 2)
	local entry = { card = card, title = title, time = time, firstSeen = os.time(), role = "neutral" }
	entry.providerChip = Theme.chip(meta, "", "neutral")
	entry.providerChip.LayoutOrder = 1
	entry.kindChip = Theme.chip(meta, "", "neutral")
	entry.kindChip.LayoutOrder = 2
	entry.approvalChip = Theme.chip(meta, "", "warning")
	entry.approvalChip.LayoutOrder, entry.approvalChip.Visible = 3, false
	entry.minimizedChip = Theme.chip(meta, "Minimizată", "neutral")
	entry.minimizedChip.LayoutOrder, entry.minimizedChip.Visible = 4, false
	local owner = Theme.new("Frame", { Name = "Owner", BackgroundTransparency = 1, Size = UDim2.new(0, 0, 0, 20),
		AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = 5 }, meta)
	Theme.list(owner, Theme.SPACE.xs, true)
	entry.ownerHolder = Theme.new("Frame", { Name = "Avatar", BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 16),
		LayoutOrder = 1 }, owner)
	entry.ownerLabel = inlineLabel(owner, { size = "xs", token = "text2", height = 20, truncate = true, name = "Who" }, 240)
	entry.ownerLabel.LayoutOrder = 2
	if clickable then
		entry.connection = self:bind(card.root, function()
			if entry.id then self.store:restore(entry.id) end
		end)
	end
	return entry
end

function Hub:fillCard(entry, model)
	entry.id = model.id
	if model.role ~= entry.role then
		entry.role = model.role
		entry.card.setRole(model.role)
	end
	if entry.title.Text ~= model.title then entry.title.Text = model.title end
	local elapsed = Theme.elapsed(model.since or entry.firstSeen)
	if entry.time.Text ~= elapsed then entry.time.Text = elapsed end
	local providerName = Theme.names[model.provider] or model.provider
	if entry.providerChip.Text ~= providerName then
		entry.providerChip.Text = providerName
		Theme.recolor(entry.providerChip, model.provider)
	end
	entry.kindChip.Text = Theme.kinds[model.kind] or Theme.kinds.studio
	entry.approvalChip.Visible = model.approvals &gt; 0
	if model.approvals &gt; 0 then entry.approvalChip.Text = Theme.countLabel(model.approvals, "aprobare", "aprobări") end
	entry.minimizedChip.Visible = model.minimized
	local owner = model.owner
	local avatarKey = if owner then tostring(owner.userId) .. "|" .. tostring(owner.name) else "-"
	if avatarKey ~= entry.avatarKey then
		entry.avatarKey = avatarKey
		if entry.avatar then entry.avatar:Destroy() end
		entry.avatar = Theme.avatar(entry.ownerHolder, owner, { size = 16 })
	end
	local who = model.who .. " · " .. model.state
	if entry.ownerLabel.Text ~= who then entry.ownerLabel.Text = who end
end

function Hub:syncCards(parent, cache, models, clickable)
	local seen = {}
	for order, model in ipairs(models) do
		seen[model.key] = true
		local entry = cache[model.key]
		if not entry then
			entry = self:newCard(parent, clickable)
			cache[model.key] = entry
		end
		entry.card.root.LayoutOrder = order
		self:fillCard(entry, model)
	end
	for key, entry in pairs(cache) do
		if not seen[key] then
			if entry.connection then entry.connection:Disconnect() end
			entry.card.root:Destroy()
			cache[key] = nil
		end
	end
end

function Hub:updateSessions()
	local store = self.store
	local mine, others = store:sessionsMine(), store:sessionsOthers()
	self.sessions.setCount(#mine + #others)
	local mineModels, otherModels = {}, {}
	for _, window in ipairs(mine) do table.insert(mineModels, windowModel(window)) end
	for _, window in ipairs(others) do table.insert(otherModels, windowModel(window)) end
	self:syncCards(self.sessions.body, self.mineCards, mineModels, true)
	self:syncCards(self.others.body, self.othersCards, otherModels, true)
	self.mineEmpty.root.Visible = #mineModels == 0
	self.othersEmpty.root.Visible = #otherModels == 0
	self.othersEmpty.label.Text = "Nimeni altcineva nu lucrează acum în "
		.. Theme.fit(store.workspaceName(store.workspace), 24) .. "."
end

function Hub:updateApprovals()
	local store = self.store
	local pending = {}
	for _, window in ipairs(store:sessionsMine()) do
		local approval = window.approvals[1]
		if approval and not approval.inactive then table.insert(pending, { window = window, approval = approval }) end
	end
	self.approvals.root.Visible = #pending &gt; 0
	self.approvals.setCount(if #pending &gt; 0 then #pending else nil)
	local seen = {}
	for order, item in ipairs(pending) do
		local window, approval = item.window, item.approval
		local key = window.id .. "|" .. approval.id
		seen[key] = true
		local entry = self.approvalCards[key]
		if not entry then
			entry = self:newApprovalCard(window.id, approval.id)
			self.approvalCards[key] = entry
		end
		entry.card.root.LayoutOrder = order
		entry.tool.Text = Theme.fit(tostring(approval.tool or "Instrument necunoscut"), 40)
		entry.arguments.Text = argumentSummary(approval.arguments)
		entry.session.Text = Theme.fit(window.name, 40) .. " · " .. (Theme.names[window.provider] or window.provider)
		local decided = window.decisionId ~= nil
		local canDecide = store.connected and not store.connecting and not window.remote and not window.cancelling and not decided
		Theme.enabled(entry.allow, canDecide and approval.inspectable == true and not approval.blocked)
		Theme.enabled(entry.refuse, canDecide)
		local hint = if approval.blocked then APPROVAL_BLOCKED elseif approval.inspectable ~= true then APPROVAL_HINT else ""
		entry.hint.Text = hint
		entry.hint.Visible = hint ~= ""
	end
	for key, entry in pairs(self.approvalCards) do
		if not seen[key] then
			for _, connection in ipairs(entry.connections) do connection:Disconnect() end
			entry.card.root:Destroy()
			self.approvalCards[key] = nil
		end
	end
end

function Hub:newApprovalCard(windowId, approvalId)
	local card = Theme.card(self.approvals.body, { name = "Approval", role = "warning" })
	local tool = Theme.label(card.body, "", { size = "md", font = "mono", height = 18, truncate = true, name = "Tool" })
	tool.LayoutOrder = 1
	local arguments = Theme.label(card.body, "", { size = "xs", font = "mono", token = "text2", name = "Arguments" })
	arguments.LayoutOrder = 2
	local session = Theme.label(card.body, "", { size = "xs", token = "text2", height = 16, truncate = true, name = "Session" })
	session.LayoutOrder = 3
	local choices = Theme.new("Frame", { Name = "Choices", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32),
		LayoutOrder = 4 }, card.body)
	Theme.list(choices, Theme.SPACE.sm, true)
	local allow = Theme.button(choices, "Permite", { kind = "primary", width = UDim.new(0.6, -Theme.SPACE.xs), name = "Allow" })
	allow.LayoutOrder = 1
	local refuse = Theme.button(choices, "Refuză", { width = UDim.new(0.4, -Theme.SPACE.xs), name = "Refuse" })
	refuse.LayoutOrder = 2
	-- `text2`, nu `text3`: tokenul al treilea are sub 4,5:1 pe toate suprafețele (DESIGN.md §2.5), deci nu poate purta text.
	local hint = Theme.label(card.body, "", { size = "xs", token = "text2", name = "Hint" })
	hint.LayoutOrder = 5
	local entry = { card = card, tool = tool, arguments = arguments, session = session, allow = allow, refuse = refuse, hint = hint }
	entry.connections = {
		self:bind(allow, function() self.controller:decide(windowId, approvalId, true) end),
		self:bind(refuse, function() self.controller:decide(windowId, approvalId, false) end),
	}
	return entry
end

function Hub:updateClaims()
	local store = self.store
	self.claims.setCount(if #store.claims &gt; 0 then #store.claims else nil)
	self.claimsEmpty.root.Visible = #store.claims == 0
	local seen = {}
	for order, claim in ipairs(store.claims) do
		local own = store:ownsClaim(claim)
		local key = claim.jobId .. "|" .. claim.path .. "|" .. tostring(own)
		seen[key] = true
		local entry = self.claimRows[key]
		if not entry then
			entry = { row = Theme.row(self.claims.body, { name = "Claim", mono = true, lines = 2,
				action = if own then { text = "Eliberează", kind = "ghost" } else nil }) }
			if entry.row.action then
				local jobId, path = claim.jobId, claim.path
				entry.connection = self:bind(entry.row.action, function()
					self.controller:releaseClaims(jobId, { path })
				end)
			end
			self.claimRows[key] = entry
		end
		entry.row.root.LayoutOrder = order
		local holder = if own then "tu" else Theme.fit(claim.developer, 16)
		local meta = holder .. " · " .. Theme.elapsed(claim.since)
		if claim.reason then meta ..= " · " .. Theme.fit(claim.reason, 40) end
		entry.row.set(shortPath(claim.path), meta)
		if entry.row.action then
			local owner = store:findJob(claim.jobId)
			Theme.enabled(entry.row.action, store.connected and not store.connecting and not (owner and owner.releasing))
		end
	end
	for key, entry in pairs(self.claimRows) do
		if not seen[key] then
			if entry.connection then entry.connection:Disconnect() end
			entry.row.root:Destroy()
			self.claimRows[key] = nil
		end
	end
end

function Hub:updateJournal()
	local store = self.store
	local identity = store.identity
	local myId = if identity then identity.userId else 0
	self.journalEmpty.root.Visible = #store.journal == 0
	local seen = {}
	for order, item in ipairs(store.journal) do
		local key = tostring(item.seq or "") .. "|" .. tostring(item.time or "") .. "|" .. item.tool .. "|" .. tostring(item.jobId or "")
		seen[key] = true
		local entry = self.journalRows[key]
		if not entry then
			local row = Theme.row(self.journal.body, { name = "Entry", lines = 2 })
			row.secondary.Font = Theme.font("mono")
			entry = { row = row }
			self.journalRows[key] = entry
		end
		entry.row.root.LayoutOrder = order
		local who = if myId &gt; 0 and item.userId == myId then "tu" else Theme.fit(item.developer, 16)
		entry.row.set(Theme.clock(item.time) .. "  " .. who .. " · " .. Theme.fit(item.tool, 24), journalPaths(item.paths))
	end
	for key, entry in pairs(self.journalRows) do
		if not seen[key] then
			entry.row.root:Destroy()
			self.journalRows[key] = nil
		end
	end
end

function Hub:updateFooter()
	local store = self.store
	local text = store.status
	if store.connected and not store.connecting and not store.statusError then
		local update = store.update
		if update.state == "downloading" then text ..= " · actualizare în curs"
		elseif update.state == "available" and update.available then
			text ..= " · actualizare " .. update.available .. " disponibilă (se instalează când nu rulează sesiuni)"
		elseif update.state == "error" and update.message ~= "" then text ..= " · actualizare: " .. update.message
		else text ..= " · la zi" end
	end
	self.daemonLine.Text = Theme.fit(text, 240)
	local token = if store.statusError then "dangerText" else "text2"
	if token ~= self.daemonToken then
		self.daemonToken = token
		Theme.paint(self.daemonLine, { TextColor3 = token })
	end
	local needsToken = self.controller:needsToken()
	self.codeField.Visible = needsToken
	if needsToken then
		local hint = (CODE_REFUSED[self.controller:tokenSource()] or "") .. CODE_HINT
		if hint ~= self.codeHintText then self.codeHintText, self.codeHint.Text = hint, hint end
	end
	local studio = store:studio(store.defaultStudioId)
	if #store.studios == 0 then self.studioButton.Text = "Niciun Studio conectat"
	elseif studio then self.studioButton.Text = "Studio țintă: " .. Theme.fit(studio.name, 18)
	elseif #store.studios == 1 then self.studioButton.Text = "Automat: " .. Theme.fit(store.studios[1].name, 24)
	else self.studioButton.Text = "Automat · " .. Theme.countLabel(#store.studios, "instanță", "instanțe") end
	Theme.enabled(self.studioButton, store.connected and #store.studios &gt; 0)
	-- Id-ul complet al dispozitivului, de copiat; nu se rescrie cât timp utilizatorul îl are selectat (§7.12).
	if not self.deviceBox:IsFocused() then self.deviceBox.Text = store.hub.deviceId or "—" end
	if not store.connected then self.confirming = false end
	self.disconnect.Visible = store.connected and not self.confirming
	-- Doar oprirea manuală suspendă reconectarea automată (DESIGN.md §10.4): la o cădere temporară subsolul spune deja
	-- „nu răspunde (reîncerc în N s)”, deci un buton de conectare ar fi o acțiune inutilă care contrazice mesajul.
	self.reconnect.Visible = not store.connected and self.controller:manualStopped()
	if self.confirming ~= self.confirmShown then
		self.confirmShown = self.confirming
		if self.confirming then self.confirm.show("danger", DISCONNECT_CONFIRM) else self.confirm.hide() end
	end
end

function Hub:destroy()
	Theme.cleanup(self)
	for _, cache in ipairs({ self.mineCards, self.othersCards, self.viewCards, self.approvalCards, self.claimRows,
		self.journalRows, self.workspaceRows, self.memberRows }) do
		for _, entry in pairs(cache) do
			if entry.connection then entry.connection:Disconnect() end
			for _, connection in ipairs(entry.connections or {}) do connection:Disconnect() end
		end
		table.clear(cache)
	end
	-- Panoul NU se distruge: `CreateDockWidgetPluginGuiAsync` întoarce, pentru același id, un panou distrus și inutilizabil
	-- tot restul sesiunii Studio. Studio descarcă pluginul la fiecare Play, deci un `Destroy()` aici însemna că după primul
	-- playtest interfața nu mai apărea deloc. Golim conținutul și lăsăm panoul următoarei instanțe.
	if self.root then pcall(function() self.root:Destroy() end) end
	self.root = nil
end

return Hub
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX7">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">-- Studio Harness App 1.0.0. Aplicația pluginului (Store, Controller, temă, ferestre): exclusiv UI nativ, citește DataModel-ul pentru inventar, nu modifică scena.
-- Loader-ul o pornește cu `Main.start(plugin, handoff?, toolbar?, button?)`, îi cere `app:snapshot()` și o oprește cu `app:destroy()` la metamorfoză.
local Store = require(script.Parent.SessionStore)
local Controller = require(script.Parent.BridgeController)
local Theme = require(script.Parent.Theme)
local HubView = require(script.Parent.HubView)
local SessionView = require(script.Parent.SessionView)
local Main = { VERSION = "1.0.0" }
local App = {}
App.__index = App

function App:ensure(id)
	local store = self.store
	if not self.alive or not store.windows[id] or self.views[id] or self.constructing[id] or self.failedViews[id] then return end
	self.constructing[id] = true
	local ok, view = pcall(SessionView.new, self.plugin, store, self.controller, id)
	self.constructing[id] = nil
	if ok then
		if self.alive and store.windows[id] then self.views[id] = view else view:destroy(true) end
	else
		self.failedViews[id] = true
		self.controller:status("Fereastra nativă nu a putut fi creată: " .. tostring(view), true)
	end
end

function App:prune()
	for id, view in pairs(self.views) do
		if not self.store.windows[id] then view:destroy(true); self.views[id] = nil; self.failedViews[id] = nil end
	end
end

function App:sync(id)
	if not self.alive then return end
	local store = self.store
	if id then
		if store.windows[id] then self:ensure(id) else self:prune() end
	else
		-- Tabla poate crea sau elimina ferestre din terminal fără un id anume.
		self:prune()
		for _, windowId in ipairs(store.order) do self:ensure(windowId) end
	end
	if not self.alive then return end
	if id then
		if self.views[id] then self.views[id]:update() end
	else
		for _, view in pairs(self.views) do view:update() end
	end
	self.hub:update()
end

-- Handoff-ul pentru bundle-ul următor: store-ul serializat (fără cod local), starea legăturii și vizibilitatea hub-ului.
function App:snapshot()
	local hubVisible = self.hub ~= nil and self.hub.widget.Enabled == true
	return { version = Main.VERSION, store = self.store:serialize(), controller = self.controller:snapshot(), hubVisible = hubVisible }
end

-- Idempotent: este chemat de loader la metamorfoză și de `plugin.Unloading`; toolbar-ul primit rămâne al loader-ului.
function App:destroy()
	if not self.alive then return end
	self.alive = false
	if self.unsubscribe then self.unsubscribe() end
	self.controller:destroy()
	-- `Theme.cleanup` marchează owner-ul ca distrus și deconectează tot ce a intrat prin `Theme.connect` (inclusiv `ThemeChanged`).
	Theme.cleanup(self)
	-- Oprirea aplicației nu este închiderea ferestrelor: panourile rămân, ca instanța următoare să le poată refolosi.
	for _, view in pairs(self.views) do pcall(view.destroy, view, false) end
	table.clear(self.views)
	if self.hub then pcall(self.hub.destroy, self.hub) end
	if self.ownsToolbar then pcall(function() self.toolbar:Destroy() end) end
end

-- Handoff-ul loader-ului 1.1.0 este `{ controller = { token, source } }`; cel de la metamorfoză adaugă `store` și `hubVisible`.
function Main.start(pluginObject, handoff, toolbar, button)
	handoff = if type(handoff) == "table" then handoff else nil
	local store = Store.deserialize(if handoff then handoff.store else nil)
	-- Loader-ul pune aici motivul pentru care bundle-ul nou nu a pornit; rulăm versiunea anterioară și o spunem în banner (§12.2).
	if handoff and type(handoff.bundleError) == "string" and handoff.bundleError ~= "" then
		store.bundleError = string.sub(handoff.bundleError, 1, 200)
	end
	local controller = Controller.new(pluginObject, store, if handoff then handoff.controller else nil)
	local self = setmetatable({ plugin = pluginObject, store = store, controller = controller, alive = true, destroyed = false,
		toolbar = toolbar, button = button, ownsToolbar = false, views = {}, constructing = {}, failedViews = {}, connections = {} }, App)
	local ok, failure = pcall(function()
		-- Tema Studio se citește o singură dată, înaintea oricărui view; la `ThemeChanged` paleta se repictează și view-urile se recalculează.
		Theme.install(self, function() self:sync(nil) end)
		if not self.toolbar then self.toolbar, self.ownsToolbar = pluginObject:CreateToolbar("Studio Harness"), true end
		if not self.button then
			self.button = self.toolbar:CreateButton("StudioHarnessMatrixToggle", "Deschide hubul sesiunilor", "", "Hub")
			self.button.ClickableWhenViewportHidden = true
		end
		self.hub = HubView.new(pluginObject, store, controller)
		if handoff and type(handoff.hubVisible) == "boolean" then self.hub.widget.Enabled = handoff.hubVisible end
		self.unsubscribe = store:subscribe(function(id) self:sync(id) end)
		Theme.connect(self, self.button.Click, function()
			self.hub.widget.Enabled = not self.hub.widget.Enabled
		end)
		Theme.connect(self, self.hub.widget:GetPropertyChangedSignal("Enabled"), function()
			self.button:SetActive(self.hub.widget.Enabled)
		end)
		Theme.connect(self, pluginObject.Unloading, function() self:destroy() end)
		self.button:SetActive(self.hub.widget.Enabled)
		self:sync(nil)
	end)
	if not ok then self:destroy(); error(failure, 0) end
	return self
end

return Main
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX8">
        <Properties>
          <string name="Name">ProjectScanner</string>
          <ProtectedString name="Source">-- Inventarul DataModel-ului pentru harta proiectului (faza 4) și identitatea locului deschis (1.0).
-- Pur: fără servicii Roblox, în afară de `game` pentru rădăcinile implicite și pentru `Scanner.place()`.
local Scanner = {}
Scanner.ROOTS = { "Workspace", "ReplicatedStorage", "ReplicatedFirst", "ServerScriptService", "ServerStorage", "StarterGui", "StarterPack",
	"StarterPlayer", "Lighting", "SoundService", "MaterialService", "Teams", "TextChatService", "Chat" }
Scanner.MAX_NODES = 20000
Scanner.MAX_NAME = 200
Scanner.MAX_PLACE_NAME = 200
Scanner.MAX_USER_NAME = 64
Scanner.CHUNK_BYTES = 700 * 1024 - 2048 -- rezervă pentru antetul cererii (snapshot_id, place_name, creator, studio_id…)
Scanner.FLAG_SOURCE, Scanner.FLAG_ATTRIBUTES, Scanner.FLAG_CLIENT, Scanner.FLAG_SERVER = 1, 2, 4, 8
-- `creator_type` acceptat de daemon (contract §4.4): User, Group sau nil (necunoscut).
Scanner.CREATOR_TYPES = { User = "User", Group = "Group" }

local function clip(text, limit)
	if #text &lt;= limit then return text end
	local stop = limit
	while stop &gt; 0 do
		local byte = string.byte(text, stop + 1)
		if not byte or byte &lt; 128 or byte &gt;= 192 then break end
		stop -= 1
	end
	return string.sub(text, 1, stop)
end

-- Întreg ≥ 0 pentru id-urile Roblox; orice altceva (nil, text, NaN, negativ) devine 0.
local function identifier(value)
	local number = tonumber(value)
	if number == nil or number ~= number or math.abs(number) == math.huge or number &lt; 0 then return 0 end
	return math.floor(number)
end

-- Identitatea locului deschis (contract §2.2, §4.4, §8.5): `game.PlaceId`, `game.GameId`, `game.Name`, `game.CreatorId`, `game.CreatorType`.
-- `dataModel` este `game` în Studio sau un tabel echivalent în teste; proprietățile ilizibile sau lipsă devin 0 / "" / nil.
function Scanner.place(dataModel)
	dataModel = dataModel or game
	local function read(property)
		local ok, value = pcall(function() return dataModel[property] end)
		return if ok then value else nil
	end
	-- `CreatorType` este un EnumItem în Studio (`.Name`), un text în teste; altceva înseamnă creator necunoscut.
	local creatorType = read("CreatorType")
	local okName, enumName = pcall(function() return creatorType.Name end)
	local resolved = if okName and type(enumName) == "string" then enumName else creatorType
	local name = read("Name")
	return { place_id = identifier(read("PlaceId")), game_id = identifier(read("GameId")),
		place_name = clip(if type(name) == "string" then name else "", Scanner.MAX_PLACE_NAME),
		creator_id = identifier(read("CreatorId")), creator_type = Scanner.CREATOR_TYPES[resolved] }
end

-- Corpul `POST /v1/identity` (contract §4.4): contul Roblox plus locul deschis; `userId` 0 = cont necunoscut (numele rămâne gol).
function Scanner.identityPayload(place, userId, userName)
	place = place or Scanner.place()
	local id = identifier(userId)
	local name = if id &gt; 0 and type(userName) == "string" then clip(userName, Scanner.MAX_USER_NAME) else ""
	return { user_id = id, name = name, place_id = place.place_id, game_id = place.game_id, place_name = place.place_name,
		creator_id = place.creator_id, creator_type = place.creator_type }
end

-- Corpul unui chunk pentru `POST /v1/project/chunks` (contract §8.5): `project = { id, chunks, index (1-based), truncated }`, indexul trimis este 0-based.
function Scanner.chunkPayload(project, place, studioId)
	place = place or Scanner.place()
	return { snapshot_id = project.id, index = project.index - 1, total = #project.chunks,
		place_id = place.place_id, game_id = place.game_id, place_name = place.place_name, creator_id = place.creator_id, creator_type = place.creator_type,
		studio_id = studioId, truncated = project.truncated == true, nodes = project.chunks[project.index] }
end

function Scanner.defaultRoots()
	local roots = {}
	for _, name in ipairs(Scanner.ROOTS) do
		-- FindFirstChildOfClass nu creează serviciul lipsă (GetService ar modifica DataModel-ul).
		local ok, service = pcall(function() return game:FindFirstChildOfClass(name) end)
		if ok and service then table.insert(roots, service) end
	end
	return roots
end

function Scanner.flags(instance)
	local flags = 0
	local okSource, source = pcall(function() return instance:IsA("LuaSourceContainer") end)
	if okSource and source == true then flags += Scanner.FLAG_SOURCE end
	local okAttributes, attributes = pcall(function() return next(instance:GetAttributes()) ~= nil end)
	if okAttributes and attributes == true then flags += Scanner.FLAG_ATTRIBUTES end
	-- EnumItem.Name (Enum.RunContext.Client/Server) evită referința la globalul Enum, absent în afara Studio.
	local okContext, context = pcall(function() return instance.RunContext.Name end)
	if okContext then
		if context == "Client" then flags += Scanner.FLAG_CLIENT elseif context == "Server" then flags += Scanner.FLAG_SERVER end
	end
	return flags
end

-- Parcurgere în preordine: părintele primește întotdeauna un id mai mic decât copiii; instanțele ilizibile sunt sărite cu tot subarborele.
function Scanner.scan(roots)
	roots = roots or Scanner.defaultRoots()
	local nodes, hash, truncated = {}, 0, false
	local stackInstances, stackParents = {}, {}
	for index = #roots, 1, -1 do
		table.insert(stackInstances, roots[index]); table.insert(stackParents, -1)
	end
	while #stackInstances &gt; 0 do
		local instance, parent = table.remove(stackInstances), table.remove(stackParents)
		local ok, name, className = pcall(function() return instance.Name, instance.ClassName end)
		if ok and type(name) == "string" and type(className) == "string" and className ~= "" then
			if #nodes &gt;= Scanner.MAX_NODES then truncated = true; break end
			local id = #nodes
			table.insert(nodes, { id, parent, clip(className, Scanner.MAX_NAME), clip(name, Scanner.MAX_NAME), Scanner.flags(instance) })
			-- Sumă simplă a numelor (lungime, primul și ultimul octet) și a claselor, sensibilă la ordine.
			hash = (hash * 31 + #name * 131 + (string.byte(name) or 0) * 7 + (string.byte(name, -1) or 0) + #className) % 2147483647
			local okChildren, children = pcall(function() return instance:GetChildren() end)
			if okChildren and type(children) == "table" then
				for childIndex = #children, 1, -1 do
					table.insert(stackInstances, children[childIndex]); table.insert(stackParents, id)
				end
			end
		end
	end
	return { nodes = nodes, truncated = truncated, count = #nodes, digest = #nodes .. ":" .. hash }
end

local function textBytes(text)
	local _, escapes = string.gsub(text, '[%c"\\]', "")
	local _, high = string.gsub(text, "[\128-\255]", "")
	-- Estimare acoperitoare: caracterele escapate ca \uXXXX și octeții non-ASCII codificați de HttpService.
	return 2 + #text + 5 * escapes + 2 * high
end

function Scanner.nodeBytes(node)
	return 7 + #tostring(node[1]) + #tostring(node[2]) + #tostring(node[5]) + textBytes(node[3]) + textBytes(node[4])
end

-- Împarte nodurile în chunk-uri al căror JSON rămâne sub maxBytes; `encode` (opțional) confirmă cu codificatorul real.
function Scanner.chunks(nodes, maxBytes, encode)
	maxBytes = maxBytes or Scanner.CHUNK_BYTES
	local pending, current, size = {}, {}, 2
	for _, node in ipairs(nodes) do
		local bytes = Scanner.nodeBytes(node)
		if #current &gt; 0 and size + bytes &gt; maxBytes then
			table.insert(pending, current); current, size = {}, 2
		end
		table.insert(current, node); size += bytes
	end
	table.insert(pending, current)
	if type(encode) ~= "function" then return pending end
	-- Un chunk care depășește limita la codificarea reală se înjumătățește; ordinea nodurilor rămâne.
	local result, index = {}, 1
	while index &lt;= #pending do
		local chunk = pending[index]
		local ok, text = pcall(encode, chunk)
		if ok and type(text) == "string" and #text &gt; maxBytes and #chunk &gt; 1 then
			local half = math.ceil(#chunk / 2)
			pending[index] = table.move(chunk, 1, half, 1, {})
			table.insert(pending, index + 1, table.move(chunk, half + 1, #chunk, 1, {}))
		else
			table.insert(result, chunk); index += 1
		end
	end
	return result
end

return Scanner
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX9">
        <Properties>
          <string name="Name">SessionStore</string>
          <ProtectedString name="Source">-- Model pur: fără servicii Roblox, HTTP sau modificări ale scenei. Oglindește `/v1/status` și `/v1/board` ale daemon-ului 1.0:
-- identitatea Roblox, workspace-ul (jocul deschis), starea hub-ului, prezenții, sesiunile proprii și ale colegilor, claims-urile și jurnalul.
local Store = {}
Store.__index = Store
Store.MAX_WINDOWS = 32
Store.MAX_MESSAGES = 120
Store.MAX_TEXT = 120000
Store.MAX_JOURNAL = 10
Store.MAX_CLAIMS = 128
Store.MAX_MEMBERS = 64
Store.MAX_WORKSPACES = 64
Store.MAX_VIEW_SESSIONS = 64
Store.PROVIDERS = { claude = "Claude Code", codex = "Codex" }
Store.TERMINAL = { completed = true, failed = true, cancelled = true, lost = true }
Store.REQUIRED_FEATURES = { "queued_sessions", "batch_events", "terminal_sessions", "claims", "board", "identity", "workspaces", "panel" }
Store.CLAIM_ACTIONS = { claimed = "Claim", released = "Eliberat", denied = "Claim refuzat", expired = "Claim expirat" }
Store.UPDATE_STATES = { idle = true, available = true, downloading = true, installed = true, error = true }
Store.PROJECT_STATES = { idle = true, sending = true, sent = true, error = true }
Store.STATES = { draft = true, sending = true, uncertain = true, queued = true, running = true, waiting_approval = true, completed = true, failed = true, cancelled = true, lost = true }
-- Stările hub-ului raportate de daemon (contract §4.1) și rolul de culoare al fiecăreia (DESIGN.md §6.2).
Store.HUB_STATES = { connecting = true, pending = true, approved = true, offline = true, revoked = true, disabled = true }
Store.HUB_ROLES = { connecting = "neutral", pending = "warning", approved = "primary", offline = "danger", revoked = "danger", disabled = "neutral" }
Store.CREATOR_TYPES = { User = true, Group = true }
Store.UNKNOWN_NAME = "Studio"
Store.UNKNOWN_WORKSPACE = "Workspace necunoscut"
Store.LOCAL_WORKSPACE = "local"
Store.OLD_HUB_ERROR = "Hub-ul rulează o versiune mai veche."
Store.HANDOFF_VERSION = 1

function Store.prefix(text, limit)
	text = tostring(text or "")
	if #text &lt;= limit then return text end
	local stop = limit
	while stop &gt; 0 do
		local byte = string.byte(text, stop + 1)
		if not byte or byte &lt; 128 or byte &gt;= 192 then break end
		stop -= 1
	end
	return string.sub(text, 1, stop)
end

local function copy(value)
	if type(value) ~= "table" then return value end
	local result = {}
	for key, child in pairs(value) do result[key] = copy(child) end
	return result
end

local function list(value)
	return if type(value) == "table" then value else {}
end

local function integer(value, minimum)
	local number = tonumber(value)
	if number == nil or number ~= number or math.abs(number) == math.huge then return nil end
	number = math.floor(number)
	return if number &gt;= (minimum or 0) then number else nil
end

local function stringList(value, limit)
	local result = {}
	for _, item in ipairs(list(value)) do
		if type(item) == "string" and item ~= "" and #result &lt; (limit or 64) then table.insert(result, Store.prefix(item, 200)) end
	end
	return result
end

local function optionalText(value, limit)
	return if type(value) == "string" and value ~= "" then Store.prefix(value, limit) else nil
end

-- Text pe o singură linie (caracterele de control devin spații), pentru mesajele afișate în bannere și rânduri.
local function cleanText(value, limit)
	if type(value) ~= "string" then return nil end
	local cleaned = string.match((string.gsub(value, "%c", " ")), "^%s*(.-)%s*$") or ""
	return optionalText(cleaned, limit)
end

function Store.isCompatible(data)
	local features = if type(data) == "table" and type(data.features) == "table" then data.features else {}
	for _, name in ipairs(Store.REQUIRED_FEATURES) do
		if features[name] ~= true then return false end
	end
	return type(data.bridge_id) == "string" and data.bridge_id ~= ""
end

function Store.terminalWindowId(jobId)
	return "terminal:" .. tostring(jobId)
end

-- Avatarul se derivă din contul Roblox (contract §1.5); fără cont cunoscut nu există avatar.
function Store.avatarUrl(userId)
	local id = integer(userId, 1)
	if not id then return nil end
	return "rbxthumb://type=AvatarHeadShot&amp;id=" .. id .. "&amp;w=48&amp;h=48"
end

-- Starea hub-ului până la primul `/v1/status` al daemon-ului: se conectează, fără url, fără dispozitiv.
function Store.defaultHub()
	return { status = "connecting", url = nil, hubId = nil, deviceId = nil, error = nil, panelUrl = nil, enrollment = nil, lastSync = nil }
end

-- Starea actualizării automate raportată de daemon (0.6+); fără daemon sau cu unul vechi rămâne implicită.
function Store.defaultUpdate()
	return { current = "", available = nil, state = "idle", message = "", restartRequired = false }
end

-- Inventarul proiectului trimis daemon-ului (0.7+): starea locală a ultimului snapshot.
function Store.defaultProject()
	return { snapshotId = nil, count = 0, truncated = false, sentAt = nil, state = "idle", message = "" }
end

-- `identity` din `/v1/status` (contract §4.3): `user_id` 0 = cont necunoscut (numele „Studio”, fără avatar); avatarul lipsă se derivă din id.
function Store.identityFrom(data)
	if type(data) ~= "table" then return nil end
	local userId = integer(data.user_id) or 0
	if userId == 0 then return { userId = 0, name = Store.UNKNOWN_NAME, avatar = nil } end
	return { userId = userId, name = cleanText(data.name, 64) or ("user_" .. userId), avatar = optionalText(data.avatar, 300) or Store.avatarUrl(userId) }
end

-- Meta unui workspace (contract §2.2): `{key, game_id, place_id, name, creator_id, creator_type}` → câmpuri camelCase; numele lipsă devine cheia.
function Store.workspaceFrom(meta)
	if type(meta) ~= "table" then return nil end
	local key = optionalText(meta.key, 64)
	if not key then return nil end
	return { key = key, name = cleanText(meta.name, 200) or key, placeId = integer(meta.place_id) or 0, gameId = integer(meta.game_id) or 0,
		creatorId = integer(meta.creator_id) or 0, creatorType = if Store.CREATOR_TYPES[meta.creator_type] then meta.creator_type else nil }
end

-- `hub` din `/v1/status`/`/v1/board` (contract §4.3); `panel_url` vine doar din status, altfel se derivă din url (nil când hub-ul e dezactivat).
function Store.hubFrom(data, panelUrl)
	local hub = Store.defaultHub()
	if type(data) ~= "table" then return hub end
	hub.status = if Store.HUB_STATES[data.status] then data.status else "connecting"
	hub.url = optionalText(data.url, 300)
	hub.hubId = optionalText(data.hub_id, 64)
	hub.deviceId = optionalText(data.device_id, 64)
	hub.error = cleanText(data.error, 200)
	hub.enrollment = optionalText(data.enrollment, 16)
	hub.lastSync = tonumber(data.last_sync)
	hub.panelUrl = optionalText(panelUrl, 300) or (if hub.url and hub.status ~= "disabled" then hub.url .. "/panel" else nil)
	return hub
end

-- Un rând de prezență (`members` din status/board sau `/hub/workspace`): fără cont Roblox, numele afișat este mașina (contract §1.5).
function Store.memberFrom(row, myDeviceId)
	if type(row) ~= "table" then return nil end
	local deviceId = optionalText(row.device_id, 64) or optionalText(row.member_id, 64)
	if not deviceId then return nil end
	local userId = integer(row.roblox_user_id) or 0
	local machine = cleanText(row.machine, 64)
	local name = cleanText(row.roblox_name, 64) or cleanText(row.developer, 64) or machine or Store.UNKNOWN_NAME
	return { deviceId = deviceId, userId = userId, name = name, machine = machine or "?", lastSeen = tonumber(row.last_seen),
		me = row.me == true or deviceId == myDeviceId, online = row.online ~= false }
end

-- Un rând din sumarul workspace-urilor: `members_online` este număr (daemon) sau listă (hub); câmpurile de meta sunt opționale.
function Store.workspaceRowFrom(row)
	if type(row) ~= "table" then return nil end
	local key = optionalText(row.key, 64)
	if not key then return nil end
	local online = row.members_online
	return { key = key, name = cleanText(row.name, 200) or key,
		membersOnline = if type(online) == "table" then #online else integer(online) or 0,
		sessionsActive = integer(row.sessions_active) or 0, claims = integer(row.claims) or 0, mine = row.mine == true,
		placeId = integer(row.place_id), gameId = integer(row.game_id), creatorId = integer(row.creator_id),
		creatorType = if Store.CREATOR_TYPES[row.creator_type] then row.creator_type else nil, lastSeen = tonumber(row.last_seen) }
end

-- Proprietarul unei sesiuni din tablă (`developer`, `device_id`, `roblox_user_id`, `machine`); `member_id` este forma 0.8 a dispozitivului.
function Store.ownerFrom(session)
	if type(session) ~= "table" then return nil end
	local name = cleanText(session.developer, 60)
	local deviceId = optionalText(session.device_id, 64) or optionalText(session.member_id, 64)
	local machine = cleanText(session.machine, 64)
	local userId = integer(session.roblox_user_id) or 0
	if not name and not deviceId and not machine and userId == 0 then return nil end
	return { userId = userId, name = name or machine or Store.UNKNOWN_NAME, deviceId = deviceId, machine = machine }
end

local function sessionName(session)
	local name = if type(session.name) == "string" and string.find(session.name, "%S") then session.name else "Terminal"
	return Store.prefix((string.gsub(name, "%c", " ")), 80)
end

-- O sesiune a altui workspace (vizualizare read-only din `/v1/hub/workspace?key=`): doar meta, fără fereastră și fără evenimente.
function Store.sessionRowFrom(row, myDeviceId)
	if type(row) ~= "table" or type(row.job_id) ~= "string" or row.job_id == "" then return nil end
	local owner = Store.ownerFrom(row)
	return { jobId = row.job_id, kind = if row.kind == "studio" then "studio" else "terminal",
		provider = if Store.PROVIDERS[row.provider] then row.provider else "claude", name = sessionName(row),
		state = if type(row.state) == "string" and Store.STATES[row.state] then row.state else "running",
		owner = owner, workspace = optionalText(row.workspace, 64), started = tonumber(row.started), lastActivity = tonumber(row.last_activity),
		claims = stringList(row.claims), pendingApproval = row.pending_approval == true,
		mine = row.mine == true or (owner ~= nil and owner.deviceId ~= nil and owner.deviceId == myDeviceId) }
end

-- O intrare de jurnal (hub sau locală): `seq` și `workspace` lipsesc la intrările locale ale unui daemon fără hub.
function Store.journalFrom(entry)
	return { seq = integer(entry.seq), time = tonumber(entry.time), jobId = optionalText(entry.job_id, 128), tool = Store.prefix(entry.tool, 60),
		developer = if type(entry.developer) == "string" then Store.prefix(entry.developer, 60) else "?",
		userId = integer(entry.roblox_user_id) or 0, provider = if Store.PROVIDERS[entry.provider] then entry.provider else nil,
		paths = stringList(entry.paths, 8), summary = if type(entry.summary) == "string" then Store.prefix(entry.summary, 160) else "",
		workspace = optionalText(entry.workspace, 64) }
end

-- Sumarul inventarului reținut de daemon (`project` din `/v1/status`), diferit de starea locală a scanării (`store.project`).
function Store.daemonProjectFrom(project)
	if type(project) ~= "table" then return nil end
	return { snapshotId = optionalText(project.snapshot_id, 128), count = integer(project.count) or 0, taken = tonumber(project.taken),
		placeName = cleanText(project.place_name, 200) }
end

-- Numele afișat al unui workspace: numele jocului; fișierul nepublicat fără nume devine „Fișier nepublicat”; fără workspace, „Workspace necunoscut”.
function Store.workspaceName(workspace)
	if type(workspace) ~= "table" then return Store.UNKNOWN_WORKSPACE end
	local key = optionalText(workspace.key, 64)
	local name = cleanText(workspace.name, 200)
	if key == Store.LOCAL_WORKSPACE and (name == nil or name == key) then return "Fișier nepublicat" end
	return name or key or Store.UNKNOWN_WORKSPACE
end

-- Textul complet al unei stări hub (DESIGN.md §6.2 și §12.2) și rolul de culoare.
function Store.hubText(hub)
	hub = if type(hub) == "table" then hub else Store.defaultHub()
	local status = hub.status
	if status == "approved" then return "Hub conectat", "primary"
	elseif status == "pending" then
		return "Așteaptă aprobarea adminului · dispozitiv " .. (if hub.deviceId then string.sub(hub.deviceId, 1, 8) else "—"), "warning"
	elseif status == "offline" then
		local reason = hub.error or "hub-ul nu răspunde"
		if string.sub(reason, 1, #Store.OLD_HUB_ERROR) == Store.OLD_HUB_ERROR then
			return "Hub-ul rulează o versiune mai veche. Actualizează hub-ul ca să apari în workspace.", "danger"
		end
		reason = string.gsub(Store.prefix(reason, 80), "[%.%s]+$", "")
		return "Hub offline: " .. reason .. ". Sesiunile tale merg local; claims-urile sunt doar locale până revine.", "danger"
	elseif status == "revoked" then return "Accesul acestui dispozitiv a fost revocat. Cere adminului să-l aprobe din nou.", "danger"
	elseif status == "disabled" then return "Hub dezactivat (daemon pornit cu --no-hub).", "neutral"
	end
	return "Se conectează la hub…", "neutral"
end

function Store.new()
	return setmetatable({
		windows = {}, order = {}, listeners = {},
		connected = false, connecting = false, compatible = false, bridgeId = nil,
		providers = {}, studios = {}, defaultStudioId = nil, defaultProvider = "claude",
		developer = nil, machine = nil, identity = nil, workspace = nil, hub = Store.defaultHub(),
		members = {}, workspaces = {}, viewWorkspace = nil, view = nil, pluginConnected = false, daemonProject = nil,
		-- „ask” (implicit) | „edits” (orice modificare, fără generare) | „all” (inclusiv generarea, care consumă credite).
		autoApprove = "ask",
		claims = {}, journal = {}, dismissedTerminal = {},
		update = Store.defaultUpdate(), project = Store.defaultProject(), bundleError = nil,
		status = "Daemon deconectat. Poți deschide ferestre draft.", statusError = false,
	}, Store)
end

function Store:subscribe(callback)
	table.insert(self.listeners, callback)
	return function()
		local index = table.find(self.listeners, callback)
		if index then table.remove(self.listeners, index) end
	end
end

function Store:emit(id)
	for _, listener in ipairs(self.listeners) do listener(id) end
end

function Store:message(window, author, text, kind)
	local clipped = #tostring(text or "") &gt; Store.MAX_TEXT
	local message = {
		author = author, text = Store.prefix(text, Store.MAX_TEXT), kind = kind or "text",
		clipped = clipped,
	}
	if clipped then message.text ..= "\n[Afișare locală limitată.]" end
	table.insert(window.messages, message)
	while #window.messages &gt; Store.MAX_MESSAGES do table.remove(window.messages, 1) end
	return message
end

local function newWindow(id, kind, provider, name)
	return {
		id = id, kind = kind, name = name, provider = provider, developer = nil,
		remote = false, mine = true, machine = nil, owner = nil, workspace = nil, sessionKind = kind, started = nil,
		studioId = nil, studioName = nil, cwd = nil, cursor = 0,
		sessionId = nil, job = nil, request = nil, locked = false, terminalJobId = nil,
		draft = "", draftRevision = 0, messages = {}, approvals = {}, visible = true,
		state = "draft", cancelling = false, decisionId = nil, releasing = false,
		closeConfirm = false, closeAfterCancel = false, restoreVersion = 0, claims = {}, pendingApproval = false,
	}
end

-- Cheia workspace-ului curent (jocul deschis), cunoscută după primul `/v1/identity` acceptat de daemon.
function Store:workspaceKey()
	return if self.workspace then self.workspace.key else nil
end

-- Proprietarul ferestrelor proprii: contul Roblox raportat (sau mașina) și dispozitivul acestui PC; nil până se știe ceva.
function Store:ownIdentity()
	local identity = self.identity
	if not identity and not self.hub.deviceId and not self.machine then return nil end
	return { userId = if identity then identity.userId else 0, name = if identity then identity.name else (self.machine or Store.UNKNOWN_NAME),
		deviceId = self.hub.deviceId, machine = self.machine }
end

function Store:create(id, provider, studio, name)
	if self.windows[id] or #self.order &gt;= Store.MAX_WINDOWS or not Store.PROVIDERS[provider] then return nil end
	local window = newWindow(id, "studio", provider, name or ("Sesiune " .. (#self.order + 1)))
	window.studioId, window.studioName = studio and studio.id or nil, studio and studio.name or nil
	window.owner, window.workspace = self:ownIdentity(), self:workspaceKey()
	-- Momentul real al deschiderii ferestrei: supraviețuiește hot swap-ului prin handoff, deci „de X min” nu se resetează la metamorfoză.
	window.started = os.time()
	self.windows[id] = window
	table.insert(self.order, id)
	self:message(window, "Sesiune nouă", "Context separat pentru această fereastră. Scrie un mesaj; nimic nu se trimite înainte de Trimite.")
	self:emit(id)
	return window
end

function Store:setDraft(id, text)
	local window = self.windows[id]
	if window and window.kind == "studio" and window.draft ~= text then
		window.draft = text
		window.draftRevision += 1
	end
end

function Store:rename(id, name)
	local window = self.windows[id]
	if not window or window.kind ~= "studio" then return end
	name = Store.prefix((string.gsub(name, "%c", " ")), 80)
	if string.find(name, "%S") then window.name = name end
	self:emit(id)
end

function Store:setVisible(id, visible)
	local window = self.windows[id]
	if window and window.visible ~= visible then window.visible = visible; self:emit(id) end
end

function Store:restore(id)
	local window = self.windows[id]
	if window then
		window.visible = true
		window.restoreVersion += 1
		self:emit(id)
	end
end

function Store:bindStudio(id, studio)
	local window = self.windows[id]
	if not window or window.kind ~= "studio" or window.locked or window.job or window.request or not studio then return false end
	window.studioId, window.studioName = studio.id, studio.name
	self:emit(id)
	return true
end

function Store:studio(id)
	for _, studio in ipairs(self.studios) do if studio.id == id then return studio end end
	return nil
end

function Store:applyStudios(studios)
	self.studios = {}
	local seen = {}
	for _, studio in ipairs(list(studios)) do
		if type(studio) == "table" and type(studio.id) == "string" and studio.id ~= "" and not seen[studio.id] then
			seen[studio.id] = true
			table.insert(self.studios, { id = studio.id, name = tostring(studio.name or "Studio") })
		end
	end
	if not self:studio(self.defaultStudioId) then self.defaultStudioId = nil end
	if #self.studios == 1 then self.defaultStudioId = self.studios[1].id end
end

function Store:setStudios(studios)
	self:applyStudios(studios)
	self:emit(nil)
end

function Store:setDefaultStudio(studioId)
	if studioId ~= nil and not self:studio(studioId) then return false end
	self.defaultStudioId = studioId
	self:emit(nil)
	return true
end

function Store:providerAvailable(provider)
	local entry = self.providers[provider]
	return type(entry) == "table" and entry.available == true
end

-- La deconectarea daemon-ului: hub-ul, prezenții și sumarul workspace-urilor nu mai sunt cunoscute; identitatea și jocul deschis rămân.
function Store:resetHub()
	self.hub, self.members, self.workspaces, self.viewWorkspace, self.view = Store.defaultHub(), {}, {}, nil, nil
	self.daemonProject, self.pluginConnected = nil, false
end

function Store:remoteChanged(bridgeId)
	if type(bridgeId) ~= "string" or bridgeId == "" or self.bridgeId == bridgeId then return false end
	local previous = self.bridgeId
	self.bridgeId = bridgeId
	if previous then
		for index = #self.order, 1, -1 do
			local window = self.windows[self.order[index]]
			if window.kind == "terminal" then
				self.windows[window.id] = nil
				table.remove(self.order, index)
			else
				if window.request and window.request.message then window.request.message.author = "Tu · neconfirmat înainte de restart" end
				window.sessionId, window.job, window.request = nil, nil, nil
				window.approvals, window.claims = {}, {}
				window.cancelling, window.decisionId, window.closeAfterCancel = false, nil, false
				window.state = "draft"
				self:message(window, "Daemon repornit", "Referințele remote vechi au fost invalidate. Istoricul și draftul local sunt păstrate. Nimic nu este retrimis automat; următoarea trimitere începe o conversație remote nouă.", "notice")
			end
		end
		self.studios, self.defaultStudioId = {}, nil
		self.claims, self.journal, self.dismissedTerminal = {}, {}, {}
		self:resetHub()
		self.update, self.project = Store.defaultUpdate(), Store.defaultProject()
	end
	self:emit(nil)
	return previous ~= nil
end

function Store:canSend(window)
	if not window then return false, "Sesiunea nu există." end
	if window.kind ~= "studio" then return false, "Sesiune din terminal: doar de citit." end
	if not self.connected or self.connecting then return false, "Daemon-ul nu răspunde. Mesajul rămâne ca draft." end
	if not self.compatible then return false, "Pornește daemon-ul 1.0 sau mai nou (terminal cu pluginul Claude Code sau Start-Daemon.cmd)." end
	if window.job or window.request or window.cancelling then return false, "Cererea acestei ferestre nu s-a încheiat." end
	if #window.approvals &gt; 0 then return false, "Rezolvă aprobarea acestei ferestre." end
	if not self:providerAvailable(window.provider) then
		return false, "CLI-ul oficial " .. (Store.PROVIDERS[window.provider] or window.provider) .. " nu a fost găsit de daemon."
	end
	if window.studioId == nil then return false, "Alege Studio-ul țintă în Avansat sau deschide locul din identitate." end
	if not self:studio(window.studioId) then return false, "Studio-ul țintă nu mai este conectat; verifică MCP în Studio sau alege altul în Avansat." end
	return true
end

function Store:beginRequest(id, requestId, context)
	local window = self.windows[id]
	local allowed, message = self:canSend(window)
	if not allowed then return nil, message end
	local prompt = string.match(window.draft, "^%s*(.-)%s*$") or ""
	if prompt == "" or #prompt &gt; 24000 then return nil, "Mesajul trebuie să conțină text și să fie de cel mult 24 KB." end
	local payload = {
		provider = window.provider, prompt = prompt, studio_id = window.studioId,
		client_request_id = requestId, context = copy(context),
	}
	if window.sessionId then payload.session_id = window.sessionId end
	window.request = { id = requestId, payload = payload, bridgeId = self.bridgeId,
		draftRevision = window.draftRevision, state = "sending",
		message = self:message(window, "Tu · trimitere", prompt, "user") }
	window.locked = true
	window.state = "sending"
	self:emit(id)
	return window.request
end

function Store:requestFailed(id, requestId, message, uncertain)
	local window = self.windows[id]
	if not window or not window.request or window.request.id ~= requestId then return end
	if window.request.message then window.request.message.author = if uncertain then "Tu · neconfirmat" else "Tu · respins" end
	if uncertain then window.request.state = "uncertain"; window.state = "uncertain"
	else
		-- Respingere definitivă: nu există job, deci ținta se poate schimba dacă nu există conversație.
		window.request, window.state, window.closeAfterCancel = nil, "failed", false
		if not window.sessionId then window.locked = false end
	end
	self:message(window, "Trimitere neconfirmată", message .. (if uncertain then "\nNu retrimit automat. Poți confirma explicit reluarea aceleiași cereri, cu același ID." else "\nNimic nu este retrimis automat."), "error")
	self:emit(id)
end

function Store:acceptRequest(id, requestId, data)
	local window = self.windows[id]
	if not window or not window.request or window.request.id ~= requestId then return false end
	if type(data.job_id) ~= "string" or data.job_id == "" or type(data.session_id) ~= "string" then return false end
	local owner = self:findJob(data.job_id)
	if owner and owner ~= window then return false end
	local request = window.request
	window.sessionId = data.session_id
	window.job = { id = data.job_id, after = 0, state = data.state or "queued", message = nil }
	window.state = window.job.state
	-- Daemon-ul 1.0 întoarce workspace-ul jobului (contract §4.2); lipsa lui păstrează cheia de la creare.
	window.workspace = optionalText(data.workspace, 64) or window.workspace
	if request.message and table.find(window.messages, request.message) then request.message.author = "Tu"
	else self:message(window, "Tu", request.payload.prompt, "user") end
	if window.draftRevision == request.draftRevision then window.draft = ""; window.draftRevision += 1 end
	window.request = nil
	self:emit(id)
	return true
end

function Store:findJob(jobId)
	for _, window in pairs(self.windows) do
		if window.job and window.job.id == jobId then return window end
	end
	return nil
end

function Store:jobs()
	local jobs = {}
	for _, id in ipairs(self.order) do
		local window = self.windows[id]
		if window.job then table.insert(jobs, { job_id = window.job.id, after = window.job.after }) end
	end
	return jobs
end

function Store:jobIdOf(window)
	if not window then return nil end
	return if window.job then window.job.id else window.terminalJobId
end

function Store:removeApproval(id, jobId, approvalId)
	local window = self.windows[id]
	if not window then return end
	for index = #window.approvals, 1, -1 do
		local approval = window.approvals[index]
		if approval.jobId == jobId and approval.id == approvalId then table.remove(window.approvals, index) end
	end
	if window.decisionId == approvalId and window.job and window.job.id == jobId then window.decisionId = nil end
end

-- ApprovalView confirmă că argumentele au putut fi afișate integral; HubView activează „Permite” doar atunci (regula 0.8: nu aprobi ce nu ai citit).
function Store:setApprovalInspectable(id, approvalId, ok)
	local window = self.windows[id]
	if not window then return false end
	for _, approval in ipairs(window.approvals) do
		if approval.id == approvalId then
			local value = ok == true
			if approval.inspectable ~= value then approval.inspectable = value; self:emit(id) end
			return true
		end
	end
	return false
end

-- `mine` vine de la daemon (claims-urile joburilor proprii); fără el, după fereastra jobului sau după developer (tablă 0.8).
function Store:ownsClaim(claim)
	if type(claim.mine) == "boolean" then return claim.mine end
	local owner = self:findJob(claim.jobId)
	if owner then return not owner.remote end
	return self.developer ~= nil and claim.developer == self.developer
end

function Store:finish(window, terminalState)
	if not window.job then return end
	window.cursor = window.job.after
	window.job = nil
	window.state = terminalState
	window.cancelling, window.decisionId, window.releasing = false, nil, false
	window.claims = {}
	for _, approval in ipairs(window.approvals) do approval.inactive = true end
	if terminalState == "cancelled" then window.approvals = {} end
	self:message(window, "Status", if terminalState == "completed" then (if window.kind == "terminal" then "Sesiunea din terminal s-a încheiat." else "Cererea s-a încheiat.")
		elseif terminalState == "cancelled" then (if window.kind == "terminal" then "Sesiunea a fost oprită din Studio." else "Cererea a fost anulată.")
		elseif terminalState == "lost" then (if window.remote then "Developerul nu mai răspunde hub-ului; sesiunea revine dacă se reconectează." else "Jobul nu mai există în daemon; nu este reluat automat.")
		else "Cererea s-a încheiat cu o eroare.", if terminalState == "failed" or terminalState == "lost" then "error" else "notice")
end

function Store:claimText(event)
	local action = Store.CLAIM_ACTIONS[event.action] or "Claim"
	local paths = stringList(event.paths)
	local text = action .. ": " .. (if #paths &gt; 0 then table.concat(paths, ", ") else "(fără căi)")
	if event.action == "denied" and type(event.holder) == "string" and event.holder ~= "" then text ..= " · deținut de " .. Store.prefix(event.holder, 60) end
	return text
end

function Store:applyEvents(data)
	local window = self:findJob(data.job_id)
	if not window then return nil end
	if data.ok == false then
		if data.status == 404 then self:finish(window, "lost"); self:emit(window.id) end
		return window
	end
	local job = window.job
	local changed = false
	local events = {}
	for _, event in ipairs(list(data.events)) do
		if type(event) == "table" and type(event.seq) == "number" and event.seq % 1 == 0 and event.seq &gt;= 0 then table.insert(events, event) end
	end
	table.sort(events, function(a, b) return a.seq &lt; b.seq end)
	for _, event in ipairs(events) do
		if event.seq &gt; job.after then
			changed = true
			if event.type == "text" and type(event.text) == "string" then
				if not job.message or not table.find(window.messages, job.message) then
					job.message = self:message(window, Store.PROVIDERS[window.provider], "", "assistant")
				end
				if not job.message.clipped then
					local text = job.message.text .. event.text
					job.message.clipped = #text &gt; Store.MAX_TEXT
					job.message.text = Store.prefix(text, Store.MAX_TEXT) .. (if job.message.clipped then "\n[Afișare locală limitată.]" else "")
				end
			elseif event.type == "prompt" and type(event.text) == "string" then
				job.message = nil
				self:message(window, tostring(window.developer or self.developer or "Developer") .. " · terminal", event.text, "user")
			elseif event.type == "claim" then
				self:message(window, "Coordonare", self:claimText(event), "claim")
			elseif event.type == "approval" and window.remote then
				-- Aprobarea aparține developerului sesiunii; aici este doar o notificare.
				self:message(window, "Propunere", tostring(event.tool or "Instrument necunoscut") .. " așteaptă aprobarea lui " .. tostring(window.developer or "developer") .. ".", "approval")
			elseif event.type == "approval" and type(event.approval_id) == "string" and event.approval_id ~= "" then
				local exists = false
				for _, approval in ipairs(window.approvals) do if approval.id == event.approval_id then exists = true end end
				if not exists then
					if #window.approvals &gt;= 32 then
						window.approvals[1].blocked = true
						self:message(window, "Prea multe aprobări", "Oprește această cerere și cere pași mai mici.", "error")
					else
						table.insert(window.approvals, { id = event.approval_id, jobId = job.id,
							tool = event.tool, arguments = event.arguments, inspectable = false,
							blocked = type(event.tool) ~= "string" or event.tool == "" or type(event.arguments) ~= "table", inactive = false })
						self:message(window, "Propunere", tostring(event.tool or "Instrument necunoscut") .. " cere aprobarea ta.", "approval")
					end
				end
			elseif event.type == "status" then
				if event.approval_active == false and type(event.approval_id) == "string" then self:removeApproval(window.id, job.id, event.approval_id) end
				if type(event.text) == "string" then self:message(window, "Status", event.text, "notice") end
			elseif event.type == "error" then
				self:message(window, "Eroare", tostring(event.text or "Daemon-ul a raportat o eroare."), "error")
			elseif event.type == "tool" then
				job.message = nil
				self:message(window, "Instrument", tostring(event.tool or "MCP") .. (if type(event.text) == "string" then "\n" .. event.text else ""), "tool")
			end
			job.after = event.seq
		end
	end
	if type(data.state) == "string" and job.state ~= data.state then
		job.state, window.state, changed = data.state, data.state, true
	end
	if Store.TERMINAL[job.state] then self:finish(window, job.state); changed = true end
	if changed then self:emit(window.id) end
	return window
end

-- Sesiune a altui dispozitiv (oglindită prin hub): `mine` vine de la daemon-ul 1.0; `remote`/developer diferit sunt formele vechi ale tablei.
function Store:isRemote(session)
	if session.mine == true then return false end
	if session.mine == false or session.remote == true then return true end
	return type(session.developer) == "string" and self.developer ~= nil and session.developer ~= self.developer
end

function Store:syncTerminalSession(session, remote)
	local jobId = session.job_id
	local id = Store.terminalWindowId(jobId)
	if self.dismissedTerminal[jobId] then return nil end
	local window = self.windows[id]
	local state = if type(session.state) == "string" then session.state else "running"
	if not window then
		if #self.order &gt;= Store.MAX_WINDOWS then return nil end
		window = newWindow(id, "terminal", if Store.PROVIDERS[session.provider] then session.provider else "claude", sessionName(session))
		window.terminalJobId, window.remote, window.mine = jobId, remote == true, remote ~= true
		window.sessionKind = if session.kind == "studio" then "studio" else "terminal"
		window.locked, window.state = true, state
		window.started = tonumber(session.started) or os.time()
		if not Store.TERMINAL[state] then window.job = { id = jobId, after = 0, state = state, message = nil } end
		self.windows[id] = window
		table.insert(self.order, id)
		self:message(window, if remote then "Sesiune a altui developer" else "Sesiune din terminal",
			if remote then "Fereastră doar de citit, oglindită prin hub. Oprirea, claims-urile și aprobările aparțin developerului ei."
			else "Fereastră doar de citit. Comenzile se dau în terminalul developerului; aici vezi promptul, instrumentele și claims-urile.", "notice")
	end
	window.name = sessionName(session)
	window.started = tonumber(session.started) or window.started
	window.developer = if type(session.developer) == "string" then Store.prefix(session.developer, 60) else window.developer
	window.machine = if type(session.machine) == "string" then Store.prefix(session.machine, 64) else window.machine
	window.owner = Store.ownerFrom(session) or window.owner
	window.workspace = optionalText(session.workspace, 64) or window.workspace
	window.cwd = if type(session.cwd) == "string" then Store.prefix(session.cwd, 200) else nil
	window.claims = stringList(session.claims)
	window.pendingApproval = session.pending_approval == true
	if type(session.studio_id) == "string" and session.studio_id ~= "" then
		window.studioId = session.studio_id
		local studio = self:studio(session.studio_id)
		window.studioName = if studio then studio.name else window.studioName
	end
	if window.job then
		if Store.TERMINAL[state] then self:finish(window, state)
		elseif window.job.state ~= state then window.job.state, window.state = state, state end
	elseif not Store.TERMINAL[state] and Store.TERMINAL[window.state] then
		-- Jobul a revenit în board ca activ (dispozitiv remote reconectat); îl urmărim de la ultimul cursor.
		window.job = { id = jobId, after = window.cursor, state = state, message = nil }
		window.state = state
	elseif Store.TERMINAL[state] and window.state ~= state then
		window.state = state
	end
	return window
end

local function validClaim(claim)
	return type(claim) == "table" and type(claim.path) == "string" and claim.path ~= "" and type(claim.job_id) == "string"
end

function Store:resetUpdate()
	self.update = Store.defaultUpdate()
end

function Store:applyUpdate(update)
	if type(update) ~= "table" then self:resetUpdate(); return end
	local message = if type(update.message) == "string" then (string.gsub(update.message, "%c", " ")) else ""
	self.update = {
		current = if type(update.current) == "string" then Store.prefix(update.current, 32) else "",
		available = optionalText(update.available, 32),
		state = if type(update.state) == "string" and Store.UPDATE_STATES[update.state] then update.state else "idle",
		message = Store.prefix(message, 200),
		restartRequired = update.restart_required == true,
	}
end

function Store:resetProject()
	self.project = Store.defaultProject()
end

-- Câmpurile lipsă rămân din snapshotul anterior (sending → sent păstrează numărul); valorile invalide revin la implicit.
function Store:setProject(state, fields)
	local previous, project = self.project, Store.defaultProject()
	fields = if type(fields) == "table" then fields else {}
	local function pick(key) return if fields[key] ~= nil then fields[key] else previous[key] end
	project.state = if Store.PROJECT_STATES[state] then state else "idle"
	project.snapshotId = optionalText(pick("snapshotId"), 64)
	project.count = math.max(0, math.floor(tonumber(pick("count")) or 0))
	project.truncated = pick("truncated") == true
	project.sentAt = tonumber(pick("sentAt"))
	local message = pick("message")
	project.message = if type(message) == "string" then Store.prefix((string.gsub(message, "%c", " ")), 200) else ""
	self.project = project
	self:emit(nil)
	return project
end

function Store:applyMembers(members)
	self.members = {}
	for _, row in ipairs(list(members)) do
		local member = Store.memberFrom(row, self.hub.deviceId)
		if member and #self.members &lt; Store.MAX_MEMBERS then table.insert(self.members, member) end
	end
end

function Store:applyWorkspaces(rows)
	self.workspaces = {}
	local current = self:workspaceKey()
	for _, row in ipairs(list(rows)) do
		local workspace = Store.workspaceRowFrom(row)
		if workspace and #self.workspaces &lt; Store.MAX_WORKSPACES then
			workspace.mine = workspace.mine or workspace.key == current
			table.insert(self.workspaces, workspace)
		end
	end
end

function Store:workspaceRow(key)
	for _, workspace in ipairs(self.workspaces) do if workspace.key == key then return workspace end end
	return nil
end

-- Câmpurile comune din `/v1/status` și `/v1/board` (contract §4.3, §4.6): identitate, workspace, hub, prezenți, sumarul workspace-urilor.
function Store:applyPresence(data)
	-- `identity` este `null` până la primul `/v1/identity` acceptat (contract §4.3); identitatea citită local din Studio
	-- și publicată de controller rămâne până când daemon-ul o confirmă, altfel antetul își pierde numele la fiecare status.
	self.identity = Store.identityFrom(data.identity) or self.identity
	self.workspace = Store.workspaceFrom(data.workspace)
	self.hub = Store.hubFrom(data.hub, data.panel_url)
	self:applyMembers(data.members)
	self:applyWorkspaces(data.workspaces)
	local owner = self:ownIdentity()
	if owner then
		for _, window in pairs(self.windows) do
			if not window.remote then window.owner = copy(owner) end
		end
	end
end

-- `GET /v1/status` → store (contract §4.3): providerii, numele afișat, identitatea, workspace-ul, hub-ul, prezenții, actualizarea, inventarul daemon-ului.
function Store:applyStatus(data)
	if type(data) ~= "table" then return false end
	self.providers = if type(data.providers) == "table" then data.providers else {}
	if type(data.developer) == "string" and data.developer ~= "" then self.developer = Store.prefix(data.developer, 60) end
	self.machine = cleanText(data.machine, 64) or self.machine
	self.pluginConnected = data.plugin_connected == true
	-- Modul de aprobare ține de daemon (îl păstrează în config.json); pluginul doar îl arată și îl schimbă.
	local settings = if type(data.settings) == "table" then data.settings else nil
	local mode = if settings then settings.auto_approve else nil
	if mode == "ask" or mode == "edits" or mode == "all" then self.autoApprove = mode end
	self:applyPresence(data)
	self:applyUpdate(data.update)
	self.daemonProject = Store.daemonProjectFrom(data.project)
	self:emit(nil)
	return true
end

-- `GET /v1/board` → store (contract §4.6): sesiunile proprii și ale colegilor din workspace, claims-urile cu `mine`, jurnalul workspace-ului.
function Store:syncBoard(board)
	if type(board) ~= "table" then return false end
	self:applyStudios(board.studios)
	if type(board.developer) == "string" and board.developer ~= "" then self.developer = Store.prefix(board.developer, 60) end
	if type(board.default_studio_id) == "string" and self:studio(board.default_studio_id) then self.defaultStudioId = board.default_studio_id end
	self:applyPresence(board)
	local present = {}
	for _, session in ipairs(list(board.sessions)) do
		if type(session) == "table" and type(session.job_id) == "string" and session.job_id ~= "" then
			local remote = self:isRemote(session)
			if remote or session.kind == "terminal" then
				present[session.job_id] = true
				self:syncTerminalSession(session, remote)
			else
				local window = self:findJob(session.job_id)
				if window then
					window.claims = stringList(session.claims)
					window.workspace = optionalText(session.workspace, 64) or window.workspace
					window.owner = Store.ownerFrom(session) or window.owner
				end
			end
		end
	end
	for index = #self.order, 1, -1 do
		local window = self.windows[self.order[index]]
		if window.kind == "terminal" and not present[window.terminalJobId] then
			if window.job then self:finish(window, "lost") end
			self.windows[window.id] = nil
			table.remove(self.order, index)
			self.dismissedTerminal[window.terminalJobId] = nil
		end
	end
	for jobId in pairs(self.dismissedTerminal) do
		if not present[jobId] then self.dismissedTerminal[jobId] = nil end
	end
	self.claims = {}
	for _, claim in ipairs(list(board.claims)) do
		if validClaim(claim) and #self.claims &lt; Store.MAX_CLAIMS then
			table.insert(self.claims, { path = Store.prefix(claim.path, 200), jobId = claim.job_id,
				developer = if type(claim.developer) == "string" then Store.prefix(claim.developer, 60) else "?",
				since = tonumber(claim.since), expires = tonumber(claim.expires), reason = optionalText(claim.reason, 120),
				workspace = optionalText(claim.workspace, 64), mine = if type(claim.mine) == "boolean" then claim.mine else nil })
		end
	end
	-- Daemon-ul trimite jurnalul cronologic; aici rămân ultimele MAX_JOURNAL intrări, cea mai nouă prima (DESIGN.md §10.1).
	self.journal = {}
	local entries = list(board.journal)
	for index = #entries, 1, -1 do
		local entry = entries[index]
		if type(entry) == "table" and type(entry.tool) == "string" and #self.journal &lt; Store.MAX_JOURNAL then
			table.insert(self.journal, Store.journalFrom(entry))
		end
	end
	self:emit(nil)
	return true
end

-- Alege workspace-ul privit în secțiunea Workspace (read-only); nil sau cheia jocului deschis revin la cel curent. Datele vin apoi prin applyWorkspaceView.
function Store:setViewWorkspace(key)
	if key ~= nil and (type(key) ~= "string" or key == "" or #key &gt; 64) then return false end
	if key == self:workspaceKey() then key = nil end
	if key ~= self.viewWorkspace then
		self.viewWorkspace, self.view = key, nil
		self:emit(nil)
	end
	return true
end

-- Răspunsul `GET /v1/hub/workspace?key=` pentru workspace-ul privit: meta, prezenți, sesiuni (doar meta) și numărul de claims; alt key este ignorat.
function Store:applyWorkspaceView(key, data)
	if type(key) ~= "string" or key == "" or key ~= self.viewWorkspace or type(data) ~= "table" then return false end
	local members, sessions = {}, {}
	for _, row in ipairs(list(data.members)) do
		local member = Store.memberFrom(row, self.hub.deviceId)
		if member and #members &lt; Store.MAX_MEMBERS then table.insert(members, member) end
	end
	for _, row in ipairs(list(data.sessions)) do
		local session = Store.sessionRowFrom(row, self.hub.deviceId)
		if session and #sessions &lt; Store.MAX_VIEW_SESSIONS then table.insert(sessions, session) end
	end
	table.sort(sessions, function(a, b)
		local activeA, activeB = not Store.TERMINAL[a.state], not Store.TERMINAL[b.state]
		if activeA ~= activeB then return activeA end
		local startedA, startedB = a.started or 0, b.started or 0
		if startedA ~= startedB then return startedA &gt; startedB end
		return a.jobId &lt; b.jobId
	end)
	local workspace = Store.workspaceFrom(data.workspace) or self:workspaceRow(key) or { key = key, name = key }
	self.view = { key = key, workspace = copy(workspace), members = members, sessions = sessions, claims = #list(data.claims) }
	self:emit(nil)
	return true
end

-- Workspace-ul afișat în secțiunea Workspace: cel privit (meta din vizualizare sau rândul din sumar), altfel jocul deschis.
function Store:viewedWorkspace()
	local key = self.viewWorkspace
	if not key then return self.workspace end
	if self.view and self.view.key == key then return self.view.workspace end
	return self:workspaceRow(key) or { key = key, name = key }
end

function Store:workspaceLabel()
	return Store.workspaceName(self:viewedWorkspace())
end

local function memberBefore(a, b)
	if a.me ~= b.me then return a.me end
	local seenA, seenB = a.lastSeen or 0, b.lastSeen or 0
	if seenA ~= seenB then return seenA &gt; seenB end
	if a.name ~= b.name then return a.name &lt; b.name end
	return a.deviceId &lt; b.deviceId
end

-- Prezenții din workspace-ul afișat („tu” primul, apoi după ultima activitate); în vizualizarea altui workspace, doar după ce datele au sosit.
function Store:membersInView()
	local source = self.members
	if self.viewWorkspace then source = if self.view and self.view.key == self.viewWorkspace then self.view.members else {} end
	local result = table.move(source, 1, #source, 1, {})
	table.sort(result, memberBefore)
	return result
end

-- Sesiunile (meta) ale workspace-ului privit; pentru workspace-ul curent sesiunile sunt ferestre (sessionsMine/sessionsOthers).
function Store:sessionsInView()
	if not self.viewWorkspace or not self.view or self.view.key ~= self.viewWorkspace then return {} end
	return table.move(self.view.sessions, 1, #self.view.sessions, 1, {})
end

-- Ferestrele proprii (Mod S și sesiunile din terminal ale acestui dispozitiv), în ordinea creării.
function Store:sessionsMine()
	local result = {}
	for _, id in ipairs(self.order) do
		local window = self.windows[id]
		if not window.remote then table.insert(result, window) end
	end
	return result
end

-- Sesiunile colegilor din workspace-ul curent (oglindite prin hub, doar de citit).
function Store:sessionsOthers()
	local result = {}
	for _, id in ipairs(self.order) do
		local window = self.windows[id]
		if window.remote then table.insert(result, window) end
	end
	return result
end

-- Textul stării hub-ului (DESIGN.md §6.2) și rolul de culoare; fără daemon, starea hub-ului nu este cunoscută.
function Store:hubStatusText()
	if not self.connected then return "Daemon-ul nu răspunde. Pornește CLI-ul cu pluginul Studio Harness sau Start-Daemon.cmd.", "neutral" end
	return Store.hubText(self.hub)
end

function Store:dismissTerminal(id)
	local window = self.windows[id]
	if not window or window.kind ~= "terminal" then return false end
	if window.job then self:setVisible(id, false); return false end
	self.dismissedTerminal[window.terminalJobId] = true
	self.windows[id] = nil
	local index = table.find(self.order, id)
	if index then table.remove(self.order, index) end
	self:emit(id)
	return true
end

function Store:remove(id)
	local window = self.windows[id]
	if not window or window.job or window.request or window.cancelling then return false end
	if window.kind == "terminal" then return self:dismissTerminal(id) end
	self.windows[id] = nil
	local index = table.find(self.order, id)
	if index then table.remove(self.order, index) end
	self:emit(id)
	return true
end

-- Handoff-ul metamorfozei (faza 5): starea locală ca tabel simplu, copiat, fără token și fără referințe la obiectele store-ului.
function Store:serialize()
	local windows = {}
	for _, id in ipairs(self.order) do
		local window = self.windows[id]
		local messages, approvals = {}, {}
		for _, message in ipairs(window.messages) do
			table.insert(messages, { author = message.author, text = message.text, kind = message.kind, clipped = message.clipped == true })
		end
		for _, approval in ipairs(window.approvals) do
			table.insert(approvals, { id = approval.id, jobId = approval.jobId, tool = approval.tool, arguments = copy(approval.arguments),
				blocked = approval.blocked == true, inactive = approval.inactive == true })
		end
		local request = window.request
		table.insert(windows, {
			id = window.id, kind = window.kind, sessionKind = window.sessionKind, name = window.name, provider = window.provider,
			developer = window.developer, remote = window.remote, mine = window.mine, machine = window.machine,
			owner = copy(window.owner), workspace = window.workspace, started = window.started,
			studioId = window.studioId, studioName = window.studioName, cwd = window.cwd, cursor = window.cursor,
			sessionId = window.sessionId, terminalJobId = window.terminalJobId, locked = window.locked, state = window.state,
			job = if window.job then { id = window.job.id, after = window.job.after, state = window.job.state } else nil,
			request = if request then { id = request.id, payload = copy(request.payload), bridgeId = request.bridgeId,
				draftRevision = request.draftRevision, messageIndex = table.find(window.messages, request.message) } else nil,
			draft = window.draft, draftRevision = window.draftRevision, visible = window.visible,
			messages = messages, approvals = approvals, claims = copy(window.claims),
		})
	end
	local studios, dismissed = {}, {}
	for _, studio in ipairs(self.studios) do table.insert(studios, { id = studio.id, name = studio.name }) end
	for jobId in pairs(self.dismissedTerminal) do table.insert(dismissed, jobId) end
	return { version = Store.HANDOFF_VERSION, windows = windows, studios = studios, dismissedTerminal = dismissed,
		defaultStudioId = self.defaultStudioId, defaultProvider = self.defaultProvider, developer = self.developer, bridgeId = self.bridgeId,
		machine = self.machine, identity = copy(self.identity), workspace = copy(self.workspace), hub = copy(self.hub), viewWorkspace = self.viewWorkspace }
end

local function restoreMessages(list)
	local messages = {}
	for _, entry in ipairs(if type(list) == "table" then list else {}) do
		if type(entry) == "table" and type(entry.text) == "string" then
			table.insert(messages, { author = if type(entry.author) == "string" then Store.prefix(entry.author, 120) else "Status",
				text = Store.prefix(entry.text, Store.MAX_TEXT), kind = if type(entry.kind) == "string" then entry.kind else "text", clipped = entry.clipped == true })
		end
	end
	while #messages &gt; Store.MAX_MESSAGES do table.remove(messages, 1) end
	return messages
end

-- Proprietarul dintr-un handoff: forma 1.0 (`owner`) sau câmpurile 0.8 ale ferestrei (`developer`, `memberId`, `machine`).
local function restoreOwner(entry)
	local owner = entry.owner
	if type(owner) == "table" then
		return Store.ownerFrom({ developer = owner.name, device_id = owner.deviceId, machine = owner.machine, roblox_user_id = owner.userId })
	end
	return Store.ownerFrom({ developer = entry.developer, member_id = entry.memberId, machine = entry.machine })
end

-- O fereastră din handoff; câmpurile lipsă sau invalide revin la implicit, o intrare imposibilă întoarce nil.
local function restoreWindow(entry, index)
	if type(entry) ~= "table" or type(entry.id) ~= "string" or entry.id == "" or #entry.id &gt; 200 then return nil end
	local kind = if entry.kind == "terminal" then "terminal" else "studio"
	local terminalJobId = optionalText(entry.terminalJobId, 200) or string.match(entry.id, "^terminal:(.+)$")
	if kind == "terminal" and not terminalJobId then return nil end
	local name = if type(entry.name) == "string" and string.find(entry.name, "%S") then Store.prefix((string.gsub(entry.name, "%c", " ")), 80)
		elseif kind == "terminal" then "Terminal" else "Sesiune " .. index
	local window = newWindow(entry.id, kind, if Store.PROVIDERS[entry.provider] then entry.provider else "claude", name)
	window.sessionKind = if entry.sessionKind == "studio" or entry.sessionKind == "terminal" then entry.sessionKind else kind
	window.developer, window.machine = optionalText(entry.developer, 60), optionalText(entry.machine, 64)
	window.remote = entry.remote == true
	window.mine = not window.remote
	window.owner, window.workspace = restoreOwner(entry), optionalText(entry.workspace, 64)
	window.started = integer(entry.started)
	window.studioId, window.studioName, window.cwd = optionalText(entry.studioId, 128), optionalText(entry.studioName, 200), optionalText(entry.cwd, 200)
	window.cursor = integer(entry.cursor) or 0
	window.messages, window.claims = restoreMessages(entry.messages), stringList(entry.claims)
	window.visible = entry.visible ~= false
	window.draft = if kind == "studio" and type(entry.draft) == "string" then Store.prefix(entry.draft, Store.MAX_TEXT) else ""
	window.draftRevision = integer(entry.draftRevision) or 0
	if kind == "terminal" then window.terminalJobId, window.locked = terminalJobId, true
	else
		window.sessionId = optionalText(entry.sessionId, 200)
		window.locked = entry.locked == true or window.sessionId ~= nil
	end
	local job, state = entry.job, if type(entry.state) == "string" and Store.STATES[entry.state] then entry.state else nil
	if type(job) == "table" and type(job.id) == "string" and job.id ~= "" and #job.id &lt;= 200 and (kind == "studio" or job.id == terminalJobId)
		and not (type(job.state) == "string" and Store.TERMINAL[job.state]) then
		local jobState = if type(job.state) == "string" and Store.STATES[job.state] and job.state ~= "draft" then job.state else "running"
		window.job = { id = job.id, after = integer(job.after) or 0, state = jobState, message = nil }
		window.state, window.locked = jobState, true
		-- Ultimul mesaj al asistentului rămâne ținta evenimentelor `text` următoare, ca răspunsul să nu se rupă în două.
		local last = window.messages[#window.messages]
		if last and last.kind == "assistant" then window.job.message = last end
		for _, approval in ipairs(if type(entry.approvals) == "table" then entry.approvals else {}) do
			if type(approval) == "table" and type(approval.id) == "string" and approval.id ~= "" and approval.jobId == job.id and #window.approvals &lt; 32 then
				-- `inspectable` nu se moștenește: ApprovalView-ul nou măsoară din nou argumentele înainte de „Permite”.
				table.insert(window.approvals, { id = approval.id, jobId = job.id, tool = approval.tool, arguments = copy(approval.arguments), inactive = approval.inactive == true,
					inspectable = false, blocked = approval.blocked == true or type(approval.tool) ~= "string" or approval.tool == "" or type(approval.arguments) ~= "table" })
			end
		end
	else
		local ended = if type(job) == "table" and type(job.state) == "string" and Store.TERMINAL[job.state] then job.state else nil
		if kind == "terminal" then window.state = if state and Store.TERMINAL[state] then state else ended or "completed"
		else window.state = if state and (state == "draft" or Store.TERMINAL[state]) then state else ended or "draft" end
	end
	local request = entry.request
	if kind == "studio" and not window.job and type(request) == "table" and type(request.id) == "string" and request.id ~= "" and #request.id &lt;= 200
		and type(request.payload) == "table" and type(request.payload.prompt) == "string" then
		-- Cererea era în zbor în aplicația veche: devine neconfirmată, reluabilă doar cu confirmare explicită (același ID).
		local payload = copy(request.payload)
		payload.client_request_id = request.id
		local message = window.messages[integer(request.messageIndex, 1) or 0]
		if message then message.author = "Tu · neconfirmat" end
		window.request = { id = request.id, payload = payload, bridgeId = optionalText(request.bridgeId, 128),
			draftRevision = integer(request.draftRevision) or -1, state = "uncertain", message = message }
		window.state, window.locked = "uncertain", true
	end
	return window
end

-- Tolerant: orice date (chiar nil sau tabel corupt) dau un store valid; ferestrele imposibile sunt sărite, joburile duplicate păstrate o singură dată.
-- Snapshot-urile 0.8 nu au identitate, workspace sau hub: câmpurile rămân nil/implicite până la primul `/v1/status`.
function Store.deserialize(data)
	local store = Store.new()
	if type(data) ~= "table" then return store end
	store.defaultProvider = if Store.PROVIDERS[data.defaultProvider] then data.defaultProvider else "claude"
	store.developer, store.bridgeId = optionalText(data.developer, 60), optionalText(data.bridgeId, 128)
	store.machine = cleanText(data.machine, 64)
	local identity, workspace, hub = data.identity, data.workspace, data.hub
	if type(identity) == "table" then store.identity = Store.identityFrom({ user_id = identity.userId, name = identity.name, avatar = identity.avatar }) end
	if type(workspace) == "table" then
		store.workspace = Store.workspaceFrom({ key = workspace.key, name = workspace.name, place_id = workspace.placeId, game_id = workspace.gameId,
			creator_id = workspace.creatorId, creator_type = workspace.creatorType })
	end
	if type(hub) == "table" then
		store.hub = Store.hubFrom({ status = hub.status, url = hub.url, hub_id = hub.hubId, device_id = hub.deviceId, error = hub.error,
			enrollment = hub.enrollment, last_sync = hub.lastSync }, hub.panelUrl)
	end
	local view = data.viewWorkspace
	if type(view) == "string" and view ~= "" and #view &lt;= 64 and view ~= store:workspaceKey() then store.viewWorkspace = view end
	pcall(store.applyStudios, store, data.studios)
	if store:studio(data.defaultStudioId) then store.defaultStudioId = data.defaultStudioId end
	for _, jobId in ipairs(if type(data.dismissedTerminal) == "table" then data.dismissedTerminal else {}) do
		if type(jobId) == "string" and jobId ~= "" then store.dismissedTerminal[jobId] = true end
	end
	local seenJobs = {}
	for _, entry in ipairs(if type(data.windows) == "table" then data.windows else {}) do
		if #store.order &gt;= Store.MAX_WINDOWS then break end
		local ok, window = pcall(restoreWindow, entry, #store.order + 1)
		if ok and window and not store.windows[window.id] and not (window.job and seenJobs[window.job.id]) then
			if window.job then seenJobs[window.job.id] = true end
			store.windows[window.id] = window
			table.insert(store.order, window.id)
		end
	end
	return store
end

return Store
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX10">
        <Properties>
          <string name="Name">SessionView</string>
          <ProtectedString name="Source">-- Studio Harness SessionView 1.0.0 — fereastra unei sesiuni: antet, flux de mesaje, composer și cardul de aprobare.
-- Structura și textele urmează design/DESIGN.md §10.6–§10.8 și §12; toate culorile vin din token-urile Theme.
local Theme = require(script.Parent.Theme)
local ApprovalView = require(script.Parent.ApprovalView)
local SessionView = {}
SessionView.__index = SessionView

local PAD = Theme.SPACE.md -- 12: marginea ferestrei, a antetului și a composer-ului
local GAP = Theme.SPACE.sm -- 8: distanța dintre controale
local TITLE_HEIGHT = 36
local ROW_HEIGHT = 20
local BUTTON_ROW = 32
local SPLIT_WIDTH = 820 -- peste această lățime aprobarea stă lângă flux (50/50), sub ea dedesubt (30/70)
local MIN_APPROVAL = 190 -- cardul de aprobare cu o cutie de argumente utilizabilă (142 px fixe + 48 px de text)
local MIN_FLOW = 60 -- fluxul nu dispare niciodată complet de sub aprobare
local FOLLOW_SLACK = 60 -- toleranța în px pentru „utilizatorul era la capătul fluxului” (§13)

-- Felurile de bulă (§6.5) pentru felurile de mesaj ale store-ului: „user” este ce a scris developerul,
-- iar „text” rămâne doar nota locală de deschidere a ferestrei, deci se desenează ca notiță.
local BUBBLE_KIND = { user = "text", text = "notice" }

-- Mesajul store-ului tradus în forma cerută de `Theme.bubble`; autorul „Tu” dispare din bula proprie (wireframe §10.6).
local function bubbleFields(message)
	local kind = BUBBLE_KIND[message.kind] or message.kind or "notice"
	local author = if type(message.author) == "string" then message.author else ""
	if kind == "text" and author == "Tu" then author = "" end
	return { author = author, text = message.text, kind = kind }
end

-- Numele afișat al proprietarului ferestrei: „tu” pentru sesiunile proprii, contul Roblox pentru ale altora.
local function ownerName(window, owner)
	if window.remote ~= true and window.mine ~= false then return "tu" end
	if owner and type(owner.name) == "string" and owner.name ~= "" then return Theme.fit(owner.name, 24) end
	return "?"
end

function SessionView.new(pluginObject, store, controller, id)
	local window = store.windows[id]
	local terminal, remote = window.kind == "terminal", window.remote == true
	local self = setmetatable({ connections = {}, destroyed = false, store = store, controller = controller,
		id = id, terminal = terminal, remote = remote, messageViews = {}, refreshing = false, followChat = true,
		retryConfirm = false, restoreVersion = window.restoreVersion, stateRole = nil, avatarKey = nil, confirmText = nil }, SessionView)
	local info = DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Float, window.visible, true, 480, 740, 380, 640)
	self.widget = pluginObject:CreateDockWidgetPluginGuiAsync("StudioHarnessMatrixSession_" .. id, info)
	self.widget.Name, self.widget.Title = "StudioHarnessSession_" .. id, window.name
	-- Ca la hub: panoul supraviețuiește instanței anterioare (Play, metamorfoză), deci îi golim conținutul rămas.
	for _, child in ipairs(self.widget:GetChildren()) do child:Destroy() end
	self.root = Theme.frame(self.widget, "SessionContent")
	self:buildHeader(window)
	self:buildBody()
	self:buildComposer()
	self:buildConfirm()
	self:bind()
	self:update()
	return self
end

-- Antet fix: titlu editabil inline, butoane mici, chip-uri (provider, tip, stare), proprietar și claims (§10.6).
function SessionView:buildHeader(window)
	local header = Theme.frame(self.root, "Header", "bg")
	header.Size = UDim2.new(1, 0, 0, 0)
	header.AutomaticSize = Enum.AutomaticSize.Y
	Theme.padding(header, PAD, PAD)
	Theme.list(header, Theme.SPACE.xs + 2)
	self.header = header
	self.headerLine = Theme.frame(self.root, "HeaderLine", "border")
	self.headerLine.Size = UDim2.new(1, 0, 0, 1)

	local titleRow = Theme.new("Frame", { Name = "TitleRow", BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, TITLE_HEIGHT), LayoutOrder = 1 }, header)
	local reserved = 0
	self.closeButton = Theme.button(titleRow, "×", { kind = "ghost", size = "sm", name = "CloseSession", width = UDim.new(0, 28) })
	self.closeButton.AnchorPoint = Vector2.new(1, 0.5)
	self.closeButton.Position = UDim2.new(1, -reserved, 0.5, 0)
	reserved += 28 + Theme.SPACE.xs
	self.hideButton = Theme.button(titleRow, "_", { kind = "ghost", size = "sm", name = "MinimizeSession", width = UDim.new(0, 28) })
	self.hideButton.AnchorPoint = Vector2.new(1, 0.5)
	self.hideButton.Position = UDim2.new(1, -reserved, 0.5, 0)
	reserved += 28 + Theme.SPACE.xs
	if not self.terminal then
		self.newButton = Theme.button(titleRow, "Nou", { kind = "ghost", size = "sm", name = "NewConversation", width = UDim.new(0, 44) })
		self.newButton.AnchorPoint = Vector2.new(1, 0.5)
		self.newButton.Position = UDim2.new(1, -reserved, 0.5, 0)
		reserved += 44 + Theme.SPACE.xs
	end
	-- Titlul este un câmp fără chenar până la hover sau focus; padding-ul lui intern se compensează cu −10 px.
	self.title = Theme.input(titleRow, { placeholder = "Numele sesiunii", height = TITLE_HEIGHT, name = "SessionName" })
	self.title.TextSize = Theme.TEXT.xl
	self.title.Font = Theme.font("ui")
	self.title.TextEditable = not (self.terminal or self.remote)
	self.title.Position = UDim2.fromOffset(-10, 0)
	self.title.Size = UDim2.new(1, -(reserved + GAP - 10), 1, 0)
	self.title.BackgroundTransparency = 1
	self.titleStroke = self.title:FindFirstChildWhichIsA("UIStroke")
	if self.titleStroke then self.titleStroke.Transparency = 1 end

	local chips = Theme.new("Frame", { Name = "Chips", BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, ROW_HEIGHT), LayoutOrder = 2 }, header)
	Theme.list(chips, Theme.SPACE.xs, true)
	local provider = Theme.chip(chips, Theme.names[window.provider] or window.provider, window.provider)
	provider.LayoutOrder = 1
	if self.terminal then
		local kind = Theme.chip(chips, Theme.kinds[window.sessionKind] or Theme.kinds.terminal, "neutral")
		kind.LayoutOrder = 2
	end
	self.stateChip = Theme.chip(chips, "", "neutral")
	self.stateChip.LayoutOrder = 3
	if self.remote then
		local readOnly = Theme.chip(chips, "doar de citit", "neutral")
		readOnly.LayoutOrder = 4
	end

	self.ownerRow = Theme.new("Frame", { Name = "Owner", BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, ROW_HEIGHT), LayoutOrder = 3 }, header)
	self.meta = Theme.label(self.ownerRow, "", { size = "xs", token = "text2", height = ROW_HEIGHT, truncate = true, name = "Meta" })
	self.meta.Position = UDim2.fromOffset(16 + GAP, 0)
	self.target = Theme.button(self.ownerRow, "Țintă nealeasă", { kind = "ghost", size = "sm", name = "SessionStudio", width = UDim.new(0, 120) })
	self.target.AnchorPoint = Vector2.new(1, 0.5)
	self.target.Position = UDim2.new(1, 0, 0.5, 0)
	self.target.Visible = false

	self.claims = Theme.label(header, "", { size = "xs", token = "text2", height = 18, truncate = true, name = "Claims" })
	self.claims.LayoutOrder = 4
end

-- Fluxul de mesaje și cardul de aprobare împart zona dintre antet și composer (§10.6, §10.8).
function SessionView:buildBody()
	self.body = Theme.new("Frame", { Name = "Flow", BackgroundTransparency = 1 }, self.root)
	self.chat = Theme.scroll(self.body, "SessionMessages")
	self.chatLayout = Theme.list(self.chat, Theme.SPACE.md)
	self.empty = Theme.empty(self.chat, if self.terminal then "Sesiunea nu a trimis încă niciun eveniment."
		else "Scrie primul pas mai jos. Agentul vede selecția ta din Studio.")
	self.empty.root.LayoutOrder = 0
	self.approval = ApprovalView.new(self.body, self.store, self.id, function(approvalId, allow)
		if not allow or self.approval:inspectable(approvalId) then self.controller:decide(self.id, approvalId, allow) end
	end)
end

-- Composer fix jos: prompt + „Trimite”/„Oprește” (Mod S) sau „Oprește”/„Eliberează claims” (Mod T); sesiunea altuia nu are niciunul.
function SessionView:buildComposer()
	local composer = Theme.frame(self.root, "Composer", "surface")
	composer.AnchorPoint = Vector2.new(0, 1)
	composer.Position = UDim2.new(0, 0, 1, 0)
	composer.Size = UDim2.new(1, 0, 0, 0)
	composer.AutomaticSize = Enum.AutomaticSize.Y
	Theme.padding(composer, PAD, PAD)
	Theme.list(composer, GAP)
	self.composer = composer
	self.footerLine = Theme.frame(self.root, "FooterLine", "border")
	self.footerLine.Size = UDim2.new(1, 0, 0, 1)
	if self.remote then
		composer.Visible = false
		return
	end
	local buttons = Theme.new("Frame", { Name = "Actions", BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, BUTTON_ROW), LayoutOrder = 2 }, composer)
	if self.terminal then
		self.stop = Theme.button(buttons, "Oprește", { name = "StopSession", width = UDim.new(0.5, -Theme.SPACE.xs) })
		self.release = Theme.button(buttons, "Eliberează claims", { name = "ReleaseClaims", width = UDim.new(0.5, -Theme.SPACE.xs) })
		self.release.Position = UDim2.new(0.5, Theme.SPACE.xs, 0, 0)
		return
	end
	self.draft = Theme.textarea(composer, { placeholder = "Scrie următorul pas…", height = 72, name = "Prompt" })
	self.draft.LayoutOrder = 1
	self.send = Theme.button(buttons, "Trimite", { kind = "primary", name = "SendMessage", width = UDim.new(0.6, -Theme.SPACE.xs) })
	self.stop = Theme.button(buttons, "Oprește", { name = "StopSession", width = UDim.new(0.4, -Theme.SPACE.xs) })
	self.stop.Position = UDim2.new(0.6, Theme.SPACE.xs, 0, 0)
	self.hint = Theme.label(composer, "", { size = "xs", token = "text2", name = "Hint" })
	self.hint.LayoutOrder = 3
end

-- Confirmările (închidere, reluarea unei cereri neconfirmate) înlocuiesc composer-ul, inline, nu într-un dialog (§13).
function SessionView:buildConfirm()
	local confirm = Theme.frame(self.root, "Confirm", "surface")
	confirm.AnchorPoint = Vector2.new(0, 1)
	confirm.Position = UDim2.new(0, 0, 1, 0)
	confirm.Size = UDim2.new(1, 0, 0, 0)
	confirm.AutomaticSize = Enum.AutomaticSize.Y
	confirm.Visible = false
	Theme.padding(confirm, PAD, PAD)
	Theme.list(confirm, GAP)
	self.confirm = confirm
	self.confirmBanner = Theme.banner(confirm, { role = "warning", name = "ConfirmBanner" })
	self.confirmBanner.root.LayoutOrder = 1
	local buttons = Theme.new("Frame", { Name = "Actions", BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, BUTTON_ROW), LayoutOrder = 2 }, confirm)
	self.confirmClose = Theme.button(buttons, "Închide definitiv", { kind = "danger", name = "ConfirmSessionAction",
		width = UDim.new(0.6, -Theme.SPACE.xs) })
	self.confirmRetry = Theme.button(buttons, "Reia aceeași cerere", { kind = "primary", name = "RetrySessionRequest",
		width = UDim.new(0.6, -Theme.SPACE.xs) })
	self.confirmRetry.Visible = false
	self.confirmNo = Theme.button(buttons, "Înapoi", { name = "DismissSessionAction", width = UDim.new(0.4, -Theme.SPACE.xs) })
	self.confirmNo.Position = UDim2.new(0.6, Theme.SPACE.xs, 0, 0)
end

-- Legăturile: butoanele antetului, composer-ul, confirmările, redenumirea, derularea fluxului și relayout-ul.
function SessionView:bind()
	local store, controller, id = self.store, self.controller, self.id
	if self.newButton then
		Theme.click(self, self.newButton, function()
			local current = store.windows[id]
			if current then controller:createWindow(current.provider, store:studio(current.studioId)) end
		end)
	end
	Theme.click(self, self.hideButton, function() store:setVisible(id, false) end)
	Theme.click(self, self.closeButton, function()
		local current = store.windows[id]
		if not current then return end
		if self.terminal then
			controller:close(id)
		else
			current.closeConfirm, self.retryConfirm = true, false
			store:emit(id)
		end
	end)
	Theme.click(self, self.target, function()
		if not self.terminal and not self.remote then store:bindStudio(id, store:studio(store.defaultStudioId)) end
	end)
	if self.send then
		Theme.click(self, self.send, function()
			local current = store.windows[id]
			if current and current.request and current.request.state == "uncertain" then
				self.retryConfirm, current.closeConfirm = true, false
				self:update()
			else
				controller:send(id)
			end
		end)
	end
	if self.stop then Theme.click(self, self.stop, function() controller:cancel(id, false) end) end
	if self.release then
		Theme.click(self, self.release, function() controller:releaseClaims(store:jobIdOf(store.windows[id])) end)
	end
	Theme.click(self, self.confirmClose, function()
		local current = store.windows[id]
		if not current then return end
		current.closeConfirm = false
		controller:close(id, true)
		if store.windows[id] then self:update() end
	end)
	Theme.click(self, self.confirmRetry, function()
		if not self.retryConfirm then return end
		self.retryConfirm = false
		controller:retry(id)
		self:update()
	end)
	Theme.click(self, self.confirmNo, function()
		self.retryConfirm = false
		local current = store.windows[id]
		if current then
			current.closeConfirm, current.closeAfterCancel = false, false
			store:emit(id)
		end
	end)
	-- Titlul își arată chenarul doar când poate fi editat și doar sub cursor sau în focus.
	local function titleChrome(active)
		local on = active == true and self.title.TextEditable
		Theme.tween(self.title, { BackgroundTransparency = if on then 0 else 1 })
		if self.titleStroke then Theme.tween(self.titleStroke, { Transparency = if on then 0 else 1 }) end
	end
	Theme.connect(self, self.title.MouseEnter, function() titleChrome(true) end)
	Theme.connect(self, self.title.MouseLeave, function() titleChrome(self.title:IsFocused()) end)
	Theme.connect(self, self.title.Focused, function() titleChrome(true) end)
	Theme.connect(self, self.title.FocusLost, function()
		titleChrome(false)
		if not self.terminal and not self.remote then store:rename(id, self.title.Text) end
	end)
	if self.draft then
		Theme.connect(self, self.draft:GetPropertyChangedSignal("Text"), function()
			if not self.refreshing then
				store:setDraft(id, self.draft.Text)
				self:updateButtons()
			end
		end)
	end
	Theme.connect(self, self.widget:GetPropertyChangedSignal("Enabled"), function()
		if not self.refreshing then store:setVisible(id, self.widget.Enabled) end
	end)
	Theme.connect(self, self.root:GetPropertyChangedSignal("AbsoluteSize"), function() self:layout() end)
	Theme.connect(self, self.header:GetPropertyChangedSignal("AbsoluteSize"), function() self:layout() end)
	Theme.connect(self, self.composer:GetPropertyChangedSignal("AbsoluteSize"), function() self:layout() end)
	Theme.connect(self, self.confirm:GetPropertyChangedSignal("AbsoluteSize"), function() self:layout() end)
	Theme.connect(self, self.chat:GetPropertyChangedSignal("CanvasPosition"), function()
		local content = self.chatLayout.AbsoluteContentSize.Y
		self.followChat = self.chat.CanvasPosition.Y &gt;= math.max(0, content - self.chat.AbsoluteWindowSize.Y) - FOLLOW_SLACK
	end)
	Theme.connect(self, self.chatLayout:GetPropertyChangedSignal("AbsoluteContentSize"), function() self:follow() end)
end

-- Fluxul urmărește capătul doar dacă utilizatorul era deja acolo (§13).
function SessionView:follow()
	if self.destroyed or not self.followChat then return end
	local content = self.chatLayout.AbsoluteContentSize.Y
	self.chat.CanvasPosition = Vector2.new(0, math.max(0, content - self.chat.AbsoluteWindowSize.Y + GAP))
end

-- Împarte fereastra: antet (auto), flux, composer/confirmare (auto), cu câte o linie de 1 px între ele.
function SessionView:layout()
	if self.destroyed then return end
	local headerHeight = math.max(1, self.header.AbsoluteSize.Y)
	self.headerLine.Position = UDim2.new(0, 0, 0, headerHeight)
	local footer = if self.confirm.Visible then self.confirm elseif self.composer.Visible then self.composer else nil
	local footerHeight = if footer then footer.AbsoluteSize.Y else 0
	self.footerLine.Visible = footer ~= nil
	self.footerLine.Position = UDim2.new(0, 0, 1, -(footerHeight + 1))
	local area = self.root.AbsoluteSize.Y - headerHeight - 1 - (if footer then footerHeight + 1 else 0)
	local bodyHeight = math.max(140, area - PAD * 2)
	self.body.Position = UDim2.fromOffset(PAD, headerHeight + 1 + PAD)
	self.body.Size = UDim2.new(1, -PAD * 2, 0, bodyHeight)
	local window = self.store.windows[self.id]
	local approvals = if window then #window.approvals else 0
	if self.remote or approvals == 0 then
		self.chat.Position, self.chat.Size = UDim2.fromOffset(0, 0), UDim2.fromScale(1, 1)
	elseif self.root.AbsoluteSize.X &gt;= SPLIT_WIDTH then
		self.chat.Position, self.chat.Size = UDim2.fromOffset(0, 0), UDim2.new(0.5, -GAP, 1, 0)
		self.approval.root.Position = UDim2.new(0.5, GAP, 0, 0)
		self.approval.root.Size = UDim2.new(0.5, -GAP, 1, 0)
	else
		-- Sub 820 px: 30 % flux / 70 % aprobare, dar cardul primește cel puțin cât îi trebuie ca să-și arate butoanele.
		local available = math.max(0, bodyHeight - PAD)
		local approvalHeight = math.min(math.max(math.floor(available * 0.7), MIN_APPROVAL), math.max(0, available - MIN_FLOW))
		local chatHeight = math.max(0, available - approvalHeight)
		self.chat.Position, self.chat.Size = UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, chatHeight)
		self.approval.root.Position = UDim2.fromOffset(0, chatHeight + PAD)
		self.approval.root.Size = UDim2.new(1, 0, 0, approvalHeight)
	end
end

-- Avatarul proprietarului se reconstruiește doar când se schimbă contul (poll-ul nu trebuie să clipească).
function SessionView:setAvatar(owner)
	local key = tostring(if owner then owner.userId or 0 else 0) .. "|" .. tostring(if owner then owner.name or "" else "")
	if self.avatarKey == key then return end
	self.avatarKey = key
	if self.avatar then self.avatar:Destroy() end
	self.avatar = Theme.avatar(self.ownerRow, owner, { size = 16 })
	self.avatar.Position = UDim2.new(0, 0, 0.5, -8)
end

function SessionView:updateButtons()
	local window = self.store.windows[self.id]
	if self.destroyed or not window then return end
	local store = self.store
	if self.stop then
		self.stop.Text = if window.cancelling then Theme.TRANSIENT.cancelling else "Oprește"
		Theme.enabled(self.stop, store.connected and window.job ~= nil and not window.cancelling)
	end
	if self.release then
		self.release.Text = if window.releasing then Theme.TRANSIENT.releasing else "Eliberează claims"
		Theme.enabled(self.release, store.connected and not store.connecting and window.job ~= nil
			and #window.claims &gt; 0 and not window.releasing)
	end
	if self.newButton then Theme.enabled(self.newButton, #store.order &lt; store.MAX_WINDOWS) end
	if self.terminal or self.remote then return end
	local allowed, reason = store:canSend(window)
	local request = window.request
	local uncertain = request ~= nil and request.state == "uncertain"
	if request ~= nil and request.state == "sending" then
		self.send.Text = "Se trimite…"
		Theme.enabled(self.send, false)
	elseif uncertain then
		self.send.Text = "Reia aceeași cerere"
		Theme.enabled(self.send, self.controller:canRetry(window))
	else
		self.send.Text = "Trimite"
		Theme.enabled(self.send, allowed and string.find(window.draft, "%S") ~= nil)
	end
	self.hint.Text = if window.cancelling then "Anulare în curs, doar pentru acest job."
		elseif window.state == "queued" then "În coadă. Daemon-ul lucrează pe rând."
		elseif uncertain then "Fără retry automat; reluarea cere confirmare."
		elseif allowed then "Doar această sesiune. Modificările cer claim și aprobare."
		else reason or "Doar această sesiune. Modificările cer claim și aprobare."
end

-- Antetul: titlu, chip-uri, proprietar și claims, recalculate la fiecare poll fără să recreeze instanțe.
function SessionView:updateHeader(window)
	local store = self.store
	if not self.title:IsFocused() and self.title.Text ~= window.name then self.title.Text = window.name end
	local _, label, role = Theme.sessionState(window)
	if self.stateChip.Text ~= label then self.stateChip.Text = label end
	if self.stateRole ~= role then
		self.stateRole = role
		Theme.recolor(self.stateChip, role)
	end
	local owner = window.owner or (if self.remote then nil else store:ownIdentity())
	self:setAvatar(owner)
	local target
	if self.remote then
		target = if owner and type(owner.machine) == "string" and owner.machine ~= "" then Theme.fit(owner.machine, 24) else "altă mașină"
	elseif window.studioId then
		target = Theme.fit(window.studioName or "Studio", 32) .. " / Edit"
	elseif self.terminal then
		target = "țintă aleasă de daemon"
	end
	local meta = ownerName(window, owner) .. (if target then " · " .. target else "")
	if self.meta.Text ~= meta then self.meta.Text = meta end
	-- „Țintă nealeasă” apare ca buton ghost doar în sesiunile proprii din Studio, până când ținta este legată (§10.6).
	local showTarget = not self.terminal and not self.remote and window.studioId == nil
	self.target.Visible = showTarget
	Theme.enabled(self.target, showTarget and not window.locked and window.request == nil
		and store:studio(store.defaultStudioId) ~= nil)
	local reserved = if showTarget then 120 + GAP else 0
	self.meta.Size = UDim2.new(1, -(16 + GAP + reserved), 1, 0)
	local claims = if #window.claims &gt; 0 then "Claims: " .. table.concat(window.claims, ", ")
		else "Fără claims. Modificările cer hub_claim."
	if self.claims.Text ~= claims then self.claims.Text = claims end
	self.claims.Font = Theme.font(if #window.claims &gt; 0 then "mono" else "body")
end

-- Fluxul: o bulă per mesaj, păstrată între poll-uri (identitatea instanței ține scroll-ul pe loc).
function SessionView:updateFlow(window)
	local present = {}
	for order, message in ipairs(window.messages) do
		present[message] = true
		local view = self.messageViews[message]
		if not view then
			view = Theme.bubble(self.chat, bubbleFields(message), window.provider)
			self.messageViews[message] = view
		end
		view.root.LayoutOrder = order
		view.set(bubbleFields(message))
	end
	for message, view in pairs(self.messageViews) do
		if not present[message] then
			view.root:Destroy()
			self.messageViews[message] = nil
		end
	end
	self.empty.root.Visible = #window.messages == 0
end

function SessionView:update()
	if self.destroyed then return end
	local window = self.store.windows[self.id]
	if not window then return end
	local store = self.store
	self.refreshing = true
	if self.restoreVersion ~= window.restoreVersion then
		self.restoreVersion = window.restoreVersion
		self.widget.Enabled = false
	end
	self.widget.Enabled, self.widget.Title = window.visible, window.name
	if self.draft and self.draft.Text ~= window.draft and not self.draft:IsFocused() then self.draft.Text = window.draft end
	self:updateHeader(window)
	self:updateFlow(window)
	self.approval:update(window, store.connected and store.compatible and not self.remote)
	if self.remote then self.approval.root.Visible = false end
	local confirming = not self.terminal and (window.closeConfirm or self.retryConfirm)
	self.confirm.Visible = confirming
	self.composer.Visible = not confirming and not self.remote
	if confirming then
		local text, closing
		if self.retryConfirm then
			text, closing = "Reiei exact mesajul original, cu același ID. Daemon-ul deduplică cererea; dacă prima încercare nu a ajuns, o va trimite acum. Draftul nou nu este trimis.", false
			self.confirmRetry.Text = "Reia aceeași cerere"
			Theme.enabled(self.confirmRetry, self.controller:canRetry(window))
		elseif window.job or window.request then
			text, closing = "Închizi definitiv această fereastră? Jobul ei trebuie anulat înainte de ștergere. Celelalte sesiuni rămân active.", true
			self.confirmClose.Text = "Anulează și închide"
			Theme.enabled(self.confirmClose, not window.cancelling)
		else
			text, closing = "Închizi definitiv această fereastră și istoricul ei local? Folosește Minimizează dacă vrei să revii.", true
			self.confirmClose.Text = "Închide definitiv"
			Theme.enabled(self.confirmClose, true)
		end
		self.confirmClose.Visible, self.confirmRetry.Visible = closing, not closing
		if self.confirmText ~= text then
			self.confirmText = text
			self.confirmBanner.show("warning", text)
		end
	elseif self.confirmText ~= nil then
		self.confirmText = nil
		self.confirmBanner.hide()
	end
	self:updateButtons()
	self:layout()
	self.refreshing = false
end

-- `permanent` este adevărat doar când fereastra dispare din store (sesiune închisă de utilizator): atunci id-ul nu se mai
-- repetă și panoul poate fi distrus. La oprirea aplicației (Play, metamorfoză) panoul rămâne, altfel `CreateDockWidgetPluginGuiAsync`
-- ar întoarce mai târziu un panou distrus pentru aceeași sesiune, iar fereastra nu s-ar mai deschide.
function SessionView:destroy(permanent)
	Theme.cleanup(self)
	self.approval:destroy()
	if permanent then
		self.widget:Destroy()
	else
		if self.root then pcall(function() self.root:Destroy() end) end
		self.root = nil
	end
end

return SessionView
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX11">
        <Properties>
          <string name="Name">Theme</string>
          <ProtectedString name="Source">-- Studio Harness Theme 1.0.0 — sistemul de design al pluginului (design/DESIGN.md §2–§8).
-- Nivelul de modul nu atinge globale Roblox (Color3, Enum, Instance, UDim2, settings, TweenService):
-- datele și funcțiile pure rulează în luau.exe (tests/Theme.spec.luau). Tot ce creează instanțe stă în funcții.
local Theme = {}
Theme.VERSION = "1.0.0"

-- 1. Date -----------------------------------------------------------------------------------------------------------

-- Paleta completă (DESIGN.md §2.5): cele două moduri au exact același set de chei, verificat în spec.
Theme.PALETTES = {
	dark = { bg = "#0B0F14", surface = "#121821", raised = "#1A2230", border = "#26303F", borderStrong = "#3A4657",
		borderInput = "#66768C", text = "#E6EDF3", text2 = "#8B98A9", text3 = "#6B7A8F", focus = "#60A5FA",
		primary = "#4ADE80", primaryText = "#4ADE80", primaryMark = "#4ADE80", primarySoft = "#1A342E",
		primaryHover = "#5CE58F", primaryActive = "#6FEB9C", onPrimary = "#06210F", completedMark = "#35895A",
		info = "#60A5FA", infoText = "#60A5FA", infoMark = "#60A5FA", infoSoft = "#1D2C3F",
		warning = "#FBBF24", warningText = "#FBBF24", warningMark = "#FBBF24", warningSoft = "#332F21",
		danger = "#F87171", dangerText = "#F87171", dangerMark = "#F87171", dangerSoft = "#32242C",
		claude = "#D97757", claudeText = "#D97757", claudeMark = "#D97757", claudeSoft = "#2E2529",
		codex = "#10A37F", codexText = "#22B38C", codexMark = "#10A37F", codexSoft = "#122B2E",
		neutral = "#8B98A9", neutralText = "#8B98A9", neutralMark = "#6B7A8F", neutralSoft = "#232A34" },
	light = { bg = "#F6F8FA", surface = "#FFFFFF", raised = "#F0F3F7", border = "#D6DCE5", borderStrong = "#B8C2CF",
		borderInput = "#7B8797", text = "#0F172A", text2 = "#5B6675", text3 = "#7B8797", focus = "#1D4ED8",
		primary = "#4ADE80", primaryText = "#166534", primaryMark = "#15803D", primarySoft = "#E6FAED",
		primaryHover = "#3ED474", primaryActive = "#34C96A", onPrimary = "#06210F", completedMark = "#3F8F5E",
		info = "#60A5FA", infoText = "#1D4ED8", infoMark = "#2563EB", infoSoft = "#E9F2FE",
		warning = "#FBBF24", warningText = "#92400E", warningMark = "#B45309", warningSoft = "#FEF6E0",
		danger = "#F87171", dangerText = "#B91C1C", dangerMark = "#DC2626", dangerSoft = "#FEEBEB",
		claude = "#D97757", claudeText = "#9A4322", claudeMark = "#C4643F", claudeSoft = "#FAECE7",
		codex = "#10A37F", codexText = "#0B7A5F", codexMark = "#0B7A5F", codexSoft = "#DEF2ED",
		neutral = "#8B98A9", neutralText = "#5B6675", neutralMark = "#6B7A8F", neutralSoft = "#EFF1F3" },
}
Theme.SPACE = { xs = 4, sm = 8, md = 12, lg = 16, xl = 24 }
Theme.RADIUS = { control = 6, card = 10, pill = 999 }
Theme.TEXT = { xs = 12, sm = 13, md = 14, lg = 16, xl = 20 }
Theme.FONT_NAMES = { ui = "GothamMedium", body = "Gotham", mono = "Code" } -- rezolvate în Enum.Font de apply()
Theme.ROLES = { "neutral", "primary", "info", "warning", "danger", "claude", "codex", "completed" }
Theme.names = { claude = "Claude Code", codex = "Codex" }
Theme.kinds = { studio = "Studio", terminal = "Terminal" }
Theme.states = { draft = "Draft", sending = "Se trimite", uncertain = "Trimitere neconfirmată", queued = "În coadă",
	running = "În lucru", waiting_approval = "Cere aprobare", completed = "Finalizat", failed = "Eroare",
	cancelled = "Oprit", lost = "Job indisponibil" }
Theme.SESSION_ROLE = { draft = "neutral", sending = "info", uncertain = "warning", queued = "info", running = "primary",
	waiting_approval = "warning", completed = "completed", failed = "danger", cancelled = "neutral", lost = "danger" }
Theme.hubStates = { connecting = "Se conectează", pending = "Așteaptă aprobarea", approved = "Hub conectat",
	offline = "Hub offline", revoked = "Acces revocat", disabled = "Hub dezactivat" }
Theme.HUB_ROLE = { connecting = "neutral", pending = "warning", approved = "primary", offline = "danger",
	revoked = "danger", disabled = "neutral" }
Theme.MESSAGE_ROLE = { text = "neutral", assistant = "neutral", tool = "info", claim = "warning", approval = "warning",
	error = "danger", notice = "neutral" }
-- Etichete tranzitorii ale unei ferestre (DESIGN.md §6.1): nu sunt stări, doar texte peste starea curentă.
Theme.TRANSIENT = { cancelling = "Se oprește", releasing = "Eliberez claims" }
-- Textul stării hub-ului „versiune veche” (identic cu `Store.OLD_HUB_ERROR`, fără require de SessionStore).
Theme.OLD_HUB_ERROR = "Hub-ul rulează o versiune mai veche."

-- Modul curent și tabelele construite de `apply` (goale până la primul apel; niciun Color3 la nivel de modul).
Theme.mode = "dark"
Theme.colors = {}
Theme.fonts = {}

local ROLE_SET = {}
for _, role in ipairs(Theme.ROLES) do ROLE_SET[role] = true end
local AVATAR_SIZES = { [48] = true, [60] = true, [100] = true, [150] = true }
local BUTTON_HEIGHT = { sm = 28, md = 32, lg = 36 }
local BUTTON_TEXT = { sm = "sm", md = "md", lg = "md" }
local MORE_WIDTH = 34 -- lățimea rezervată chip-ului „+N” din rândul de prezență
local BUTTON_NARROW = 96 -- sub această lățime dată explicit, butonul primește padding mic (§7.5)
local CLOSE_WIDTH = 28 -- lățimea butonului „×” din colțul bannerului (§7.9)
-- Majusculele care lipsesc din `string.upper` (care lucrează pe octeți): diacriticele românești și vecinii lor.
local UPPER = { ["ă"] = "Ă", ["â"] = "Â", ["î"] = "Î", ["ș"] = "Ș", ["ț"] = "Ț", ["ş"] = "Ş", ["ţ"] = "Ţ",
	["á"] = "Á", ["à"] = "À", ["é"] = "É", ["è"] = "È", ["í"] = "Í", ["ó"] = "Ó", ["ö"] = "Ö", ["ú"] = "Ú",
	["ü"] = "Ü", ["ä"] = "Ä", ["ç"] = "Ç", ["ñ"] = "Ñ", ["ø"] = "Ø", ["å"] = "Å" }

-- 2. Funcții pure ---------------------------------------------------------------------------------------------------

-- Tăiere sigură pe octeți: nu lasă un caracter UTF-8 rupt la capăt (aceeași regulă ca `Store.prefix`).
local function cut(text, limit)
	if #text &lt;= limit then return text end
	local stop = limit
	while stop &gt; 0 do
		local byte = string.byte(text, stop + 1)
		if not byte or byte &lt; 128 or byte &gt;= 192 then break end
		stop -= 1
	end
	return string.sub(text, 1, stop)
end

-- Primele `count` caractere UTF-8 ale unui text (fără să taie un caracter la jumătate).
local function firstChars(text, count)
	local ok, stop = pcall(utf8.offset, text, count + 1)
	if ok and stop then return string.sub(text, 1, stop - 1) end
	return text
end

-- Majuscula unui singur caracter (ASCII prin `string.upper`, diacriticele din tabel).
local function upperChar(character)
	return UPPER[character] or (string.upper(character))
end

local function luminanceChannel(value)
	value /= 255
	if value &lt;= 0.03928 then return value / 12.92 end
	return ((value + 0.055) / 1.055) ^ 2.4
end

local function luminance(hex)
	local text = (string.gsub(tostring(hex or ""), "^#", ""))
	local red = tonumber(string.sub(text, 1, 2), 16) or 0
	local green = tonumber(string.sub(text, 3, 4), 16) or 0
	local blue = tonumber(string.sub(text, 5, 6), 16) or 0
	return 0.2126 * luminanceChannel(red) + 0.7152 * luminanceChannel(green) + 0.0722 * luminanceChannel(blue)
end

-- Numele temei Studio → modul paletei: doar „Dark” (indiferent de majuscule) este întuneric.
function Theme.resolveMode(themeName)
	if type(themeName) == "string" and string.lower(themeName) == "dark" then return "dark" end
	return "light"
end

-- Hex-ul unui token în modul cerut (implicit modul curent); un nume greșit iese în spec, nu în Studio.
function Theme.token(name, mode)
	local palette = Theme.PALETTES[mode] or Theme.PALETTES[Theme.mode] or Theme.PALETTES.dark
	local value = palette[name]
	if not value then error("Token necunoscut: " .. tostring(name), 2) end
	return value
end

-- Cele patru fețe ale unui rol, ca nume de token-uri (DESIGN.md §2.3); rolul necunoscut devine `neutral`.
function Theme.roleTokens(role)
	if role == "completed" then return { fill = "primary", text = "text2", mark = "completedMark", soft = "neutralSoft" } end
	if type(role) ~= "string" or not ROLE_SET[role] then role = "neutral" end
	return { fill = role, text = role .. "Text", mark = role .. "Mark", soft = role .. "Soft" }
end

-- Raportul de contrast WCAG 2.1 dintre două culori hex (≥ 1); spec-ul impune pragurile din §2.
function Theme.contrastRatio(hexA, hexB)
	local first, second = luminance(hexA), luminance(hexB)
	if first &lt; second then first, second = second, first end
	return (first + 0.05) / (second + 0.05)
end

-- Timpul scurs, pe scara cerută de interfață: „de 4 s”, „de 3 min”, „de 2 h”, „de 3 zile”.
function Theme.elapsed(since, now)
	if type(since) ~= "number" then return "" end
	local current = if type(now) == "number" then now else os.time()
	local seconds = math.max(0, math.floor(current) - math.floor(since))
	if seconds &lt; 60 then return "de " .. seconds .. " s" end
	if seconds &lt; 3600 then return "de " .. math.floor(seconds / 60) .. " min" end
	if seconds &lt; 86400 then return "de " .. math.floor(seconds / 3600) .. " h" end
	local days = math.floor(seconds / 86400)
	return if days == 1 then "de 1 zi" else "de " .. days .. " zile"
end

-- Ora unui moment („14:02”); fără moment, cratimele ocupă același loc.
function Theme.clock(at)
	if type(at) ~= "number" then return "--:--" end
	local ok, text = pcall(os.date, "%H:%M", math.floor(at))
	return if ok and type(text) == "string" then text else "--:--"
end

-- Inițialele unui nume, pentru avatarul fără imagine: „Ana Maria” → „AM”, „ellob” → „EL”, lipsă → „?”.
function Theme.initials(name)
	local text = if type(name) == "string" then name else ""
	local words = {}
	for word in string.gmatch(text, "%S+") do
		table.insert(words, word)
		if #words == 2 then break end
	end
	if #words == 0 then return "?" end
	if #words == 2 then return upperChar(firstChars(words[1], 1)) .. upperChar(firstChars(words[2], 1)) end
	local first = firstChars(words[1], 1)
	local both = firstChars(words[1], 2)
	if both == first then return upperChar(first) end
	return upperChar(first) .. upperChar(string.sub(both, #first + 1))
end

-- Prefixul unui identificator lung (device_id la 8, job_id la 12); lipsă → „—”.
function Theme.shortId(id, length)
	local text = if type(id) == "string" then id else ""
	if text == "" then return "—" end
	return cut(text, if type(length) == "number" and length &gt; 0 then math.floor(length) else 8)
end

-- URL-ul imaginii de profil Roblox; fără cont cunoscut nu există imagine (avatarul arată inițialele).
function Theme.avatarUrl(userId, size)
	local id = if type(userId) == "number" then math.floor(userId) else nil
	if not id or id &lt;= 0 then return nil end
	local pixels = if type(size) == "number" and AVATAR_SIZES[math.floor(size)] then math.floor(size) else 48
	return "rbxthumb://type=AvatarHeadShot&amp;id=" .. id .. "&amp;w=" .. pixels .. "&amp;h=" .. pixels
end

-- Text scurtat la `limit` octeți, cu „…” când a fost tăiat; tăierea nu rupe niciodată un caracter UTF-8.
function Theme.fit(text, limit)
	local value = if type(text) == "string" then text else ""
	local stop = if type(limit) == "number" and limit &gt; 0 then math.floor(limit) else 0
	if #value &lt;= stop then return value end
	return cut(value, stop) .. "…"
end

-- Pluralul românesc al unui contor: „1 sesiune”, „3 sesiuni”, „20 de sesiuni”.
function Theme.countLabel(n, singular, plural)
	local count = if type(n) == "number" then math.floor(n) else 0
	if count == 1 then return "1 " .. singular end
	local rest = math.abs(count) % 100
	if math.abs(count) &gt;= 20 and (rest == 0 or rest &gt;= 20) then return count .. " de " .. plural end
	return count .. " " .. plural
end

-- Starea afișată a unei ferestre: cheia, eticheta din §6.1 și rolul de culoare.
function Theme.sessionState(window)
	local data = if type(window) == "table" then window else {}
	local key = if type(data.state) == "string" and data.state ~= "" then data.state else "draft"
	local approvals = if type(data.approvals) == "table" then #data.approvals else 0
	if approvals &gt; 0 or data.pendingApproval then key = "waiting_approval" end
	local label, role = Theme.states[key], Theme.SESSION_ROLE[key]
	if not label then label, role = key, "neutral" end
	if data.cancelling then label = Theme.TRANSIENT.cancelling
	elseif data.releasing then label = Theme.TRANSIENT.releasing end
	return key, label, role or "neutral"
end

-- Rolul de culoare al unei bule din flux; răspunsul agentului poartă culoarea providerului.
function Theme.messageRole(kind, provider)
	if kind == "assistant" and (provider == "claude" or provider == "codex") then return provider end
	return Theme.MESSAGE_ROLE[kind] or "neutral"
end

-- Meta-linia workspace-ului: „place 1291603 · al tău” / „· grup 555” / „· utilizator 555”.
function Theme.placeLine(workspace, identity)
	if type(workspace) ~= "table" then return "Fișier nepublicat" end
	local key = if type(workspace.key) == "string" and workspace.key ~= "" then workspace.key else nil
	if not key or key == "local" then return "Fișier nepublicat" end
	local placeId = math.floor(tonumber(workspace.placeId) or 0)
	local head = if placeId &gt; 0 then "place " .. placeId else key
	local creatorId = math.floor(tonumber(workspace.creatorId) or 0)
	if creatorId &lt;= 0 then return head end
	local userId = if type(identity) == "table" then math.floor(tonumber(identity.userId) or 0) else 0
	if userId &gt; 0 and creatorId == userId then return head .. " · al tău" end
	if workspace.creatorType == "Group" then return head .. " · grup " .. creatorId end
	return head .. " · utilizator " .. creatorId
end

-- Textul complet al stării hub-ului pentru banner/subsol (DESIGN.md §6.2, §12.2) și rolul lui de culoare.
function Theme.hubLine(hub)
	local data = if type(hub) == "table" then hub else {}
	local status = data.status
	if status == "approved" then return "Hub conectat", "primary" end
	if status == "pending" then
		return "Așteaptă aprobarea adminului · dispozitiv " .. Theme.shortId(data.deviceId), "warning"
	end
	if status == "offline" then
		local reason = if type(data.error) == "string" and data.error ~= "" then data.error else "hub-ul nu răspunde"
		if string.sub(reason, 1, #Theme.OLD_HUB_ERROR) == Theme.OLD_HUB_ERROR then
			return "Hub-ul rulează o versiune mai veche. Actualizează hub-ul ca să apari în workspace.", "danger"
		end
		reason = (string.gsub(cut(reason, 80), "[%.%s]+$", ""))
		return "Hub offline: " .. reason .. ". Sesiunile tale merg local; claims-urile sunt doar locale până revine.", "danger"
	end
	if status == "revoked" then return "Accesul acestui dispozitiv a fost revocat. Cere adminului să-l aprobe din nou.", "danger" end
	if status == "disabled" then return "Hub dezactivat (daemon pornit cu --no-hub).", "neutral" end
	return "Se conectează la hub…", "neutral"
end

-- Geometria textului unui buton (§3.3, §7.5): o lățime fixă se trunchiază la capăt cu „…”, „auto” își urmează textul.
-- Padding-ul lateral este 12, dar un buton îngust dat explicit (ex. „×” de 28 px) primește 4, ca textul să încapă.
function Theme.buttonText(auto, fixedWidth)
	if auto == true then return false, Theme.SPACE.md end
	local narrow = type(fixedWidth) == "number" and fixedWidth &gt; 0 and fixedWidth &lt; BUTTON_NARROW
	return true, (if narrow then Theme.SPACE.xs else Theme.SPACE.md)
end

-- Padding-ul din dreapta al corpului unui banner (§7.9): cu „×” în colț textul se retrage cu lățimea butonului plus
-- spațiile, altfel prima linie trece pe sub el.
function Theme.bannerPad(close)
	return if close then Theme.SPACE.md + CLOSE_WIDTH + Theme.SPACE.xs else Theme.SPACE.md
end

-- 3. Runtime: tema --------------------------------------------------------------------------------------------------

local painted = setmetatable({}, { __mode = "k" })
local tweens = setmetatable({}, { __mode = "k" })
local strokeBase = setmetatable({}, { __mode = "k" })
local tweenService = nil

-- Un token poate fi dat și pe moduri (`{ dark = "bg", light = "surface" }`): se rezolvă la fiecare repictare.
local function tokenName(value)
	if type(value) == "table" then return value[Theme.mode] or value.dark or value.light end
	return value
end

local function repaint(instance, roles)
	for property, value in pairs(roles) do
		local color = Theme.colors[tokenName(value)]
		if color then pcall(function() instance[property] = color end) end
	end
end

local function ensureColors()
	if next(Theme.colors) == nil then Theme.apply(Theme.mode) end
end

-- Construiește culorile și fonturile modului și repictează tot ce a trecut prin `paint`. Idempotent.
function Theme.apply(mode)
	local palette = Theme.PALETTES[mode]
	if not palette then mode, palette = "dark", Theme.PALETTES.dark end
	Theme.mode = mode
	local colors = {}
	for name, hex in pairs(palette) do colors[name] = Color3.fromHex(hex) end
	Theme.colors = colors
	Theme.fonts = { ui = Enum.Font[Theme.FONT_NAMES.ui], body = Enum.Font[Theme.FONT_NAMES.body], mono = Enum.Font[Theme.FONT_NAMES.mono] }
	for instance, roles in pairs(painted) do repaint(instance, roles) end
	return mode
end

-- Culoarea unui token în modul curent; token necunoscut = greșeală de tastare, deci eroare.
function Theme.color(token)
	ensureColors()
	local color = Theme.colors[tokenName(token)]
	if not color then error("Token necunoscut: " .. tostring(token), 2) end
	return color
end

-- Fontul cerut („ui”, „body”, „mono”); fonturile nu depind de mod, dar se construiesc odată cu paleta.
function Theme.font(name)
	ensureColors()
	return Theme.fonts[name or "body"] or Theme.fonts.body
end

-- Leagă proprietățile de culoare ale unei instanțe de token-uri; `apply` le repictează pe toate la schimbarea temei.
function Theme.paint(instance, roles)
	ensureColors()
	local mapping = painted[instance]
	if not mapping then
		mapping = {}
		painted[instance] = mapping
	end
	for property, value in pairs(roles) do
		Theme.color(value) -- validează numele token-ului acum, nu abia la schimbarea temei
		mapping[property] = value
	end
	repaint(instance, mapping)
	return instance
end

local RECOLOR = {
	chip = { BackgroundColor3 = "soft", TextColor3 = "text" },
	dot = { BackgroundColor3 = "mark" },
	rail = { BackgroundColor3 = "mark" },
	banner = { BackgroundColor3 = "soft" },
	bubble = { BackgroundColor3 = "soft" },
	roleText = { TextColor3 = "text" },
	underline = { BackgroundColor3 = "mark" },
}

-- Schimbă rolul unei componente deja construite (șină, chip, punct, banner, bulă) fără să o recreeze.
function Theme.recolor(instance, role)
	instance:SetAttribute("Role", role)
	local map = RECOLOR[instance:GetAttribute("Component")]
	if not map then return instance end
	local tokens = Theme.roleTokens(role)
	local roles = {}
	for property, field in pairs(map) do roles[property] = tokens[field] end
	return Theme.paint(instance, roles)
end

-- Mișcarea din §13: 140 ms, Quad Out, doar culori și transparențe; tween-ul anterior al instanței se anulează.
function Theme.tween(instance, properties, seconds)
	if not tweenService then tweenService = game:GetService("TweenService") end
	local previous = tweens[instance]
	if previous then pcall(function() previous:Cancel() end) end
	local tween = tweenService:Create(instance, TweenInfo.new(seconds or 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), properties)
	tweens[instance] = tween
	tween:Play()
	return tween
end

-- Hover și apăsat pentru un buton sau un card; conectat pe instanță, deci `Destroy()` deconectează.
function Theme.hover(button, tokens)
	local hovering, pressed = false, false
	local function refresh()
		if button:GetAttribute("EnabledAction") == false then return end
		local active = hovering or pressed
		local goal = {}
		local background = tokens.normal
		if pressed and tokens.pressed then background = tokens.pressed
		elseif active and tokens.hover then background = tokens.hover end
		if background then goal.BackgroundColor3 = Theme.color(background) end
		local fade = if active then tokens.fadeHover else tokens.fadeNormal
		if fade then goal.BackgroundTransparency = fade end
		local textToken = if active then (tokens.textHover or tokens.textNormal) else (tokens.textNormal or tokens.textHover)
		if textToken then goal.TextColor3 = Theme.color(textToken) end
		if next(goal) then Theme.tween(button, goal) end
		if tokens.stroke then
			local strokeToken = if active then (tokens.strokeHover or tokens.strokeNormal) else (tokens.strokeNormal or tokens.strokeHover)
			if strokeToken then Theme.tween(tokens.stroke, { Color = Theme.color(strokeToken) }) end
		end
	end
	button.MouseEnter:Connect(function() hovering = true; refresh() end)
	button.MouseLeave:Connect(function() hovering, pressed = false, false; refresh() end)
	button.MouseButton1Down:Connect(function() pressed = true; refresh() end)
	button.MouseButton1Up:Connect(function() pressed = false; refresh() end)
end

-- Inelul de focus al unui câmp text (§5): conturul devine `focus` de 2 px cât timp se tastează.
function Theme.focusRing(textBox, stroke)
	textBox.Focused:Connect(function()
		Theme.paint(stroke, { Color = "focus" })
		stroke.Thickness = 2
	end)
	textBox.FocusLost:Connect(function()
		Theme.paint(stroke, { Color = "borderInput" })
		stroke.Thickness = 1
	end)
end

-- Activarea unui buton: `EnabledAction` filtrează click-urile, iar dezactivarea este opacitate, nu altă culoare.
function Theme.enabled(button, allowed)
	local ok = allowed == true
	button:SetAttribute("EnabledAction", ok)
	button.Active, button.Selectable = ok, ok
	button.TextTransparency = if ok then 0 else 0.45
	local stroke = button:FindFirstChildWhichIsA("UIStroke")
	if stroke then stroke.Transparency = if ok then (strokeBase[stroke] or 0) else 0.45 end
	if button:GetAttribute("Kind") == "primary" then button.BackgroundTransparency = if ok then 0 else 0.45 end
end

-- 4. Runtime: legături ----------------------------------------------------------------------------------------------

function Theme.connect(owner, signal, callback)
	local connection = signal:Connect(function(...)
		if not owner.destroyed then callback(...) end
	end)
	table.insert(owner.connections, connection)
	return connection
end

function Theme.click(owner, button, callback)
	Theme.enabled(button, true)
	return Theme.connect(owner, button.Activated, function()
		if button:GetAttribute("EnabledAction") then callback() end
	end)
end

function Theme.cleanup(owner)
	owner.destroyed = true
	for _, connection in ipairs(owner.connections) do connection:Disconnect() end
	table.clear(owner.connections)
end

-- Citește tema Studio, o aplică și se reabonează la `ThemeChanged`; `Main` îl apelează o dată, înaintea view-urilor.
function Theme.install(owner, onChange)
	local function currentMode()
		local ok, name = pcall(function() return settings().Studio.Theme.Name end)
		if not ok then return "dark" end
		return Theme.resolveMode(name)
	end
	local mode = Theme.apply(currentMode())
	local ok, studio = pcall(function() return settings().Studio end)
	if ok and studio then
		Theme.connect(owner, studio.ThemeChanged, function()
			local applied = Theme.apply(currentMode())
			if onChange then onChange(applied) end
		end)
	end
	return mode
end

-- 5. Runtime: constructori de bază ----------------------------------------------------------------------------------

local ALIGN = nil -- construit la prima folosire: Enum nu se atinge la nivel de modul.
local function alignment(name)
	if not ALIGN then
		ALIGN = { left = Enum.TextXAlignment.Left, center = Enum.TextXAlignment.Center, right = Enum.TextXAlignment.Right }
	end
	return ALIGN[name or "left"] or ALIGN.left
end

function Theme.new(className, properties, parent)
	local instance = Instance.new(className)
	for property, value in pairs(properties or {}) do instance[property] = value end
	instance.Parent = parent
	return instance
end

function Theme.frame(parent, name, token)
	local frame = Theme.new("Frame", { Name = name or "Frame", Size = UDim2.fromScale(1, 1), BorderSizePixel = 0 }, parent)
	if token == "transparent" then
		frame.BackgroundTransparency = 1
	else
		Theme.paint(frame, { BackgroundColor3 = token or "bg" })
	end
	return frame
end

function Theme.padding(parent, x, y)
	local horizontal, vertical = x or 0, y or x or 0
	return Theme.new("UIPadding", { PaddingLeft = UDim.new(0, horizontal), PaddingRight = UDim.new(0, horizontal),
		PaddingTop = UDim.new(0, vertical), PaddingBottom = UDim.new(0, vertical) }, parent)
end

function Theme.list(parent, gap, horizontal)
	local layout = Theme.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, gap or Theme.SPACE.sm) }, parent)
	if horizontal then
		layout.FillDirection = Enum.FillDirection.Horizontal
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
	end
	return layout
end

function Theme.stroke(parent, token, thickness)
	local stroke = Theme.new("UIStroke", { Thickness = thickness or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, parent)
	Theme.paint(stroke, { Color = token or "border" })
	strokeBase[stroke] = 0
	return stroke
end

function Theme.corner(parent, radius)
	local value = if type(radius) == "number" then radius else (Theme.RADIUS[radius] or Theme.RADIUS.control)
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, value) }, parent)
end

function Theme.spacer(parent, height)
	return Theme.new("Frame", { Name = "Spacer", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height or Theme.SPACE.sm) }, parent)
end

function Theme.label(parent, text, options)
	local config = options or {}
	local size = config.size or "md"
	local textSize = if type(size) == "number" then size else (Theme.TEXT[size] or Theme.TEXT.md)
	local height = config.height
	local truncate = config.truncate == true
	local label = Theme.new("TextLabel", { Name = config.name or "Label", BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height or 0), AutomaticSize = if height then Enum.AutomaticSize.None else Enum.AutomaticSize.Y,
		Text = if type(text) == "string" then text else "", TextSize = textSize, RichText = false,
		TextWrapped = not truncate and config.wrap ~= false,
		TextTruncate = if truncate then Enum.TextTruncate.AtEnd else Enum.TextTruncate.None,
		TextXAlignment = alignment(config.align),
		TextYAlignment = if height then Enum.TextYAlignment.Center else Enum.TextYAlignment.Top }, parent)
	label.Font = Theme.font(config.font)
	Theme.paint(label, { TextColor3 = config.token or "text" })
	return label
end

-- Câmpul text (o linie sau mai multe): fundal `bg` în dark și `surface` în light, contur cu inel de focus.
local function textBox(parent, options, multiline)
	local config = options or {}
	local height = config.height or (if multiline then 72 else 32)
	local box = Theme.new("TextBox", { Name = config.name or (if multiline then "Textarea" else "Input"),
		Size = UDim2.new(1, 0, 0, height), BorderSizePixel = 0, Text = "", PlaceholderText = config.placeholder or "",
		TextSize = Theme.TEXT.md, RichText = false, ClearTextOnFocus = false, MultiLine = multiline == true,
		TextWrapped = multiline == true, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = if multiline then Enum.TextYAlignment.Top else Enum.TextYAlignment.Center }, parent)
	box.Font = if config.mono then Theme.font("mono") else Theme.font("body")
	Theme.paint(box, { BackgroundColor3 = { dark = "bg", light = "surface" }, TextColor3 = "text", PlaceholderColor3 = "text2" })
	Theme.corner(box, "control")
	Theme.padding(box, 10, if multiline then 8 else 0)
	Theme.focusRing(box, Theme.stroke(box, "borderInput"))
	return box
end

function Theme.input(parent, options)
	return textBox(parent, options, false)
end

function Theme.textarea(parent, options)
	return textBox(parent, options, true)
end

function Theme.scroll(parent, name)
	local scroll = Theme.new("ScrollingFrame", { Name = name or "Scroll", Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1, BorderSizePixel = 0, CanvasSize = UDim2.fromOffset(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 4 }, parent)
	Theme.paint(scroll, { ScrollBarImageColor3 = "text3" })
	return scroll
end

-- 6. Runtime: componente --------------------------------------------------------------------------------------------

-- Card: container acționabil cu șină de stare pe stânga (§7.1).
function Theme.card(parent, options)
	local config = options or {}
	local role = config.role or "neutral"
	local padding = config.padding or Theme.SPACE.md
	local clickable = config.clickable == true
	local root
	if clickable then
		root = Theme.new("TextButton", { Name = config.name or "Card", Text = "", RichText = false, AutoButtonColor = false, Selectable = true,
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BorderSizePixel = 0, ClipsDescendants = true }, parent)
		root.TextSize = Theme.TEXT.md
		root.Font = Theme.font("body")
	else
		root = Theme.new("Frame", { Name = config.name or "Card", Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y, BorderSizePixel = 0, ClipsDescendants = true }, parent)
	end
	root:SetAttribute("Component", "card")
	Theme.paint(root, { BackgroundColor3 = "surface" })
	Theme.corner(root, "card")
	local stroke = Theme.stroke(root, "border")
	local rail = Theme.new("Frame", { Name = "Rail", Size = UDim2.new(0, 3, 1, 0), BorderSizePixel = 0, ZIndex = 2 }, root)
	rail:SetAttribute("Component", "rail")
	local body = Theme.new("Frame", { Name = "Body", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, root)
	Theme.new("UIPadding", { PaddingLeft = UDim.new(0, padding + 3), PaddingRight = UDim.new(0, padding),
		PaddingTop = UDim.new(0, padding), PaddingBottom = UDim.new(0, padding) }, body)
	Theme.list(body, Theme.SPACE.xs + 2)
	local card = { root = root, rail = rail, body = body }
	function card.setRole(newRole)
		Theme.recolor(rail, newRole or "neutral")
		root:SetAttribute("Role", newRole or "neutral")
	end
	card.setRole(role)
	if clickable then
		Theme.hover(root, { normal = "surface", stroke = stroke, strokeNormal = "border", strokeHover = "borderStrong" })
	end
	return card
end

-- Chip: etichetă scurtă, statică (provider, tip, stare, contor) — nu este buton și nu are hover (§7.2).
function Theme.chip(parent, text, role)
	local chip = Theme.new("TextLabel", { Name = "Chip", Text = if type(text) == "string" then text else "",
		Size = UDim2.new(0, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.X, BorderSizePixel = 0,
		TextSize = Theme.TEXT.xs, RichText = false, TextWrapped = false,
		TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center }, parent)
	chip.Font = Theme.font("ui")
	chip:SetAttribute("Component", "chip")
	Theme.corner(chip, "control")
	Theme.new("UIPadding", { PaddingLeft = UDim.new(0, Theme.SPACE.sm), PaddingRight = UDim.new(0, Theme.SPACE.sm) }, chip)
	Theme.recolor(chip, role or "neutral")
	return chip
end

-- Punct de stare (§7.3): stă mereu lângă o etichetă text, niciodată singur.
function Theme.dot(parent, role, size)
	local pixels = size or 8
	local dot = Theme.new("Frame", { Name = "Dot", Size = UDim2.fromOffset(pixels, pixels), BorderSizePixel = 0 }, parent)
	dot:SetAttribute("Component", "dot")
	Theme.corner(dot, "pill")
	Theme.recolor(dot, role or "neutral")
	return dot
end

-- Avatar rotund cu inițialele dedesubt: dacă imaginea nu se încarcă, inițialele rămân vizibile (§7.4).
function Theme.avatar(parent, identity, options)
	local config = options or {}
	local size = config.size or 24
	local name = if type(identity) == "table" and type(identity.name) == "string" then identity.name else ""
	local root = Theme.new("Frame", { Name = "Avatar_" .. (if name ~= "" then name else "necunoscut"),
		Size = UDim2.fromOffset(size, size), BorderSizePixel = 0 }, parent)
	Theme.paint(root, { BackgroundColor3 = "raised" })
	Theme.corner(root, "pill")
	local initials = Theme.new("TextLabel", { Name = "Initials", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
		Text = Theme.initials(name), TextSize = math.max(9, math.floor(size * 0.42)), RichText = false,
		TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center }, root)
	initials.Font = Theme.font("ui")
	Theme.paint(initials, { TextColor3 = "text2" })
	local url = if type(identity) == "table" and type(identity.avatar) == "string" and identity.avatar ~= "" then identity.avatar
		else Theme.avatarUrl(if type(identity) == "table" then tonumber(identity.userId) else nil)
	if url then
		local image = Theme.new("ImageLabel", { Name = "Image", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
			Image = url, ScaleType = Enum.ScaleType.Crop, ZIndex = 2 }, root)
		Theme.corner(image, "pill")
	end
	if config.ring then
		local ring = Theme.stroke(root, "surface", 2)
		ring.ZIndex = 3
	end
	if config.offline then
		root.BackgroundTransparency = 0.45
		initials.TextTransparency = 0.45
		local image = root:FindFirstChild("Image")
		if image then image.ImageTransparency = 0.45 end
	end
	return root
end

-- Rândul de prezență: avatare suprapuse cu 6 px („tu” primul) și numele de lângă (§7.4).
function Theme.avatarRow(parent, members, options)
	local config = options or {}
	local size = config.size or 24
	local max = config.max or 6
	local root = Theme.new("Frame", { Name = config.name or "AvatarRow", BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, size) }, parent)
	local stack = Theme.new("Frame", { Name = "Stack", BackgroundTransparency = 1, Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X }, root)
	local layout = Theme.list(stack, 0, true)
	layout.Padding = UDim.new(0, -6)
	local names = Theme.label(root, "", { size = "sm", token = "text2", height = size, truncate = true, name = "Names" })
	local avatars = {}
	local row = { root = root, stack = stack, names = names }
	local function order(list)
		local sorted = {}
		for _, member in ipairs(list) do
			if type(member) == "table" then table.insert(sorted, member) end
		end
		table.sort(sorted, function(a, b)
			if (a.me == true) ~= (b.me == true) then return a.me == true end
			local onlineA, onlineB = a.online ~= false, b.online ~= false
			if onlineA ~= onlineB then return onlineA end
			-- `lastSeen` este momentul absolut al ultimei prezențe (epoch, ca în `Store.memberFrom`): cei mai recenți primii.
			local seenA = tonumber(a.lastSeen) or -math.huge
			local seenB = tonumber(b.lastSeen) or -math.huge
			if seenA ~= seenB then return seenA &gt; seenB end
			return tostring(a.name or "") &lt; tostring(b.name or "")
		end)
		return sorted
	end
	function row.set(list)
		local sorted = order(if type(list) == "table" then list else {})
		local used = {}
		local shown = 0
		for index, member in ipairs(sorted) do
			if index &gt; max then break end
			local key = if type(member.deviceId) == "string" then member.deviceId else "user:" .. tostring(member.userId)
			local avatar = avatars[key]
			if not avatar then
				avatar = Theme.avatar(stack, member, { size = size, ring = true, offline = member.online == false })
				avatars[key] = avatar
			end
			avatar.LayoutOrder = index
			used[key] = true
			shown = index
		end
		for key, avatar in pairs(avatars) do
			if not used[key] then
				avatar:Destroy()
				avatars[key] = nil
			end
		end
		-- Lățimea avatarelor suprapuse: primul întreg, restul câte `size - 6` (§1.2).
		local width = if shown &gt; 0 then size + (shown - 1) * (size - 6) else 0
		local extra = math.max(0, #sorted - shown)
		local more = root:FindFirstChild("More")
		if extra &gt; 0 then
			if not more then
				more = Theme.chip(root, "", "neutral")
				more.Name = "More"
			end
			more.Text = "+" .. extra
			more.Position = UDim2.new(0, width + Theme.SPACE.xs, 0, math.floor((size - 20) / 2))
			width += MORE_WIDTH
		elseif more then
			more:Destroy()
		end
		local labels = {}
		for index, member in ipairs(sorted) do
			if index &gt; 3 then break end
			table.insert(labels, if member.me == true then "tu" else Theme.fit(tostring(member.name or "?"), 16))
		end
		local text = table.concat(labels, ", ")
		-- Contorul apare o singură dată pe fiecare ecran (§7.4): în plugin secțiunea Workspace nu are chip de contor, deci
		-- numărul stă aici; în panou îl poartă chip-ul secțiunii „Prezenți”, iar rândul de nume rămâne doar cu numele.
		if #sorted &gt; 0 then
			local counted = Theme.countLabel(#sorted, "prezent", "prezenți")
			text = if text ~= "" then text .. " · " .. counted else counted
		end
		names.Text = text
		local offset = width + (if width &gt; 0 then Theme.SPACE.sm else 0)
		names.Position = UDim2.new(0, offset, 0, 0)
		names.Size = UDim2.new(1, -offset, 0, size)
	end
	row.set(members)
	return row
end

-- Buton: patru feluri, o singură formă (§7.5). Activarea se leagă din view cu `Theme.click`.
function Theme.button(parent, text, options)
	local config = options or {}
	local kind = config.kind or "secondary"
	local size = config.size or "md"
	local height = BUTTON_HEIGHT[size] or BUTTON_HEIGHT.md
	local width = config.width
	-- Trunchierea și padding-ul lateral vin din regula pură de mai sus, ca să fie verificabile fără Studio.
	local fixed = if typeof(width) == "UDim" and width.Scale == 0 then width.Offset else nil
	local truncate, pad = Theme.buttonText(width == "auto", fixed)
	local button = Theme.new("TextButton", { Name = config.name or "Button",
		Size = if typeof(width) == "UDim" then UDim2.new(width.Scale, width.Offset, 0, height) else UDim2.new(1, 0, 0, height),
		AutomaticSize = if width == "auto" then Enum.AutomaticSize.X else Enum.AutomaticSize.None,
		BorderSizePixel = 0, Text = if type(text) == "string" then text else "",
		TextSize = Theme.TEXT[BUTTON_TEXT[size] or "md"], RichText = false, TextWrapped = false,
		TextTruncate = if truncate then Enum.TextTruncate.AtEnd else Enum.TextTruncate.None,
		AutoButtonColor = false, Selectable = true, TextXAlignment = Enum.TextXAlignment.Center }, parent)
	if width == "auto" then button.Size = UDim2.new(0, 0, 0, height) end
	button.Font = Theme.font("ui")
	button:SetAttribute("Component", "button")
	button:SetAttribute("Kind", kind)
	Theme.corner(button, "control")
	Theme.new("UIPadding", { PaddingLeft = UDim.new(0, pad), PaddingRight = UDim.new(0, pad) }, button)
	if kind == "primary" then
		Theme.paint(button, { BackgroundColor3 = "primary", TextColor3 = "onPrimary" })
		local stroke = Theme.stroke(button, "primaryMark")
		Theme.hover(button, { normal = "primary", hover = "primaryHover", pressed = "primaryActive", stroke = stroke, strokeNormal = "primaryMark" })
	elseif kind == "ghost" then
		button.BackgroundTransparency = 1
		Theme.paint(button, { BackgroundColor3 = "raised", TextColor3 = "text2" })
		Theme.hover(button, { normal = "raised", fadeNormal = 1, fadeHover = 0, textNormal = "text2", textHover = "text" })
	elseif kind == "danger" then
		Theme.paint(button, { BackgroundColor3 = "dangerSoft", TextColor3 = "dangerText" })
		local stroke = Theme.stroke(button, "dangerMark")
		stroke.Transparency = 0.6
		strokeBase[stroke] = 0.6
		Theme.hover(button, { normal = "dangerSoft", hover = "dangerMark", fadeNormal = 0, fadeHover = 0.8, stroke = stroke, strokeNormal = "dangerMark" })
	else
		Theme.paint(button, { BackgroundColor3 = "raised", TextColor3 = "text" })
		local stroke = Theme.stroke(button, "border")
		-- Hover-ul secundar folosește `bg` în dark (mai închis) și `border` în light (mai închis): schimbarea se vede în ambele teme.
		Theme.hover(button, { normal = "raised", hover = { dark = "bg", light = "border" }, stroke = stroke,
			strokeNormal = "border", strokeHover = "borderStrong" })
	end
	Theme.enabled(button, true)
	return button
end

-- Control cu două-trei valori (segmented) sau file de ecran (tab): aceeași formă, altă decorație.
local function choiceGroup(parent, items, value, onChange, mode)
	local count = math.max(1, #items)
	local height = if mode == "tab" then 34 else 32
	local root = Theme.new("Frame", { Name = if mode == "tab" then "Tabs" else "Segmented",
		Size = UDim2.new(1, 0, 0, height), BorderSizePixel = 0 }, parent)
	if mode == "tab" then
		root.BackgroundTransparency = 1
	else
		Theme.paint(root, { BackgroundColor3 = "raised" })
		Theme.corner(root, "control")
		Theme.stroke(root, "border")
		Theme.padding(root, 2, 2)
	end
	Theme.list(root, 0, true)
	local group = { root = root, buttons = {}, value = value }
	local underlines = {}
	local function repaintItems()
		for key, button in pairs(group.buttons) do
			local selected = key == group.value
			if mode == "tab" then
				Theme.paint(button, { TextColor3 = if selected then "text" else "text2" })
				local underline = underlines[key]
				if underline then underline.Visible = selected end
			else
				button.BackgroundTransparency = if selected then 0 else 1
				Theme.paint(button, { BackgroundColor3 = "surface", TextColor3 = if selected then "text" else "text2" })
				local stroke = button:FindFirstChildWhichIsA("UIStroke")
				if stroke then stroke.Transparency = if selected then 0 else 1 end
			end
		end
	end
	for index, item in ipairs(items) do
		local button = Theme.new("TextButton", { Name = "Item_" .. tostring(item.key), LayoutOrder = index,
			Size = UDim2.new(1 / count, 0, 1, 0), BorderSizePixel = 0, BackgroundTransparency = 1,
			Text = if type(item.text) == "string" then item.text else tostring(item.key),
			TextSize = Theme.TEXT.md, RichText = false, TextWrapped = false, AutoButtonColor = false, Selectable = true }, root)
		button.Font = Theme.font("ui")
		if mode == "tab" then
			local underline = Theme.new("Frame", { Name = "Underline", BorderSizePixel = 0, Visible = false,
				AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 2) }, button)
			underline:SetAttribute("Component", "underline")
			Theme.recolor(underline, "primary")
			underlines[item.key] = underline
		else
			Theme.corner(button, "control")
			local stroke = Theme.stroke(button, "borderStrong")
			stroke.Transparency = 1
			strokeBase[stroke] = 0
		end
		button.Activated:Connect(function()
			if button:GetAttribute("EnabledAction") == false then return end
			if group.value == item.key then return end
			group.value = item.key
			repaintItems()
			if onChange then onChange(item.key) end
		end)
		group.buttons[item.key] = button
	end
	function group.set(newValue)
		group.value = newValue
		repaintItems()
	end
	repaintItems()
	return group
end

function Theme.segmented(parent, items, value, onChange)
	return choiceGroup(parent, items, value, onChange, "segmented")
end

function Theme.tab(parent, items, value, onChange)
	return choiceGroup(parent, items, value, onChange, "tab")
end

-- Rând de listă fără chenar: text principal stânga, meta dreapta, acțiune opțională la capăt (§7.7).
function Theme.row(parent, options)
	local config = options or {}
	local lines = config.lines or 1
	local leadKind = config.lead
	local leadWidth = if leadKind == "avatar" then 24 + Theme.SPACE.sm elseif leadKind == "dot" then 8 + Theme.SPACE.xs else 0
	local actionWidth = if config.action then 96 else 0
	local metaWidth = if lines &gt;= 2 then 0 else 96
	local height = if lines &gt;= 2 then 44 else 32
	local root = Theme.new("Frame", { Name = config.name or "Row", BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, height) }, parent)
	Theme.paint(root, { BackgroundColor3 = "raised" })
	root.BackgroundTransparency = 1
	Theme.corner(root, "control")
	local content = Theme.new("Frame", { Name = "Content", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0) }, root)
	Theme.new("UIPadding", { PaddingLeft = UDim.new(0, Theme.SPACE.md), PaddingRight = UDim.new(0, Theme.SPACE.md),
		PaddingTop = UDim.new(0, Theme.SPACE.xs + 2), PaddingBottom = UDim.new(0, Theme.SPACE.xs + 2) }, content)
	local row = { root = root }
	if leadKind == "avatar" then
		row.lead = Theme.avatar(content, config.identity, { size = 24 })
		row.lead.Position = UDim2.new(0, 0, 0.5, -12)
	elseif leadKind == "dot" then
		row.lead = Theme.dot(content, config.role or "neutral", 8)
		row.lead.Position = UDim2.new(0, 0, 0.5, -4)
	end
	local primaryWidth = -(leadWidth + metaWidth + actionWidth)
	row.primary = Theme.label(content, config.primary or "", { size = "sm", token = "text", truncate = true,
		font = if config.mono then "mono" else "body", height = if lines &gt;= 2 then 18 else nil, name = "Primary" })
	-- Rândul are dimensiuni date (nu AutomaticSize): textul care nu încape se trunchiază la capăt.
	row.primary.AutomaticSize = Enum.AutomaticSize.None
	row.primary.Position = UDim2.new(0, leadWidth, 0, 0)
	row.primary.Size = UDim2.new(1, primaryWidth, if lines &gt;= 2 then 0 else 1, if lines &gt;= 2 then 18 else 0)
	row.primary.TextYAlignment = Enum.TextYAlignment.Center
	row.secondary = Theme.label(content, config.secondary or "", { size = "xs", token = "text2", truncate = true,
		align = if lines &gt;= 2 then "left" else "right", name = "Secondary" })
	row.secondary.AutomaticSize = Enum.AutomaticSize.None
	if lines &gt;= 2 then
		row.secondary.Position = UDim2.new(0, leadWidth, 0, 20)
		row.secondary.Size = UDim2.new(1, primaryWidth, 0, 16)
	else
		row.secondary.Position = UDim2.new(1, -(metaWidth + actionWidth), 0, 0)
		row.secondary.Size = UDim2.new(0, metaWidth, 1, 0)
	end
	row.secondary.TextYAlignment = Enum.TextYAlignment.Center
	if config.action then
		-- Butonul primește padding mic (vezi `Theme.button`: sub 64 px lățime), ca eticheta să încapă la 320 px lățime de dock.
		row.action = Theme.button(content, config.action.text or "", { kind = config.action.kind or "ghost", size = "sm",
			name = "Action", width = UDim.new(0, actionWidth - Theme.SPACE.sm) })
		row.action.AnchorPoint = Vector2.new(1, 0.5)
		row.action.Position = UDim2.new(1, 0, 0.5, 0)
	end
	-- Rândul acționabil primește un buton transparent peste tot rândul; hover-ul aprinde fundalul `raised`.
	if config.clickable then
		local button = Theme.new("TextButton", { Name = "Hit", BackgroundTransparency = 1, Text = "", RichText = false, Size = UDim2.new(1, 0, 1, 0),
			AutoButtonColor = false, Selectable = true, ZIndex = 0 }, root)
		row.button = button
		button.MouseEnter:Connect(function()
			if button:GetAttribute("EnabledAction") ~= false then Theme.tween(root, { BackgroundTransparency = 0 }) end
		end)
		button.MouseLeave:Connect(function() Theme.tween(root, { BackgroundTransparency = 1 }) end)
	end
	function row.set(primary, secondary)
		if type(primary) == "string" and row.primary.Text ~= primary then row.primary.Text = primary end
		if type(secondary) == "string" and row.secondary.Text ~= secondary then row.secondary.Text = secondary end
	end
	return row
end

-- Starea goală a unei secțiuni: ce va apărea aici și ce poate face utilizatorul acum (§7.8, texte în §12).
function Theme.empty(parent, text, options)
	local config = options or {}
	local root = Theme.new("Frame", { Name = config.name or "Empty", BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, parent)
	Theme.padding(root, 0, Theme.SPACE.xs)
	Theme.list(root, Theme.SPACE.xs)
	local empty = { root = root }
	empty.label = Theme.label(root, text or "", { size = "sm", token = "text2", name = "Text" })
	empty.label.LayoutOrder = 1
	if config.hint then
		-- `text2`, nu `text3`: tokenul al treilea rămâne decorativ (sub 4,5:1 pe toate suprafețele, §2.5).
		empty.hint = Theme.label(root, config.hint, { size = "xs", token = "text2", name = "Hint" })
		empty.hint.LayoutOrder = 2
	end
	if config.action then
		empty.action = Theme.button(root, config.action.text or "", { kind = "ghost", size = "sm", width = "auto", name = "Action" })
		empty.action.LayoutOrder = 3
	end
	return empty
end

-- Banner de ecran cu șină de rol (§7.9); `show(role, text, seconds)` repictează și, opțional, se ascunde singur.
function Theme.banner(parent, options)
	local config = options or {}
	local root = Theme.new("Frame", { Name = config.name or "Banner", Size = UDim2.new(1, 0, 0, 0), BorderSizePixel = 0,
		AutomaticSize = Enum.AutomaticSize.Y, ClipsDescendants = true, Visible = false }, parent)
	root:SetAttribute("Component", "banner")
	Theme.corner(root, "card")
	local rail = Theme.new("Frame", { Name = "Rail", Size = UDim2.new(0, 3, 1, 0), BorderSizePixel = 0, ZIndex = 2 }, root)
	rail:SetAttribute("Component", "rail")
	local body = Theme.new("Frame", { Name = "Body", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, root)
	-- Cu buton de închidere, corpul se retrage din dreapta cu lățimea lui plus spațiile: altfel prima linie trece pe sub „×”.
	local rightPad = Theme.bannerPad(config.close)
	Theme.new("UIPadding", { PaddingLeft = UDim.new(0, Theme.SPACE.md + 3), PaddingRight = UDim.new(0, rightPad),
		PaddingTop = UDim.new(0, Theme.SPACE.md), PaddingBottom = UDim.new(0, Theme.SPACE.md) }, body)
	Theme.list(body, Theme.SPACE.sm)
	local label = Theme.label(body, "", { size = "sm", name = "Text" })
	label:SetAttribute("Component", "roleText")
	local banner = { root = root, rail = rail, label = label, visible = false }
	if config.action then
		banner.action = Theme.button(body, config.action.text or "", { kind = "ghost", size = "sm", width = "auto", name = "Action" })
		banner.action.LayoutOrder = 2
	end
	if config.close then
		banner.close = Theme.button(root, "×", { kind = "ghost", size = "sm", name = "Close", width = UDim.new(0, CLOSE_WIDTH) })
		banner.close.AnchorPoint = Vector2.new(1, 0)
		banner.close.Position = UDim2.new(1, -Theme.SPACE.xs, 0, Theme.SPACE.xs)
		banner.close.ZIndex = 3
	end
	local generation = 0
	local role = config.role or "neutral"
	local function setRole(newRole)
		role = newRole or "neutral"
		Theme.recolor(root, role)
		Theme.recolor(rail, role)
		Theme.recolor(label, role)
	end
	setRole(role)
	function banner.show(newRole, text, seconds)
		generation += 1
		local mine = generation
		setRole(newRole)
		label.Text = if type(text) == "string" then text else ""
		root.Visible = true
		banner.visible = true
		if type(seconds) == "number" and seconds &gt; 0 then
			task.delay(seconds, function()
				if generation == mine then banner.hide() end
			end)
		end
	end
	function banner.hide()
		generation += 1
		root.Visible = false
		banner.visible = false
	end
	return banner
end

-- Secțiune: titlu 16/600, contor opțional, subtitlu opțional, corp cu pas 8; varianta pliabilă are „▾”/„▸” (§7.10).
function Theme.section(parent, title, options)
	local config = options or {}
	local collapsible = config.collapsible == true
	local root = Theme.new("Frame", { Name = config.name or "Section", BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, parent)
	Theme.list(root, Theme.SPACE.sm)
	local header
	if collapsible then
		header = Theme.new("TextButton", { Name = "Header", BackgroundTransparency = 1, Text = "", RichText = false, Size = UDim2.new(1, 0, 0, 24),
			AutoButtonColor = false, Selectable = true, LayoutOrder = 1 }, root)
	else
		header = Theme.new("Frame", { Name = "Header", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 1 }, root)
	end
	local titleLabel = Theme.label(header, title or "", { size = "lg", font = "ui", height = 24, truncate = true, name = "Title" })
	titleLabel.Size = UDim2.new(1, -40, 1, 0)
	local count = Theme.chip(header, "", "neutral")
	count.Name = "Count"
	count.AnchorPoint = Vector2.new(1, 0.5)
	count.Position = UDim2.new(1, 0, 0.5, 0)
	count.Visible = false
	local body = Theme.new("Frame", { Name = "Body", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3 }, root)
	Theme.list(body, Theme.SPACE.sm)
	if collapsible then
		Theme.paint(body, { BackgroundColor3 = "surface" })
		body.BackgroundTransparency = 0
		Theme.corner(body, "card")
		Theme.stroke(body, "borderStrong")
		Theme.padding(body, Theme.SPACE.md)
	end
	local section = { root = root, header = header, title = titleLabel, count = count, body = body, open = config.open == true }
	local subtitleLabel = nil
	function section.setCount(n)
		if type(n) == "number" then
			count.Text = tostring(math.floor(n))
			count.Visible = true
		else
			count.Visible = false
		end
	end
	function section.subtitle(text)
		if type(text) == "string" and text ~= "" then
			if not subtitleLabel then
				subtitleLabel = Theme.label(root, text, { size = "xs", token = "text2", height = 16, name = "Subtitle" })
				subtitleLabel.LayoutOrder = 2
				section.subtitleLabel = subtitleLabel
			end
			subtitleLabel.Text = text
			subtitleLabel.Visible = true
		elseif subtitleLabel then
			subtitleLabel.Visible = false
		end
	end
	function section.setOpen(open)
		section.open = open == true
		body.Visible = section.open
		if collapsible then titleLabel.Text = (if section.open then "▾ " else "▸ ") .. (title or "") end
	end
	section.setOpen(if collapsible then config.open == true else true)
	-- Antetul pliabil se comportă ca un buton ghost: titlul se aprinde la hover, fără fundal.
	if collapsible then
		Theme.paint(titleLabel, { TextColor3 = "text2" })
		Theme.enabled(header, true)
		header.MouseEnter:Connect(function() Theme.paint(titleLabel, { TextColor3 = "text" }) end)
		header.MouseLeave:Connect(function() Theme.paint(titleLabel, { TextColor3 = "text2" }) end)
	end
	return section
end

-- Bulă din fluxul unei sesiuni (§7.13); `set` schimbă textul fără să recreeze instanța (scroll-ul nu sare).
function Theme.bubble(parent, message, provider)
	local data = if type(message) == "table" then message else {}
	local kind = if type(data.kind) == "string" and data.kind ~= "" then data.kind else "text"
	local role = Theme.messageRole(kind, provider)
	local user = kind == "text"
	local root = Theme.new("Frame", { Name = "Bubble", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, parent)
	local box = Theme.new("Frame", { Name = "Box", BackgroundTransparency = 1, BorderSizePixel = 0,
		Size = if user then UDim2.new(0.85, 0, 0, 0) else UDim2.new(1, 0, 0, 0),
		AnchorPoint = if user then Vector2.new(1, 0) else Vector2.new(0, 0),
		Position = if user then UDim2.fromScale(1, 0) else UDim2.fromScale(0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, root)
	local rail = nil
	local leftPadding = 0
	if user then
		Theme.paint(box, { BackgroundColor3 = "raised" })
		box.BackgroundTransparency = 0
		Theme.corner(box, "card")
		Theme.padding(box, Theme.SPACE.sm, Theme.SPACE.sm)
	elseif kind ~= "assistant" then
		rail = Theme.new("Frame", { Name = "Rail", Size = UDim2.new(0, 3, 1, 0), BorderSizePixel = 0, ZIndex = 2 }, box)
		rail:SetAttribute("Component", "rail")
		leftPadding = Theme.SPACE.sm + 3
		Theme.new("UIPadding", { PaddingLeft = UDim.new(0, leftPadding) }, box)
	end
	local content = Theme.new("Frame", { Name = "Content", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, box)
	Theme.list(content, 2)
	local author = Theme.label(content, "", { size = "xs", font = "ui", name = "Author" })
	author:SetAttribute("Component", "roleText")
	author.LayoutOrder = 1
	local bodySize = if kind == "text" or kind == "assistant" then "md" else "sm"
	local bodyToken = if kind == "error" then "dangerText" elseif kind == "text" or kind == "assistant" then "text" else "text2"
	local body = Theme.label(content, "", { size = bodySize, token = bodyToken, name = "Body" })
	body.LayoutOrder = 2
	local bubble = { root = root, box = box, rail = rail, author = author, body = body }
	function bubble.set(newMessage)
		local fields = if type(newMessage) == "table" then newMessage else {}
		local newKind = if type(fields.kind) == "string" and fields.kind ~= "" then fields.kind else kind
		local newRole = Theme.messageRole(newKind, provider)
		if newRole ~= role then
			role = newRole
			if rail then Theme.recolor(rail, role) end
			Theme.recolor(author, role)
		end
		local authorText = if type(fields.author) == "string" then fields.author else ""
		if author.Text ~= authorText then author.Text = authorText end
		author.Visible = authorText ~= ""
		local text = if type(fields.text) == "string" then fields.text else ""
		if body.Text ~= text then body.Text = text end
	end
	if rail then Theme.recolor(rail, role) end
	Theme.recolor(author, role)
	bubble.set(data)
	return bubble
end

return Theme
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>